<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8" />
<title>Liste de points — {{af.client_name}} — {{af.project_name}}</title>
<style>{{{styles}}}</style>
</head>
<body>

{{!-- ═══════════════════ COVER — duplique de synthesis.hbs (meme classes, meme structure) ═══════════════════ --}}
<section class="cover">
  <div class="cover-top">
    <img class="cover-logo" src="{{logoDataUrl}}" alt="Buildy" />
    <p class="cover-doc-type">Liste de points contractuelle</p>
    <h1 class="cover-title">{{af.project_name}}</h1>
    <p class="cover-client">{{af.client_name}}</p>
    {{#if af.site_address}}<p class="cover-address">{{af.site_address}}</p>{{/if}}
  </div>

  {{!-- KPI cards en grand sur la couverture (2 cards : instances + points) --}}
  <div class="cover-kpi-grid">
    <div class="cover-kpi-card">
      <p class="cover-kpi-value">{{totals.instances}}</p>
      <p class="cover-kpi-label">Instance{{#if (gt totals.instances 1)}}s{{/if}} d'équipement</p>
    </div>
    <div class="cover-kpi-card">
      <p class="cover-kpi-value">{{totals.points}}</p>
      <p class="cover-kpi-label">Point{{#if (gt totals.points 1)}}s{{/if}} de donnée attendu{{#if (gt totals.points 1)}}s{{/if}}</p>
    </div>
  </div>

  {{!-- Bandeau niveau requis vs visé (mutualisé avec AF + Synthèse) --}}
  {{> _cover-level-band}}

  {{!-- Meta projet (3 colonnes comme synthesis) --}}
  <div class="cover-meta">
    <div class="cover-meta-row">
      <span class="cover-meta-label">Version</span>
      <span class="cover-meta-value"><span class="cover-version-tag">{{version}}</span></span>
      {{#if motif}}<span class="cover-motif">{{motif}}</span>{{/if}}
    </div>
    <div class="cover-meta-row">
      <span class="cover-meta-label">Date d'export</span>
      <span class="cover-meta-value">{{exportDate}}</span>
    </div>
    <div class="cover-meta-row">
      <span class="cover-meta-label">Auteur</span>
      <span class="cover-meta-value">{{authorName}}</span>
    </div>
  </div>

  <p class="cover-legal">
    © Buildy SAS — Document confidentiel. Toute reproduction, transmission ou diffusion à des tiers, même partielle,
    est interdite sans autorisation écrite préalable.
  </p>
</section>

{{!-- ═══════════ Légende des colonnes ═══════════ --}}
<section class="legend-section">
  <h2 class="legend-title">Légende des colonnes</h2>
  <div class="legend-grid">
    <div class="legend-block">
      <p class="legend-block-title">Type</p>
      <ul class="legend-items">
        <li><span class="badge-type type-Mesure">Mesure</span> Valeur physique mesurée (température, débit, puissance…)</li>
        <li><span class="badge-type type-État">État</span> État logique de l'équipement (marche/arrêt, mode actif…)</li>
        <li><span class="badge-type type-Alarme">Alarme</span> Booléen de défaut ou anomalie détectée</li>
        <li><span class="badge-type type-Commande">Commande</span> Action ponctuelle envoyée à l'équipement</li>
        <li><span class="badge-type type-Consigne">Consigne</span> Paramètre réglable transmis à l'équipement</li>
      </ul>
    </div>
    <div class="legend-block">
      <p class="legend-block-title">Sens</p>
      <ul class="legend-items">
        <li><span class="badge-dir dir-R">R</span> Lecture — Buildy lit la donnée exposée par l'équipement</li>
        <li><span class="badge-dir dir-W">W</span> Écriture — Buildy écrit la valeur sur l'équipement</li>
      </ul>
    </div>
    <div class="legend-block">
      <p class="legend-block-title">Nature</p>
      <ul class="legend-items">
        <li><span class="badge-nature" data-nature="Booléen">Booléen</span> Vrai / Faux</li>
        <li><span class="badge-nature" data-nature="Numérique">Numérique</span> Valeur chiffrée avec unité</li>
        <li><span class="badge-nature" data-nature="Enum">Enum</span> Valeur dans une liste fermée</li>
        <li><span class="badge-nature" data-nature="Chaîne de caractères">Chaîne de caractères</span> Texte libre (code erreur, libellé…)</li>
      </ul>
    </div>
    <div class="legend-block">
      <p class="legend-block-title">Optionnel</p>
      <ul class="legend-items">
        <li><span class="checkbox checked">✓</span> Point optionnel — peut ne pas être exposé selon le modèle, le firmware ou la configuration de l'équipement terrain.</li>
        <li><span class="checkbox"></span> Point attendu par défaut sur cette catégorie d'équipement.</li>
      </ul>
    </div>
  </div>
</section>

{{!-- ═══════════ Tableau global de tous les points ═══════════ --}}
<section class="points-section">
  <table class="points">
    <thead>
      <tr>
        <th class="col-cat">Catégorie</th>
        <th class="col-ref">Repère</th>
        <th class="col-loc">Localisation</th>
        <th class="col-tech">Nom technique</th>
        <th class="col-label">Donnée</th>
        <th class="col-type">Type</th>
        <th class="col-dir">Sens</th>
        <th class="col-nature">Nature</th>
        <th class="col-unit">Unité</th>
        <th class="col-optional">Optionnel</th>
      </tr>
    </thead>
    <tbody>
      {{#each rows}}
      <tr class="{{#if isFirstOfInstance}}row-first{{/if}}">
        <td class="col-cat">{{#if isFirstOfInstance}}{{categoryName}}{{/if}}</td>
        <td class="col-ref">{{#if isFirstOfInstance}}<strong>{{instanceRef}}</strong>{{#if (gt instanceQty 1)}} <span class="qty-badge">×{{instanceQty}}</span>{{/if}}{{/if}}</td>
        <td class="col-loc">{{#if isFirstOfInstance}}{{instanceLocation}}{{/if}}</td>
        <td class="col-tech">{{#if tech_name}}<code>{{tech_name}}</code>{{else}}—{{/if}}</td>
        <td class="col-label">{{label}}</td>
        <td class="col-type"><span class="badge-type type-{{data_type}}">{{data_type}}</span></td>
        <td class="col-dir"><span class="badge-dir dir-{{dirLabel}}">{{dirLabel}}</span></td>
        <td class="col-nature">{{#if nature}}<span class="badge-nature" data-nature="{{nature}}">{{nature}}</span>{{else}}—{{/if}}</td>
        <td class="col-unit">{{#if unit}}{{unit}}{{else}}—{{/if}}</td>
        <td class="col-optional"><span class="checkbox{{#if is_optional}} checked{{/if}}">{{#if is_optional}}✓{{/if}}</span></td>
      </tr>
      {{/each}}
    </tbody>
  </table>
</section>

{{!-- ═══════════ Récapitulatif final ═══════════ --}}
<section class="summary">
  <h2>Récapitulatif par catégorie</h2>
  <table class="summary-table">
    <thead>
      <tr>
        <th>Catégorie d'équipement</th>
        <th class="summary-num">Instances</th>
        <th class="summary-num">Points par instance</th>
        <th class="summary-num">Total points</th>
      </tr>
    </thead>
    <tbody>
      {{#each categories}}
      <tr>
        <td>{{name}}</td>
        <td class="summary-num">{{instancesCount}}</td>
        <td class="summary-num">{{pointsPerInstance}}</td>
        <td class="summary-num">{{pointsTotal}}</td>
      </tr>
      {{/each}}
    </tbody>
    <tfoot>
      <tr>
        <td>Total général</td>
        <td class="summary-num">{{totals.instances}}</td>
        <td class="summary-num">—</td>
        <td class="summary-num">{{totals.points}}</td>
      </tr>
    </tfoot>
  </table>
</section>

</body>
</html>
