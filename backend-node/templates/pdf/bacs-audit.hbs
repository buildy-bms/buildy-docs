  {{/if}}
  {{#if bmsTopicOpportunities.analyse_fonctionnelle}}
  <div class="info-card info-card-wide bms-opportunity-card">
    <span class="info-card-label">Opportunités d'amélioration</span>
    <div class="info-card-value rich-notes">{{{bmsTopicOpportunities.analyse_fonctionnelle}}}</div>
  </div>
  {{/if}}
</div>

{{!-- Composants matériels de la GTB — bloc visible uniquement si l'auditeur
     a saisi au moins un composant (serveur, contrôleur, passerelle…). --}}
{{#if bmsComponents.length}}
<div class="panel">
  <div class="panel-head">
    <h3 class="panel-title">Composants matériels de la GTB</h3>
    <p class="panel-subtitle">Serveurs, contrôleurs, passerelles, automates relevés sur site.</p>
  </div>
  <div class="panel-body">
    <table class="bms-components-table">
      <thead>
        <tr>
          <th>Type</th><th>Marque · Modèle</th><th>Localisation</th>
          <th>Adresse IP</th><th>Protocoles</th><th>Firmware</th>
        </tr>
      </thead>
      <tbody>
        {{#each bmsComponents}}
        <tr>
          <td>{{#if component_type}}{{component_type}}{{else}}<span class="bool-na">—</span>{{/if}}</td>
          <td>{{#if brand}}<strong>{{brand}}</strong>{{/if}}{{#if model}}{{#if brand}} · {{/if}}{{model}}{{/if}}{{#unless (or brand model)}}<span class="bool-na">—</span>{{/unless}}</td>
          <td>{{#if location}}{{location}}{{else}}<span class="bool-na">—</span>{{/if}}</td>
          <td>{{#if ip_address}}<code>{{ip_address}}</code>{{else}}<span class="bool-na">—</span>{{/if}}</td>
          <td>{{#if protocolsLabel}}<span class="muted">{{protocolsLabel}}</span>{{else}}<span class="bool-na">—</span>{{/if}}</td>
          <td>{{#if firmware_version}}{{firmware_version}}{{else}}<span class="bool-na">—</span>{{/if}}</td>
        </tr>
        {{#if notes_html}}<tr class="bms-component-notes-row"><td colspan="6"><div class="rich-notes">{{{notes_html}}}</div></td></tr>{{/if}}
        {{#unless notes_html}}{{#if notes}}<tr class="bms-component-notes-row"><td colspan="6">{{notes}}</td></tr>{{/if}}{{/unless}}
        {{/each}}
      </tbody>
    </table>
  </div>
</div>
{{/if}}

{{#if isBacs}}
{{!-- Card 3 — R175-3 Capacités de supervision --}}
<div class="panel">
  <div class="panel-head">
    <h3 class="panel-title">R175-3 — Capacités de supervision</h3>
    <p class="panel-subtitle">L'interopérabilité (3°), l'arrêt manuel et la gestion autonome (4°) sont appréciés système par système, à partir des équipements relevés (chapitre 3).</p>
  </div>
  <div class="panel-body">
    <div class="kv-list">
      <div class="kv-row">
        <div class="kv-label-block">
          <span class="kv-label">1°. Suivi des consommations au pas horaire, conservation 5 ans</span>
          <span class="kv-explainer">La GTB doit collecter et analyser <em>en continu</em>, à un pas de temps horaire et par zone fonctionnelle, les consommations et productions énergétiques de chaque système technique du bâtiment, ajuster automatiquement ces systèmes en conséquence, et conserver les données à l'échelle mensuelle pendant cinq ans (R175-3 1°).</span>
          {{#if bms.meets_r175_3_p1}}{{#unless (eq bms.data_storage_5y_compliant "yes")}}
          <span class="kv-explainer kv-caveat">Conservation sur 5 ans : {{#if (eq bms.data_storage_5y_compliant "no")}}non conforme{{else}}à qualifier{{/if}} (voir « Conservation et accès aux données »).</span>
          {{/unless}}{{/if}}
        </div>
        <span class="kv-value {{triCls bms.meets_r175_3_p1 'kv-yes' 'kv-no' 'kv-na'}}">
          <span class="kv-ico">{{triSym bms.meets_r175_3_p1}}</span>{{boolLabel bms.meets_r175_3_p1}}
        </span>
      </div>
      <div class="kv-row">
        <div class="kv-label-block">
          <span class="kv-label">2°. Détection des pertes d'efficacité</span>
          <span class="kv-explainer">La GTB doit situer l'efficacité énergétique du bâtiment par rapport à des valeurs de référence (étude énergétique, caractéristiques nominales de chaque système technique), détecter automatiquement les pertes d'efficacité et informer l'exploitant des possibilités d'amélioration (R175-3 2°).</span>
        </div>
        <span class="kv-value {{triCls bms.meets_r175_3_p2 'kv-yes' 'kv-no' 'kv-na'}}">
          <span class="kv-ico">{{triSym bms.meets_r175_3_p2}}</span>{{boolLabel bms.meets_r175_3_p2}}
        </span>
      </div>
    </div>
    {{!-- Sous-bloc P1 : format d'archivage + vérification rétention 5 ans
         (visibles si P1 est marqué Oui). --}}
