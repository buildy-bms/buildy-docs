{{!-- Tableau des offres Buildy (matrice E/S/P) — partial mutualise.
     Inclus a l'identique dans offering-catalog.hbs et brochure.hbs.
     Attendu dans le contexte parent :
       levels      [{ slug, name, color_hex, tagline, is_highlighted, highlight_label }]
       rows        [{ kind: 'category'|'feature', depth, title,
                      avail_e, avail_s, avail_p, all_option }]
       colspan     levels.length + 1
--}}
<table class="comparison-table">
  <colgroup>
    <col class="col-feature" />
    {{#each levels}}<col class="col-level" />{{/each}}
  </colgroup>
  <thead>
    <tr>
      <th class="th-feature">Fonctionnalité</th>
      {{#each levels}}
      <th class="th-level th-{{slug}} {{#if is_highlighted}}th-highlighted{{/if}}"
          {{#if color_hex}}style="background:{{color_hex}};"{{/if}}>
        {{#if is_highlighted}}
          {{#if highlight_label}}
            <div class="th-level-badge">{{highlight_label}}</div>
          {{else}}
            <div class="th-level-badge-ph"></div>
          {{/if}}
        {{else}}
          <div class="th-level-badge-ph"></div>
        {{/if}}
        <div class="th-level-name">{{name}}</div>
        {{#if tagline}}<div class="th-level-tagline">{{tagline}}</div>{{/if}}
      </th>
      {{/each}}
    </tr>
  </thead>
  <tbody>
    {{#each rows}}
    {{#if (eq kind "category")}}
    <tr class="category-row category-row-d{{depth}}">
      <td colspan="{{../colspan}}">
        <span class="cat-marker cat-marker-d{{depth}}">{{#if (eq depth 0)}}▸{{else}}·{{/if}}</span>
        {{title}}
      </td>
    </tr>
    {{else}}
    <tr>
      <td class="td-feature td-feature-d{{depth}}">
        {{!-- Lien interne #toc-feature-{id} : ancre injectee par populateToc
             quand la brochure rend le detail de cette feature. Sur le PDF
             catalog (sans detail), le lien retombe a la racine du PDF
             (silent fallback) — non bloquant. --}}
        <a href="#toc-feature-{{id}}" class="td-feature-link">
          {{#if icon_name}}<span class="td-feature-icon">{{{faIcon icon_name "#475569" "12"}}}</span>{{/if}}
          {{title}}
        </a>
        {{#if all_option}}<span class="opt-badge">+ Option payante</span>{{/if}}
      </td>
      {{#each ../levels}}
      {{#if (eq slug "E")}}
        <td class="td-level td-level-{{slug}} {{#if is_highlighted}}td-level-highlighted{{/if}}">
          {{#if (eq ../avail_e "included")}}<span class="avail avail-included">✓</span>{{/if}}
          {{#if (eq ../avail_e "paid_option")}}<span class="avail-text">€&nbsp;Option</span>{{/if}}
          {{#if (eq ../avail_e "unavailable")}}<span class="avail avail-unavailable">—</span>{{/if}}
        </td>
      {{/if}}
      {{#if (eq slug "S")}}
        <td class="td-level td-level-{{slug}} {{#if is_highlighted}}td-level-highlighted{{/if}}">
          {{#if (eq ../avail_s "included")}}<span class="avail avail-included">✓</span>{{/if}}
          {{#if (eq ../avail_s "paid_option")}}<span class="avail-text">€&nbsp;Option</span>{{/if}}
          {{#if (eq ../avail_s "unavailable")}}<span class="avail avail-unavailable">—</span>{{/if}}
        </td>
      {{/if}}
      {{#if (eq slug "P")}}
        <td class="td-level td-level-{{slug}} {{#if is_highlighted}}td-level-highlighted{{/if}}">
          {{#if (eq ../avail_p "included")}}<span class="avail avail-included">✓</span>{{/if}}
          {{#if (eq ../avail_p "paid_option")}}<span class="avail-text">€&nbsp;Option</span>{{/if}}
          {{#if (eq ../avail_p "unavailable")}}<span class="avail avail-unavailable">—</span>{{/if}}
        </td>
      {{/if}}
      {{/each}}
    </tr>
    {{/if}}
    {{/each}}
  </tbody>
</table>
