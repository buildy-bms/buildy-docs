{{#if actionItems.minor.length}}
<h2>{{#if isBacs}}Optimisations{{else}}Optimisations complémentaires{{/if}}</h2>
<div class="callout callout-info">
  <span class="callout-icon">📌</span>
  <div class="callout-body">{{#if isBacs}}Bonnes pratiques, hors strict décret.{{else}}Bonnes pratiques optionnelles, à proposer en option dans le devis.{{/if}}</div>
</div>
{{#each actionItems.minor}}
<div class="action-card action-card-minor">
  <div class="action-card-head">
    <span class="action-num">{{display_number}}</span>
    <span class="sev sev-minor">{{#if ../isBacs}}Mineure{{else}}Optimisation{{/if}}</span>
    {{#if r175_article}}<span class="muted action-card-article">{{r175_article}}</span>{{/if}}
    {{#if zone_name}}<span class="action-card-zone">📍 {{zone_name}}</span>{{/if}}
  </div>
  <div class="action-card-title"><strong>{{title}}</strong></div>
  {{#if description}}<div class="action-card-desc">{{description}}</div>{{/if}}
</div>
{{/each}}
{{/if}}

{{#unless actionItems.blocking.length}}
{{#unless actionItems.major.length}}
{{#unless actionItems.minor.length}}
<p>{{#if isBacs}}Aucune action corrective à ce stade.{{else}}Aucune préconisation à ce stade — la GTB couvre l'intégralité du périmètre.{{/if}}</p>
{{/unless}}
{{/unless}}
{{/unless}}

<div class="callout callout-reco" style="margin-top: 8mm;">
  <span class="callout-icon">✅</span>
  <div class="callout-body"><strong>{{#if isBacs}}Pour la mise en conformité{{else}}Pour le devis détaillé{{/if}}</strong>, l'équipe commerciale Buildy se tient à votre disposition pour établir un devis chiffré.</div>
</div>
</div>{{!-- /.sections --}}

{{#if isBacs}}
{{!-- ═══════════ Annexe A — Texte du décret ═══════════ --}}
<section class="annex">
  <h1>Annexe A — Décret BACS (R175-1 à R175-6)</h1>
  <div class="callout callout-r175">
    <span class="callout-icon">📖</span>
    <div class="callout-body">Texte intégral des articles du décret R175 — Bâtiments tertiaires, automatisation et contrôle. Ce qui suit est la base réglementaire utilisée pour évaluer la conformité au chapitre 7.</div>
  </div>
  {{#each bacsArticles}}
  <article class="article-card">
    <header class="article-card-head">
      <span class="article-code">{{code}}</span>
      <h3 class="article-title">{{title}}</h3>
    </header>
    <div class="article-body">{{{html}}}</div>
  </article>
  {{/each}}
</section>

{{!-- ═══════════ Annexe B — Méthodologie ═══════════ --}}
<section class="annex">
  <h1>Annexe B — Méthodologie et hypothèses retenues par Buildy</h1>
  <div class="callout callout-info">
    <span class="callout-icon">📌</span>
    <div class="callout-body">Cette annexe trace les choix méthodologiques de Buildy. Toute évaluation de conformité du présent rapport repose sur ces hypothèses, librement opposables.</div>
  </div>
  {{#each methodology}}
  <article class="method-card">
    <h3 class="method-title">{{title}}</h3>
    <p class="method-body">{{body}}</p>
  </article>
  {{/each}}
</section>

{{!-- ═══════════ Annexe C — Justification des préconisations ═══════════ --}}
<section class="annex">
  <h1>Annexe C — Justification des préconisations</h1>
  <div class="callout callout-info">
    <span class="callout-icon">📌</span>
    <div class="callout-body">Chaque action corrective listée au chapitre 7 a été générée à partir des données saisies pendant l'audit, en référence à un article précis du décret BACS. Cette annexe trace pour chaque item le raisonnement appliqué.</div>
  </div>
  {{#each justifications}}
  <div class="justif-card">
    <h3>{{title}}</h3>
    <table class="meta-table">
      <tr><th>Article visé</th><td><strong>{{article}}</strong></td></tr>
      <tr><th>Donnée audit</th><td>{{source}}</td></tr>
      <tr><th>Recommandation</th><td>{{description}}</td></tr>
    </table>
  </div>
  {{/each}}
  {{#unless justifications.length}}
  <div class="callout callout-reco">
    <span class="callout-icon">✅</span>
    <div class="callout-body">Aucune action corrective générée — pas de justification à reporter.</div>
  </div>
  {{/unless}}
</section>

{{!-- ═══════════ Annexe D — Disclaimers ═══════════ --}}
<section class="annex">
  <h1>Annexe D — Mentions légales et disclaimers</h1>
  <div class="callout callout-warn">
    <span class="callout-icon">⚠️</span>
    <div class="callout-body">Lecture obligatoire avant utilisation du présent rapport en support de devis ou de procédure de mise en conformité.</div>
  </div>
  <ol class="disclaimer-list">
    {{#each disclaimers}}
    <li>{{this}}</li>
    {{/each}}
  </ol>
</section>
{{/if}}

</body>
</html>
