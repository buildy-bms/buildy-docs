<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<title>{{title}}</title>
<style>{{{styles}}}</style>
</head>
<body>

{{!-- ═══════════ Couverture pleine page (style #41) ═══════════ --}}
<section class="cover">
  <div class="cover-eyebrow">
    {{#if logoWhiteDataUrl}}
    <img src="{{logoWhiteDataUrl}}" alt="Buildy" class="cover-logo" />
    {{/if}}
    {{#unless hideCoverEyebrow}}
    {{coverEyebrowLabel}}
    <span class="meta">{{#if audienceLabel}}{{audienceLabel}} · {{/if}}{{#if version}}Version {{version}} · {{/if}}{{dateLabel}}</span>
    {{/unless}}
  </div>

  <div class="cover-center">
    <h1 class="cover-title">{{title}}</h1>
    {{#if subtitle}}<p class="cover-sub">{{subtitle}}</p>{{/if}}
    {{#if coverImageUrl}}
    <figure class="cover-image-frame">
      <img class="cover-image" src="{{coverImageUrl}}" alt="" />
      {{#if coverImageCaption}}<figcaption class="cover-image-caption">{{coverImageCaption}}</figcaption>{{/if}}
    </figure>
    {{/if}}
  </div>

  <div class="cover-foot">
    <div class="edition">{{#if audienceLabel}}À l'attention des {{audienceLabel}}{{else}}Livre blanc Buildy{{/if}}</div>
  </div>
</section>

{{!-- ═══════════ Chapitres (style flux naturel) ═══════════ --}}
{{#each chapters}}
{{#if is_back_cover}}
{{!-- BACK COVER (style #41) — centrée, navy plein-bord, logo en haut --}}
<section class="back">
  {{#if ../logoWhiteDataUrl}}
  <div class="wordmark-top">
    <img src="{{../logoWhiteDataUrl}}" alt="Buildy" />
  </div>
  {{/if}}

  <div class="back-center">
    <h3>{{title}}</h3>
    <div class="back-body">{{{body_html}}}</div>

    <div class="signature">
      <div class="rule"></div>
      <div class="name">Buildy</div>
      <div class="role">Éditeur, intégrateur et mainteneur de solutions de supervision multi-sites pour le bâtiment tertiaire</div>
    </div>
  </div>

  <div class="back-foot">
    Document édité par Buildy. {{#if version}}Version {{version}} — {{/if}}{{dateLabel}}. La reproduction partielle ou totale est libre à condition de mentionner la source.
  </div>
</section>
{{else}}
<section class="chapter">
  <h1 class="chapter-title">{{title}}</h1>
  <div class="chapter-body">
    {{{body_html}}}
  </div>
</section>
{{/if}}
{{/each}}

</body>
</html>
