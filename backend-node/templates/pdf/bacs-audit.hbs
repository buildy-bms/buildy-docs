          {{#each photos}}<img src="{{dataUrl}}" alt="" />{{/each}}
        </div>
      {{/if}}
    </div>
  </div>
{{/each}}
{{/if}}
{{else}}
<p class="muted">Aucun compteur n'a été relevé ni prévu pour ce site.</p>
