<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <title>Offres Buildy {{year}}</title>
  <style>{{{styles}}}</style>
</head>
<body>

{{!-- ═══════════ Page de garde ═══════════ --}}
<section class="cover">
  <img class="cover-logo" src="{{logoDataUrl}}" alt="Buildy" />
  <p class="cover-doc-type">Catalogue commercial</p>
  <h1 class="cover-title">Offres Buildy<br/>{{year}}</h1>
  <div class="cover-promise">{{{coverPromise}}}</div>
  <p class="cover-subtitle">{{{coverSubtitle}}}</p>
  <p class="cover-meta">Édition du {{exportDate}}</p>
</section>

{{!-- ═══════════ Page Tableau des offres (partial partage avec brochure) ═══════════
     Le wrapper, le header (eyebrow + titre + count) et la legende sont mutualises
     via _offerings-page.hbs pour garantir un rendu strictement identique entre
     ce catalogue d'offres et la page « Tableau des offres » de la brochure. --}}
{{> _offerings-page}}

{{!-- ═══════════ CTA ═══════════ --}}
<section class="cta-section">
  <div class="cta-block">
    <p class="cta-line">{{{ctaTitle}}}</p>
    <p class="cta-sub">{{{ctaSub}}}</p>
    <p class="cta-contact">{{{ctaContact}}}</p>
  </div>
  <p class="comparison-footer">
    Buildy · catalogue édité le {{exportDate}}
  </p>
</section>

</body>
</html>
