<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8" />
<title>{{#if isBacs}}Audit BACS{{else}}Audit GTB{{/if}} — {{document.client_name}} — {{document.project_name}}</title>
<style>{{{styles}}}</style>
</head>
<body>

{{!-- ═══════════ Page de garde — affirmation, verdict en accroche ═══════════ --}}
<section class="cover">
  <header class="cover-top">
    <img class="cover-logo" src="{{logoDataUrl}}" alt="Buildy" />
    <span class="cover-eyebrow">{{#if isBacs}}Audit de conformité BACS · Décret R175{{else}}Audit GTB · Préparation devis Buildy{{/if}}</span>
  </header>

  <main class="cover-main">
    <h1 class="cover-title">{{document.project_name}}</h1>
    <p class="cover-client">{{document.client_name}}</p>
    {{#if site.address}}<p class="cover-address">{{site.address}}</p>{{/if}}
  </main>

  {{#if compliance.verdict}}
  <div class="cover-verdict cover-verdict-{{compliance.verdict}}">
    <span class="cover-verdict-eyebrow">{{#if isBacs}}État de conformité{{else}}Couverture GTB existante{{/if}}</span>
    <span class="cover-verdict-icon">{{compliance.verdictIcon}}</span>
    <span class="cover-verdict-value">{{compliance.verdictLabel}}</span>
    {{#if isBacs}}
      {{#if applicabilityLabel}}
      <span class="cover-verdict-applicability">Applicabilité R175-2 · {{applicabilityLabel}}</span>
      {{/if}}
    {{else}}
      {{#if compliance.coverage}}
      <span class="cover-verdict-applicability">{{compliance.coverage.integrated}} équipements intégrés sur {{compliance.coverage.present}} ({{compliance.coverage.ratio}}%) — préconisations Buildy pour le devis d'extension</span>
      {{/if}}
    {{/if}}
  </div>
  {{/if}}

  <footer class="cover-footer">
    <div class="cover-footer-cell">
      <span class="cover-footer-label">Date d'audit</span>
      <span class="cover-footer-value">{{exportDate}}</span>
    </div>
    <div class="cover-footer-cell">
      <span class="cover-footer-label">Auditeur</span>
      <span class="cover-footer-value">{{authorName}}</span>
    </div>
    <div class="cover-footer-cell">
      <span class="cover-footer-label">Version</span>
      <span class="cover-footer-value cover-footer-version">{{version}}</span>
    </div>
  </footer>
</section>

{{!-- ═══════════ Table des matieres — page 2 (juste après la cover) ═══════════ --}}
{{!-- Cover + L'essentiel + Tableau de bord conformite sont des pages de
     synthese hors sommaire (frontmatter) — le sommaire ne liste que les
     chapitres numerotés. La TOC vient AVANT L'essentiel pour faciliter la
     navigation rapide dans un livrable de 30+ pages. --}}
<section class="toc">
  <h1>Sommaire</h1>
  <ul class="toc-list">
    {{#if synthesisHtml}}
    <li class="toc-row lvl-1" data-toc-link="synthesis">
      <a href="#synthesis" class="toc-link">
        <span class="toc-num">00</span>
        <span class="toc-title">Note de synthèse</span>
        <span class="toc-dots"></span>
        <span class="toc-page">···</span>
      </a>
    </li>
    {{/if}}
    <li class="toc-row lvl-1" data-toc-link="identification">
      <a href="#identification" class="toc-link">
        <span class="toc-num">1</span>
        <span class="toc-title">Identification du site</span>
        <span class="toc-dots"></span>
        <span class="toc-page">···</span>
      </a>
    </li>
    <li class="toc-row lvl-1" data-toc-link="zones">
      <a href="#zones" class="toc-link">
        <span class="toc-num">2</span>
        <span class="toc-title">Zones fonctionnelles{{#if isBacs}} <span class="toc-ref">R175-1 6°</span>{{/if}}</span>
        <span class="toc-dots"></span>
        <span class="toc-page">···</span>
      </a>
    </li>
    <li class="toc-row lvl-1" data-toc-link="systems">
      <a href="#systems" class="toc-link">
        <span class="toc-num">3</span>
        <span class="toc-title">Systèmes techniques par zone{{#if isBacs}} <span class="toc-ref">R175-1 4°</span>{{/if}}</span>
        <span class="toc-dots"></span>
        <span class="toc-page">···</span>
      </a>
    </li>
    <li class="toc-row lvl-1" data-toc-link="meters">
      <a href="#meters" class="toc-link">
        <span class="toc-num">4</span>
        <span class="toc-title">Compteurs et mesurage{{#if isBacs}} <span class="toc-ref">R175-3 1°</span>{{/if}}</span>
        <span class="toc-dots"></span>
        <span class="toc-page">···</span>
      </a>
    </li>
    {{#if isBacs}}
    <li class="toc-row lvl-1" data-toc-link="thermal">
      <a href="#thermal" class="toc-link">
        <span class="toc-num">5</span>
        <span class="toc-title">Régulation thermique automatique <span class="toc-ref">R175-6</span></span>
        <span class="toc-dots"></span>
        <span class="toc-page">···</span>
      </a>
    </li>
    {{/if}}
    <li class="toc-row lvl-1" data-toc-link="bms">
      <a href="#bms" class="toc-link">
        <span class="toc-num">{{#if isBacs}}6{{else}}5{{/if}}</span>
        <span class="toc-title">{{#if isBacs}}Solution GTB / GTC <span class="toc-ref">R175-3, R175-4, R175-5</span>{{else}}Solution de supervision en place{{/if}}</span>
        <span class="toc-dots"></span>
        <span class="toc-page">···</span>
      </a>
    </li>
    {{#if isBacs}}
    <li class="toc-row lvl-1" data-toc-link="plan">
      <a href="#plan" class="toc-link">
        <span class="toc-num">7</span>
        <span class="toc-title">Plan de mise en conformité</span>
        <span class="toc-dots"></span>
        <span class="toc-page">···</span>
      </a>
    </li>
    {{/if}}
  </ul>
</section>

{{!-- ═══════════ Page L'essentiel — synthèse en 1 page (page 3) ═══════════ --}}
<section class="essential">
  <header class="essential-header">
    <span class="essential-eyebrow">L'essentiel</span>
    <h1 class="essential-title">Synthèse de l'audit en une page</h1>
  </header>

  <div class="essential-verdict-banner essential-verdict-{{compliance.verdict}}">
    <span class="essential-verdict-icon">{{compliance.verdictIcon}}</span>
    <div class="essential-verdict-body">
      <span class="essential-verdict-label">{{compliance.verdictLabel}}{{#if isBacs}} au décret BACS{{else}} de la GTB existante{{/if}}</span>
      <span class="essential-verdict-detail">
        {{#if isBacs}}
          {{#if (eq compliance.verdict "non_compliant")}}{{compliance.stats.blocking}} action{{#unless (eq compliance.stats.blocking 1)}}s{{/unless}} bloquante{{#unless (eq compliance.stats.blocking 1)}}s{{/unless}} empêchent la conformité au décret. Plan de mise en conformité estimé à 6-12 mois selon les arbitrages.{{else}}{{#if (eq compliance.verdict "partial")}}{{compliance.stats.major}} action{{#unless (eq compliance.stats.major 1)}}s{{/unless}} majeure{{#unless (eq compliance.stats.major 1)}}s{{/unless}} restante{{#unless (eq compliance.stats.major 1)}}s{{/unless}} pour atteindre la conformité complète.{{else}}Aucune action bloquante ni majeure identifiée — site conforme au décret BACS.{{/if}}{{/if}}
        {{else}}
          {{compliance.coverage.integrated}} équipement{{#unless (eq compliance.coverage.integrated 1)}}s{{/unless}} intégré{{#unless (eq compliance.coverage.integrated 1)}}s{{/unless}} sur {{compliance.coverage.present}} présent{{#unless (eq compliance.coverage.present 1)}}s{{/unless}} ({{compliance.coverage.ratio}} %). {{compliance.stats.total}} préconisations Buildy pour étendre la couverture de la GTB.
        {{/if}}
      </span>
    </div>
  </div>

  {{#if isBacs}}{{#unless compliance.assujettissement.determined}}
  <div class="essential-caveat">
    <span class="essential-caveat-icon">i</span>
    <span>Assujettissement au décret non statué — puissance ou date de permis non renseignées. Le verdict porte sur les non-conformités constatées et sera confirmé une fois l'assujettissement déterminé.</span>
  </div>
  {{/unless}}{{/if}}

  <div class="essential-grid">
    {{#if isBacs}}
    <div class="essential-applicability">
      <h3 class="essential-block-title">Calcul d'assujettissement R175-2</h3>
      <ol class="applicability-steps">
        <li>
          <span class="step-num">1</span>
          <span class="step-body">
            Puissance retenue (max chaud / froid) : <strong>{{compliance.assujettissement.powerKw}} kW</strong>
            {{#if powerSummary}}
            <span class="power-breakdown">
              chaud cumulé {{powerSummary.heatKw}} kW · froid cumulé {{powerSummary.coolKw}} kW
              {{#if (eq powerSummary.source "auto")}} · calcul automatique{{else}} · valeur saisie manuellement{{/if}}
            </span>
            {{#if powerSummary.discrepancy}}
            <span class="power-discrepancy">⚠ Écart de {{powerSummary.discrepancyPct}} % entre la valeur saisie ({{powerSummary.manualKw}} kW) et le cumul calculé ({{powerSummary.autoKw}} kW) — à vérifier.</span>
            {{/if}}
            {{/if}}
          </span>
        </li>
        {{#if compliance.assujettissement.pcDateLabel}}
        <li>
          <span class="step-num">2</span>
          <span class="step-body">Date du permis de construire : <strong>{{compliance.assujettissement.pcDateLabel}}</strong></span>
        </li>
        {{/if}}
        <li>
          <span class="step-num">{{#if compliance.assujettissement.pcDateLabel}}3{{else}}2{{/if}}</span>
          <span class="step-body">Seuil applicable : <strong>{{compliance.assujettissement.thresholdLabel}}</strong> → {{compliance.assujettissement.conclusion}}</span>
        </li>
      </ol>
    </div>
    {{else}}
    <div class="essential-applicability">
      <h3 class="essential-block-title">Couverture GTB existante</h3>
      <ol class="applicability-steps">
        <li>
          <span class="step-num">1</span>
          <span class="step-body">GTB déployée : <strong>{{bms.existing_solution}}</strong>{{#if bms.existing_solution_brand}} ({{bms.existing_solution_brand}}){{/if}}</span>
        </li>
        <li>
          <span class="step-num">2</span>
          <span class="step-body">Équipements supervisés : <strong>{{compliance.coverage.integrated}} sur {{compliance.coverage.present}}</strong> ({{compliance.coverage.ratio}} %)</span>
        </li>
        <li>
          <span class="step-num">3</span>
          <span class="step-body">Verdict Buildy : <strong>{{compliance.verdictLabel}}</strong> — extension recommandée pour couvrir l'ensemble du périmètre fonctionnel.</span>
        </li>
      </ol>
    </div>
    {{/if}}

    <div class="essential-stats">
      <h3 class="essential-block-title">{{#if isBacs}}Plan d'action en chiffres{{else}}Préconisations Buildy{{/if}}</h3>
      <div class="stats-grid">
        <div class="stat stat-blocking">
          <div class="stat-num">{{compliance.stats.blocking}}</div>
          <div class="stat-label">{{#if isBacs}}Bloquante{{#unless (eq compliance.stats.blocking 1)}}s{{/unless}}{{else}}Essentielle{{#unless (eq compliance.stats.blocking 1)}}s{{/unless}}{{/if}}</div>
        </div>
        <div class="stat stat-major">
          <div class="stat-num">{{compliance.stats.major}}</div>
          <div class="stat-label">{{#if isBacs}}Majeure{{#unless (eq compliance.stats.major 1)}}s{{/unless}}{{else}}Recommandée{{#unless (eq compliance.stats.major 1)}}s{{/unless}}{{/if}}</div>
        </div>
        <div class="stat stat-minor">
          <div class="stat-num">{{compliance.stats.minor}}</div>
          <div class="stat-label">{{#if isBacs}}Mineure{{#unless (eq compliance.stats.minor 1)}}s{{/unless}}{{else}}Optimisation{{#unless (eq compliance.stats.minor 1)}}s{{/unless}}{{/if}}</div>
        </div>
      </div>
    </div>
  </div>

  {{#if compliance.headlineActions.length}}
  <div class="essential-headlines">
    <h3 class="essential-block-title">{{#if isBacs}}Actions phares à engager en priorité{{else}}Préconisations phares pour le devis{{/if}}</h3>
    <ol class="headlines-list">
      {{#each compliance.headlineActions}}
      <li class="headline">
        <span class="headline-num">{{display_number}}</span>
        <div class="headline-body">
          <div class="headline-title">{{title}}</div>
          <div class="headline-meta">
            <span class="sev sev-{{severity}}">{{#if (eq severity "blocking")}}{{#if ../isBacs}}Bloquante{{else}}Essentielle{{/if}}{{else}}{{#if (eq severity "major")}}{{#if ../isBacs}}Majeure{{else}}Recommandée{{/if}}{{else}}{{#if ../isBacs}}Mineure{{else}}Optimisation{{/if}}{{/if}}{{/if}}</span>
            {{#if r175_article}}<span class="r175-tag">{{r175_article}}</span>{{/if}}
            {{#if zone_name}}<span class="zone-tag">{{zone_name}}</span>{{/if}}
          </div>
        </div>
      </li>
      {{/each}}
    </ol>
    <p class="essential-footnote">Détail complet {{#if isBacs}}du plan de mise en conformité{{else}}des préconisations Buildy{{/if}} au chapitre 7.</p>
  </div>
  {{/if}}

  {{!-- Item 4a — Structure juridique du site (assujettissement) --}}
  {{#if ownershipStructureLabel}}
  <div class="callout callout-info essential-ownership">
    <span class="callout-icon">⚖️</span>
    <div class="callout-body">
      <strong>Structure juridique : {{ownershipStructureLabel}}.</strong>
      L'assujetti au décret BACS est déterminé système par système selon cette structure (cf. chapitre 3).
      {{#if ownershipNotes}} {{ownershipNotes}}{{/if}}
    </div>
  </div>
  {{/if}}

  {{!-- Item 12 — Pont avec le décret tertiaire (bâtiment > 1000 m²) --}}
  {{#if tertiaryDecreeApplies}}
  <div class="callout callout-info essential-tertiary">
    <span class="callout-icon">🔗</span>
    <div class="callout-body">
      <strong>Ce site relève également du décret tertiaire</strong> (surface supérieure à 1 000 m²). Les comptages et le suivi énergétique mis en place dans le cadre du décret BACS peuvent alimenter directement vos déclarations sur la plateforme OPERAT.
    </div>
  </div>
  {{/if}}

  {{!-- Item 13 — Bandeau « Consommations de référence » (factures client) --}}
  {{#if energyReference}}
  <div class="energy-reference">
    <h3 class="essential-block-title">Consommations de référence — année {{energyReference.referenceYear}}</h3>
    <div class="energy-ref-cards">
      {{#each energyReference.energies}}
      <div class="energy-ref-card">
        <div class="energy-ref-card-label">{{label}}</div>
        <div class="energy-ref-card-value">{{totalQuantityFmt}} <span class="energy-ref-card-unit">{{unit}}</span></div>
        <div class="energy-ref-card-meta">
          {{#if ratioPerM2Fmt}}{{ratioPerM2Fmt}} {{unit}}/m²{{/if}}
          {{#if totalCostFmt}}{{#if ratioPerM2Fmt}} · {{/if}}{{totalCostFmt}} € sur l'année{{/if}}
        </div>
      </div>
      {{/each}}
    </div>
    {{#if energyMonthlyChartDataUrl}}
    <div class="energy-ref-chart">
      <img src="{{energyMonthlyChartDataUrl}}" alt="Répartition mensuelle des consommations" />
    </div>
    {{/if}}
    <p class="energy-ref-footnote">
      Base de référence saisie depuis les factures fournies par le client / les preneurs.
      Cette base de référence permettra de mesurer les économies réelles après mise en place du BACS.
    </p>
  </div>
  {{/if}}
</section>

{{!-- ═══════════ Tableau de bord conformité R175 (après sommaire) ═══════════ --}}
{{#if isBacs}}
<section class="r175-dashboard">
  <header class="dashboard-header">
    <span class="dashboard-eyebrow">Tableau de bord</span>
    <h1 class="dashboard-title">Conformité par exigence du décret R175</h1>
    <p class="dashboard-intro">
      Lecture rapide de l'état du site, exigence par exigence du décret BACS.
      Chaque ligne renvoie au chapitre où l'évaluation est détaillée et justifiée.
    </p>
  </header>

  <ul class="r175-rows">
    {{#each compliance.r175Dashboard}}
    <li class="r175-row r175-row-{{verdict}}">
      <span class="r175-row-code">{{code}}</span>
      <div class="r175-row-content">
        <div class="r175-row-label">{{label}}</div>
        <div class="r175-row-summary">{{summary}}</div>
      </div>
      <span class="r175-row-verdict r175-row-verdict-{{verdict}}">
        <span class="r175-row-verdict-icon">{{verdictIcon}}</span>
        {{verdictLabel}}
      </span>
      <span class="r175-row-actions{{#unless actionsCount}} r175-row-actions-empty{{/unless}}">
        {{#if actionsCount}}{{actionsCount}} action{{#unless (eq actionsCount 1)}}s{{/unless}}{{else}}—{{/if}}
      </span>
    </li>
    {{/each}}
  </ul>

  <p class="dashboard-footnote">
    Détail des actions correctives et préconisations Buildy : chapitre 7 « Plan de mise en conformité ».
  </p>
</section>
{{/if}}

<div class="sections">

{{#if synthesisHtml}}
{{!-- ═══════════ Synthèse executive ═══════════ --}}
<h1 class="chapter" data-toc-anchor="synthesis">{{{faIcon "sparkles" "#1b2842" "16"}}} Note de synthèse</h1>
<div class="synthesis-block">{{{synthesisHtml}}}</div>
{{/if}}

{{!-- L'ancienne section « Synthèse de conformité » à l'intérieur de
     .sections est remplacée par la page « L'essentiel » + le tableau de
     bord conformité R175 placés AVANT .sections (cf. en-tête du document). --}}

{{!-- ═══════════ Chapitre 1 — Identification site ═══════════ --}}
<h1 class="chapter" data-toc-anchor="identification">{{{faIcon "building" "#1b2842" "16"}}} 1. Identification du site</h1>

<div class="info-cards">
  <div class="info-card">
    <span class="info-card-label">Site</span>
    <span class="info-card-value">{{site.name}}</span>
  </div>
  <div class="info-card">
    <span class="info-card-label">Client</span>
    <span class="info-card-value">{{document.client_name}}</span>
  </div>
  {{#if site.address}}
  <div class="info-card info-card-wide">
    <span class="info-card-label">Adresse</span>
    <span class="info-card-value">{{site.address}}</span>
  </div>
  {{/if}}
  {{#if site.coords_label}}
  <div class="info-card">
    <span class="info-card-label">Coordonnées GPS</span>
    <span class="info-card-value">{{site.coords_label}}</span>
  </div>
  {{/if}}
  {{#if isBacs}}
    {{#if document.bacs_total_power_kw}}
    <div class="info-card info-card-accent">
      <span class="info-card-label">Puissance chauffage + clim</span>
      <span class="info-card-value info-card-value-strong">{{document.bacs_total_power_kw}} kW</span>
    </div>
    {{/if}}
    {{#if document.bacs_district_heating_substation_kw}}
    <div class="info-card info-card-accent">
      <span class="info-card-label">Station d'échange (réseau urbain)</span>
      <span class="info-card-value info-card-value-strong">{{document.bacs_district_heating_substation_kw}} kW</span>
      <span class="info-card-note">Référence R175-2</span>
    </div>
    {{/if}}
    {{#if document.bacs_building_permit_date}}
    <div class="info-card">
      <span class="info-card-label">Permis de construire</span>
      <span class="info-card-value">{{document.bacs_building_permit_date}}</span>
    </div>
    {{/if}}
    {{#if applicabilityLabel}}
    <div class="info-card info-card-wide info-card-accent">
      <span class="info-card-label">Applicabilité BACS (R175-2)</span>
      <span class="info-card-value info-card-value-strong">{{applicabilityLabel}}</span>
    </div>
    {{/if}}
  {{/if}}
</div>

{{!-- Item 4/5 — Structure juridique & parties prenantes du site --}}
{{#if siteParties.length}}
<div class="panel">
  <div class="panel-head">
    <h3 class="panel-title">Structure juridique &amp; parties prenantes</h3>
    {{#if ownershipStructureLabel}}
    <p class="panel-subtitle">Structure de propriété / occupation : <strong>{{ownershipStructureLabel}}</strong>. L'assujetti au décret BACS est déterminé système par système (cf. chapitre 3).</p>
    {{/if}}
  </div>
  <div class="panel-body">
    <table>
      <thead>
        <tr><th>Partie prenante</th><th>Rôle</th><th>Zones rattachées</th></tr>
      </thead>
      <tbody>
        {{#each siteParties}}
        <tr>
          <td><strong>{{name}}</strong></td>
          <td>{{kindLabel}}</td>
          <td>{{#if zoneNames.length}}{{#each zoneNames}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}{{else}}<span class="muted">—</span>{{/if}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</div>
{{/if}}

{{#if siteMapDataUrl}}
<div class="map-figure" style="text-align:center;margin:3mm 0 5mm">
  <img src="{{siteMapDataUrl}}" alt="Vue satellite du site"
       style="max-width:150mm;border:1px solid #e2e8f0;border-radius:6px" />
</div>
{{/if}}

{{#if isBacs}}{{#if heatingCoolingBreakdown.length}}
<div class="panel">
  <div class="panel-head">
    <h3 class="panel-title">Détail du calcul automatique de la puissance R175-2</h3>
    <p class="panel-subtitle">
      Cumul des puissances nominales utiles chaud et froid déclarées dans le chapitre 3.
      Certains équipements (réseau urbain aval, secours, biomasse) sont saisis mais
      <strong>hors cumul R175-2</strong> — leur ligne « Pris en compte » est marquée.
      La puissance retenue est le <strong>maximum</strong> entre le cumul chaud et le cumul froid.
    </p>
  </div>
  <div class="panel-body">
    <table>
      <thead>
        <tr>
          <th>Équipement</th>
          <th>Marque / référence</th>
          <th>Catégorie</th>
          <th>Zone</th>
          <th style="text-align:right">Puissance nominale</th>
          <th style="text-align:right">Pris en compte</th>
        </tr>
      </thead>
      <tbody>
        {{#each heatingCoolingBreakdown}}
          <tr>
            <td>{{name}}</td>
            <td>{{brand}}{{#if model_reference}} / {{model_reference}}{{/if}}</td>
            <td>{{categoryLabel}}</td>
            <td>{{zone_name}}</td>
            <td style="text-align:right">{{#if has_multiple}}{{total_power_kw}}{{else}}{{power_kw}}{{/if}} kW{{#if has_multiple}} <span class="muted">({{quantity}}&times;{{power_kw}})</span>{{/if}}</td>
            <td style="text-align:right">
              {{#if in_scope}}
                {{#if heat_contrib}}<strong>+{{heat_contrib}} kW</strong> chaud{{/if}}
                {{#if cool_contrib}}{{#if heat_contrib}}<br>{{/if}}<strong>+{{cool_contrib}} kW</strong> froid{{/if}}
                {{#unless heat_contrib}}{{#unless cool_contrib}}<span class="muted">0 kW</span>{{/unless}}{{/unless}}
              {{else}}
                <span class="muted">Hors cumul</span>
              {{/if}}
            </td>
          </tr>
        {{/each}}
        <tr class="total-row">
          <td colspan="5" style="text-align:right"><strong>Cumul chaud retenu</strong></td>
          <td style="text-align:right"><strong>{{powerRecap.heatRetained}} kW</strong></td>
        </tr>
        <tr class="total-row">
          <td colspan="5" style="text-align:right"><strong>Cumul froid retenu</strong></td>
          <td style="text-align:right"><strong>{{powerRecap.coolRetained}} kW</strong></td>
        </tr>
        <tr class="total-row" style="background:#eef2ff">
          <td colspan="5" style="text-align:right"><strong>Puissance retenue R175-2 (max chaud / froid)</strong></td>
          <td style="text-align:right"><strong style="color:#1b2842">{{powerRecap.retained}} kW</strong></td>
        </tr>
      </tbody>
    </table>
  </div>
</div>
{{/if}}{{/if}}

{{#if barUsagePowerDataUrl}}
<div class="panel">
  <div class="panel-head">
    <h3 class="panel-title">Répartition de la puissance par usage</h3>
  </div>
  <div class="panel-body panel-body-center">
    <img src="{{barUsagePowerDataUrl}}" alt="Puissance par usage GTB" style="max-width: 140mm;" />
  </div>
</div>
{{/if}}

{{!-- ═══════════ Chapitre 2 — Zones fonctionnelles ═══════════ --}}
<h1 class="chapter" data-toc-anchor="zones">{{{faIcon "map-pin" "#1b2842" "16"}}} 2. Zones fonctionnelles{{#if isBacs}} (R175-1 6°){{/if}}</h1>
{{#if zones.length}}
{{!-- ── Bloc 1 — Inventaire des zones fonctionnelles BACS ──
     Espaces de vie/usage homogènes au sens R175-1 6°. --}}
{{#if zonesFunctional.length}}
<h2 class="subheading">Inventaire des zones fonctionnelles</h2>
<table>
  <thead><tr><th>Zone</th><th>Nature</th><th>Régime d'activité</th><th>Surface (m²)</th></tr></thead>
  <tbody>
    {{#each zonesFunctional}}
      <tr><td>{{name}}</td><td>{{natureLabel}}</td><td>{{#if occupancyLabel}}{{occupancyLabel}}{{else}}<span class="muted">—</span>{{/if}}</td><td>{{#if surface_m2}}{{surface_m2}}{{else}}<span class="muted">—</span>{{/if}}</td></tr>
    {{/each}}
  </tbody>
</table>
{{!-- Notes terrain par zone (uniquement si au moins une zone a une note
     ou photo). Regroupées sous un sous-titre dédié pour que les blocs
     individuels n'apparaissent pas hors contexte. --}}
{{#if zonesFunctionalHaveNotes}}
<h3 class="subheading-3">Notes terrain par zone</h3>
{{#each zonesFunctional}}
  {{#if (or notes_html notes photos.length comfort_constraint)}}
    <div class="entity-block">
      <h4>{{name}}</h4>
      {{#if comfort_constraint}}
        <p class="muted" style="margin-bottom:1.5mm"><strong>Contrainte de confort :</strong> {{comfort_constraint}}</p>
      {{/if}}
      {{#if notes_html}}<div class="rich-notes">{{{notes_html}}}</div>
      {{else}}{{#if notes}}<p>{{notes}}</p>{{/if}}{{/if}}
      {{#if photos.length}}
        <div class="photo-grid">
          {{#each photos}}<img src="{{dataUrl}}" alt="" />{{/each}}
        </div>
      {{/if}}
    </div>
  {{/if}}
{{/each}}
{{/if}}
{{/if}}

{{!-- ── Bloc 2 — Locaux techniques (hors périmètre R175-1 6°) ──
     Tableaux électriques, locaux compteurs : inventoriés pour rattacher
     les organes de mesure / coupure à un emplacement physique. --}}
{{#if zonesTechnical.length}}
<h2 class="subheading">Locaux techniques</h2>
<div class="callout callout-info">
  <span class="callout-icon">📌</span>
  <div class="callout-body">Les locaux techniques (tableaux électriques, locaux compteurs, locaux techniques) ne sont <strong>pas des zones fonctionnelles au sens du décret BACS</strong>. Ils sont listés ici à titre d'inventaire pour rattacher les compteurs et organes de coupure à un emplacement physique.</div>
</div>
<table>
  <thead><tr><th>Local</th><th>Nature</th><th>Surface (m²)</th></tr></thead>
  <tbody>
    {{#each zonesTechnical}}
      <tr><td>{{name}}</td><td>{{natureLabel}}</td><td>{{#if surface_m2}}{{surface_m2}}{{else}}<span class="muted">—</span>{{/if}}</td></tr>
    {{/each}}
  </tbody>
</table>
{{#if zonesTechnicalHaveNotes}}
<h3 class="subheading-3">Notes terrain par local technique</h3>
{{#each zonesTechnical}}
  {{#if (or notes_html notes photos.length)}}
    <div class="entity-block">
      <h4>{{name}}</h4>
      {{#if notes_html}}<div class="rich-notes">{{{notes_html}}}</div>
      {{else}}{{#if notes}}<p>{{notes}}</p>{{/if}}{{/if}}
      {{#if photos.length}}
        <div class="photo-grid">
          {{#each photos}}<img src="{{dataUrl}}" alt="" />{{/each}}
        </div>
      {{/if}}
    </div>
  {{/if}}
{{/each}}
{{/if}}
{{/if}}

{{!-- ── Bloc 3 — Regroupement R175 par usage technique ──
     Items 7d/7e : zones d'usage regroupées en "zones fonctionnelles de
     suivi" lorsqu'un équipement partagé empêche le comptage séparé. --}}
{{#if functionalZones.mergedCount}}
<h2 class="subheading">Regroupement par usage technique</h2>
<div class="callout callout-info">
  <span class="callout-icon">📌</span>
  <div class="callout-body">Au sens du décret (R175-1 6°), une zone fonctionnelle est une <strong>unité de suivi énergétique</strong>. Lorsqu'un équipement partagé dessert plusieurs zones sans comptage séparable, ces zones sont regroupées en une seule zone fonctionnelle de suivi. Le découpage peut donc différer selon le système technique concerné.</div>
</div>
{{#each functionalZones.byCategory}}
  {{#if (gt functional_zone_count 0)}}
  <div class="entity-block">
    <h3 class="fz-heading">{{{categoryIcon category "14"}}} <span>{{categoryLabel}} — {{physical_zone_count}} zone{{#unless (eq physical_zone_count 1)}}s{{/unless}} d'usage → {{functional_zone_count}} zone{{#unless (eq functional_zone_count 1)}}s{{/unless}} fonctionnelle{{#unless (eq functional_zone_count 1)}}s{{/unless}} de suivi</span></h3>
    <ul class="method-list">
      {{#each groups}}
        <li>
          <strong>{{label}}</strong>
          {{#if merged}} — {{justification}}{{/if}}
        </li>
      {{/each}}
    </ul>
  </div>
  {{/if}}
{{/each}}
{{/if}}
{{else}}
<p class="muted">Aucune zone définie.</p>
{{/if}}

{{!-- ═══════════ Chapitre 3 — Systèmes techniques ═══════════ --}}
<h1 class="chapter" data-toc-anchor="systems">{{{faIcon "wrench" "#1b2842" "16"}}} 3. Systèmes techniques par zone{{#if isBacs}} (R175-1 4°){{/if}}</h1>
{{!-- Zones fonctionnelles sans système thermique présent : hors
     périmètre R175-2 (pas de chauffage / climatisation / ECS). Listées
     ici pour clarifier pourquoi elles n'apparaissent pas dans
     l'inventaire ci-dessous. --}}
{{#if zonesOutOfBacsScope.length}}
<div class="callout callout-info">
  <span class="callout-icon">📌</span>
  <div class="callout-body">
    <strong>Zones hors périmètre R175-2 :</strong> aucun système de
    chauffage, climatisation ou ECS n'est présent dans
    {{#each zonesOutOfBacsScope}}<strong>{{name}}</strong>{{#unless @last}}, {{/unless}}{{/each}}.
    Ces zones ne sont donc pas listées ci-dessous et n'entrent pas dans
    le cumul de puissance d'assujettissement.
  </div>
</div>
{{/if}}
{{#each systemsByZone}}
<h2 class="zone-heading">{{zone_name}}</h2>
{{#each items}}
  {{#if present}}
    <div class="system-card system-card-{{system_category}}">
      <div class="system-card-head">
        {{{categoryIcon system_category "16"}}}
        <span class="system-card-label">{{categoryLabel}}</span>
        {{#if total_power_kw}}
          <span class="system-card-power">{{total_power_kw}} kW</span>
        {{/if}}
        <span class="system-card-count">{{device_count}} équipement{{#if device_count}}{{#unless (eq device_count 1)}}s{{/unless}}{{/if}}</span>
      </div>
      <div class="system-card-body">
        {{!-- Item 3 — Avertissement légionelles pour les ECS bouclées --}}
        {{#if (and (eq system_category "dhw") (eq is_looped "looped"))}}
        <div class="callout callout-warning system-callout">
          <span class="callout-icon">⚠️</span>
          <div class="callout-body">
            <strong>Eau chaude sanitaire bouclée — arrêt interdit.</strong> Conformément à l'arrêté du 30 novembre 2005, une boucle d'eau chaude sanitaire ne peut pas être arrêtée ni mise en veille (risque de prolifération des légionelles). Le pilotage BACS ne doit pas couper ce poste : il assure la surveillance de la température de bouclage (≥ 50 °C en tout point).
          </div>
        </div>
        {{/if}}
        {{!-- Item 1 — Encart d'exemption pour un poste marqué négligeable (< 5 %) --}}
        {{#if marked_negligible_under_5pct}}
        <div class="callout callout-info system-callout">
          <span class="callout-icon">ℹ️</span>
          <div class="callout-body">
            <strong>Poste exempté en application de la règle des 5 %</strong> (FAQ ministère, juin 2025). Un poste représentant moins de 5 % de la consommation totale du bâtiment peut être écarté du raccordement et du comptage.{{#if negligible_justification}} {{negligible_justification}}{{/if}}
          </div>
        </div>
        {{/if}}
        {{!-- Item 4d — Assujetti calculé pour ce système --}}
        {{#if liability}}{{#if ../../hasLiabilityData}}
        <div class="system-liability">
          <span class="system-liability-icon">⚖️</span>
          <div class="system-liability-body">
            <strong>{{liability.label}}.</strong>
            {{#if liability.explanation}}<span class="muted"> {{liability.explanation}}</span>{{/if}}
          </div>
        </div>
        {{/if}}{{/if}}
        {{#if devices.length}}
          {{!--
            Refonte v2.x : passage du tableau dense (qui wrap mal en
            colonnes étroites) à une série de cards par équipement.
            Header : nom + brand/ref + badge partagé · R175-3 pills à droite.
            Body : grille d'attributs horizontaux (Énergie, Puissance,
            Nature, Communication, Localisation) — lisible quel que soit
            le nombre d'équipements (cohérence demandée).
          --}}
          <div class="device-cards">
            {{#each devices}}
              <div class="device-card" {{#if out_of_service}}style="opacity:0.55"{{/if}}>
                <div class="device-card-head">
                  <div class="device-card-title">
                    <strong>{{name}}</strong>
                    {{#if brand}}<span class="device-card-ref"> · {{brand}}{{#if model_reference}} {{model_reference}}{{/if}}</span>{{/if}}
                    {{#if out_of_service}}<span class="device-card-hs">HS</span>{{/if}}
                    {{#if shared_zone_count}}
                      <span class="shared-badge" title="Équipement partagé">↔ {{add shared_zone_count 1}} zones</span>
                    {{/if}}
                  </div>
                  {{#if ../is_bacs}}
                  <div class="device-card-r175">
                    <span class="r175-3-pill {{triCls meets_r175_3_p3 'r175-3-ok' 'r175-3-ko' 'r175-3-na'}}">
                      {{triSym meets_r175_3_p3}} Interopérable
                    </span>
                    <span class="r175-3-pill {{triCls meets_r175_3_p4 'r175-3-ok' 'r175-3-ko' 'r175-3-na'}}">
                      {{triSym meets_r175_3_p4}} Arrêt manuel
                    </span>
                    <span class="r175-3-pill {{triCls meets_r175_3_p4_autonomous 'r175-3-ok' 'r175-3-ko' 'r175-3-na'}}">
                      {{triSym meets_r175_3_p4_autonomous}} Autonome
                    </span>
                  </div>
                  {{/if}}
                </div>
                <div class="device-card-attrs">
                  <div class="device-attr">
                    <span class="device-attr-label">Énergie</span>
                    <span class="device-attr-value">{{energyLabel}}</span>
                  </div>
                  <div class="device-attr">
                    <span class="device-attr-label">Puissance</span>
                    <span class="device-attr-value">
                      {{#if has_multiple}}{{total_power_kw}} kW <span class="muted">({{quantity}}&times;{{power_kw}})</span>{{else}}{{#if power_kw}}{{power_kw}} kW{{else}}—{{/if}}{{/if}}{{#if power_kw_cooling}} <span class="muted">· froid {{power_kw_cooling}} kW</span>{{/if}}
                      {{#if powerCalc}}{{#if powerCalc.inScope}}<span class="device-power-calc">{{powerCalc.typeLabel}}</span>{{else}}<span class="device-power-calc device-power-calc-out">hors cumul</span>{{/if}}{{/if}}
                    </span>
                  </div>
                  <div class="device-attr">
                    <span class="device-attr-label">Nature</span>
                    <span class="device-attr-value">{{roleLabel}}</span>
                  </div>
                  <div class="device-attr">
                    <span class="device-attr-label">Communication</span>
                    <span class="device-attr-value">{{commLabel}}</span>
                  </div>
                  <div class="device-attr">
                    <span class="device-attr-label">Localisation</span>
                    <span class="device-attr-value">{{#if location}}{{location}}{{else}}—{{/if}}</span>
                  </div>
                </div>
                {{!-- Notes et photos du device, integrees dans la card pour eviter
                     le bloc separe avec titre dupliqué. --}}
                {{#if (or notes_html photos.length)}}
                <div class="device-card-notes">
                  {{#if notes_html}}<div class="rich-notes">{{{notes_html}}}</div>{{/if}}
                  {{#if photos.length}}
                    <div class="photo-grid">
                      {{#each photos}}<img src="{{dataUrl}}" alt="" />{{/each}}
                    </div>
                  {{/if}}
                </div>
                {{/if}}
              </div>
            {{/each}}
          </div>
        {{else}}
          <p class="muted">Système marqué présent mais aucun équipement détaillé n'a été saisi.</p>
        {{/if}}
        {{!-- Notes/photos au niveau systeme (commentaires globaux sur la
             categorie, distincts des notes par equipement integrees dans
             chaque device-card). --}}
        {{#if (or notes_html notes photos.length)}}
        <div class="system-card-notes">
          {{#if notes_html}}<div class="rich-notes">{{{notes_html}}}</div>
          {{else}}{{#if notes}}<p class="muted">{{notes}}</p>{{/if}}{{/if}}
          {{#if photos.length}}
            <div class="photo-grid">
              {{#each photos}}<img src="{{dataUrl}}" alt="" />{{/each}}
            </div>
          {{/if}}
        </div>
        {{/if}}
      </div>
    </div>
  {{else}}
    <div class="system-absent">
      {{{categoryIcon system_category "16"}}}
      <span class="system-absent-label">{{categoryLabel}}</span>
      <span class="system-absent-status">{{#if not_concerned}}{{negativeLabel}}{{else}}Non présent{{/if}}</span>
    </div>
  {{/if}}
{{/each}}
{{/each}}

{{!-- ═══════════ Chapitre 4 — Compteurs ═══════════ --}}
<h1 class="chapter" data-toc-anchor="meters">{{{faIcon "gauge" "#10b981" "16"}}} 4. Compteurs et mesurage{{#if isBacs}} (R175-3 1°){{/if}}</h1>

{{#if meterCoverageMatrix.rows.length}}
{{!-- ─── Matrice de couverture du plan de comptage ────────────────────
     Grille zones × énergies pour visualiser le plan de comptage en un
     coup d'œil. Cellule = badges-icônes d'usage (ou d'énergie pour le
     compteur général). Dot vert/rouge/noir pour l'état. --}}
<div class="coverage-matrix">
  <div class="coverage-matrix-head">{{{faIcon "gauge" "#10b981" "12"}}} Plan de comptage — vue d'ensemble de la couverture</div>
  <table class="coverage-table">
    <thead>
      <tr>
        <th class="coverage-zone-head">Zone</th>
        {{#each meterCoverageMatrix.energies}}
          <th class="coverage-energy-head{{#unless used}} coverage-energy-empty{{/unless}}">
            <span class="coverage-energy-cell">
              <span class="coverage-energy-icon" style="background:{{color}}1a;color:{{color}}">{{{faIcon icon color "9"}}}</span>
              <span class="coverage-energy-label">{{label}}</span>
            </span>
          </th>
        {{/each}}
      </tr>
    </thead>
    <tbody>
      {{#each meterCoverageMatrix.rows}}
        <tr class="coverage-row{{#if (eq zone.kind "general")}} coverage-row-general{{/if}}">
          <td class="coverage-zone-cell">
            {{#if (eq zone.kind "general")}}{{{faIcon "building-circle-arrow-right" "#6b7280" "10"}}} {{/if}}{{zone.name}}{{#if (eq zone.kind "technical")}} <span class="coverage-zone-kind">(technique)</span>{{/if}}
          </td>
          {{#each cells}}
            <td class="coverage-cell{{#unless energy.used}} coverage-cell-empty{{/unless}}">
              {{#each meters}}
                <span class="coverage-badge coverage-badge-{{state}}" style="background:{{color}}1a;color:{{color}}">
                  {{{faIcon icon color "10"}}}
                  <span class="coverage-dot coverage-dot-{{state}}"></span>
                </span>
              {{/each}}
            </td>
          {{/each}}
        </tr>
      {{/each}}
    </tbody>
  </table>
  <div class="coverage-legend">
    <span class="coverage-legend-item"><span class="coverage-dot-lg coverage-dot-present"></span>Présent</span>
    <span class="coverage-legend-item"><span class="coverage-dot-lg coverage-dot-missing"></span>Requis manquant</span>
    <span class="coverage-legend-item"><span class="coverage-dot-lg coverage-dot-hs"></span>Hors service</span>
  </div>
</div>
{{/if}}

{{#if meterEnergyGroups.length}}
{{!-- ─── Sections détaillées par énergie, compteurs groupés par zone
     (cohérent avec la vue desktop MeterEnergyGroup) ─────────────────── --}}
{{#each meterEnergyGroups}}
<div class="energy-section">
  <div class="energy-section-head">
    <span class="energy-section-icon" style="background:{{energy.color}}1a;color:{{energy.color}}">{{{faIcon energy.icon energy.color "10"}}}</span>
    <span class="energy-section-title">{{energy.label}}</span>
    <span class="energy-section-stats">
      <span>{{stats.total}} compteur{{#unless (eq stats.total 1)}}s{{/unless}}</span>
      <span class="energy-sep">·</span>
      <span class="energy-stat-present">{{stats.present}} présent{{#unless (eq stats.present 1)}}s{{/unless}}</span>
      {{#if stats.missing}}
        <span class="energy-sep">·</span>
        <span class="energy-stat-missing">{{stats.missing}} requis manquant{{#unless (eq stats.missing 1)}}s{{/unless}}</span>
      {{/if}}
    </span>
  </div>
  <table class="energy-section-table">
    <thead>
      <tr>
        <th>Zone</th><th>Usage</th><th>Localisation</th>
        <th class="bool-cell">Req.</th><th class="bool-cell">Prés.</th>
        <th class="bool-cell">Comm.</th><th class="bool-cell">Câblé</th>
        <th class="bool-cell">HS</th>
      </tr>
    </thead>
    <tbody>
      {{#each zones}}
        {{!-- Subheader de zone (regroupement visuel) --}}
        <tr class="energy-subheader{{#if is_general}} energy-subheader-general{{/if}}">
          <td colspan="8">
            {{#if is_general}}{{{faIcon "building-circle-arrow-right" "#6b7280" "9"}}} {{/if}}{{zone_name}}
            <span class="energy-subheader-count">— {{items.length}} compteur{{#unless (eq items.length 1)}}s{{/unless}}</span>
          </td>
        </tr>
        {{#each items}}
          <tr class="meter-row{{#if out_of_service}} meter-row-hs{{/if}}">
            <td>{{zoneLabel}}</td>
            <td>{{#if isGeneral}}<span class="bool-na">—</span>{{else}}{{{meterUsagePill usage}}}{{/if}}</td>
            <td>{{#if locationLabel}}{{locationLabel}}{{else}}<span class="bool-na">—</span>{{/if}}</td>
            <td class="bool-cell"><span class="{{#if required}}bool-yes{{else}}bool-no{{/if}}">{{#if required}}✓{{else}}✗{{/if}}</span></td>
            <td class="bool-cell"><span class="{{#if present_actual}}bool-yes{{else}}bool-no{{/if}}">{{#if present_actual}}✓{{else}}✗{{/if}}</span></td>
            <td class="bool-cell"><span class="{{#if communicating}}bool-yes{{else}}bool-no{{/if}}">{{#if communicating}}✓{{else}}✗{{/if}}</span></td>
            <td class="bool-cell"><span class="{{#if wired}}bool-yes{{else}}bool-no{{/if}}">{{#if wired}}✓{{else}}✗{{/if}}</span></td>
            <td class="bool-cell">{{#if out_of_service}}<strong style="color:#b91c1c">HS</strong>{{else}}<span class="bool-na">—</span>{{/if}}</td>
          </tr>
        {{/each}}
      {{/each}}
    </tbody>
  </table>
</div>
{{/each}}
{{/if}}

{{#if metersForPdf.length}}
{{#if (gt meters.length metersForPdf.length)}}
<p class="muted" style="font-size: 7pt; margin-top: 1mm">
  Note : {{minus meters.length metersForPdf.length}} compteur{{#unless (eq (minus meters.length metersForPdf.length) 1)}}s{{/unless}}
  ni requis ni présent{{#unless (eq (minus meters.length metersForPdf.length) 1)}}s{{/unless}} non listé{{#unless (eq (minus meters.length metersForPdf.length) 1)}}s{{/unless}}
  ci-dessus (zéro information actionnable).
</p>
{{/if}}
{{#if metersWithDetails.length}}
<h3 class="subheading">Notes terrain & photos</h3>
<p class="muted" style="margin: -1mm 0 2mm">Détails relevés par l'auditeur sur les compteurs du tableau ci-dessus.</p>
{{#each metersWithDetails}}
  <div class="detail-card">
    <div class="detail-card-head">
      {{{meterTypePill meter_type}}}
      {{{meterUsagePill usage}}}
      <span class="detail-card-title">{{zoneLabel}}</span>
    </div>
    <div class="detail-card-body">
      {{#if notes_html}}<div class="rich-notes">{{{notes_html}}}</div>
      {{else}}{{#if notes}}<p>{{notes}}</p>{{/if}}{{/if}}
      {{#if photos.length}}
        <div class="photo-grid">
          {{#each photos}}<img src="{{dataUrl}}" alt="" />{{/each}}
        </div>
      {{/if}}
    </div>
  </div>
{{/each}}
{{/if}}
{{else}}
<p class="muted">Aucun compteur listé. Saisis les équipements (avec leur énergie) pour générer automatiquement les compteurs requis.</p>
{{/if}}

{{#if isBacs}}
{{!-- ═══════════ Chapitre 5 — Régulation thermique ═══════════ --}}
<h1 class="chapter" data-toc-anchor="thermal">{{{faIcon "fire" "#dc2626" "16"}}} 5. Régulation thermique automatique (R175-6)</h1>

{{#if r175_6_applicable.applies}}
<div class="callout callout-warn">
  <span class="callout-icon">⚠️</span>
  <div class="callout-body"><strong>R175-6 applicable</strong> — {{r175_6_applicable.reason}}.</div>
</div>

{{#if thermal.length}}
{{!-- Mig 129 : 1 carte par couple (zone × catégorie) avec en-tête (champs
     communs) + 3 sous-blocs niveau (Production / Distribution / Émission)
     contenant équipement-process + équipement de régulation + notes par
     niveau. Cohérent avec l'ergonomie auditeur (3 sous-lignes par bloc). --}}
{{#each thermal}}
<div class="thermal-card">
  <div class="thermal-head">
    <div class="thermal-head-id">
      <span class="thermal-zone">{{zone_name}}</span>
      <span class="thermal-usage">
        {{{categoryIcon category "12"}}}<span class="thermal-usage-label">{{categoryLabel}}</span>
      </span>
      {{#if label}}<span class="thermal-system-label">{{label}}</span>{{/if}}
    </div>
    <div class="thermal-head-meta">
      <span class="thermal-meta-item">
        <span class="thermal-meta-label">Régul. auto</span>
        <span class="{{#if has_automatic_regulation}}bool-yes{{else}}bool-no{{/if}}">{{#if has_automatic_regulation}}✓{{else}}✗{{/if}}</span>
      </span>
      {{#if has_automatic_regulation}}
      <span class="thermal-meta-item">
        <span class="thermal-meta-label">Granularité</span>
        <span>{{regulationLabel}}</span>
      </span>
      {{/if}}
