<p class="muted">Aucun compteur listé. Saisis les équipements (avec leur énergie) pour générer automatiquement les compteurs requis.</p>
{{/if}}

{{#if isBacs}}
{{!-- ═══════════ Chapitre 5 — Régulation thermique ═══════════ --}}
<h1 class="chapter" data-toc-anchor="thermal">{{{faIcon "fire" "#dc2626" "16"}}} 5. Régulation thermique automatique (R175-6)</h1>

{{#if r175_6_applicable.applies}}
<div class="callout callout-warn">
  <span class="callout-icon">{{{faIcon "triangle-exclamation" "#ea580c" "14"}}}</span>
  <div class="callout-body"><strong>R175-6 applicable</strong> — {{r175_6_applicable.reason}}.</div>
</div>

{{#if thermal.length}}
{{!-- Mig 129 : 1 carte par couple (zone × catégorie) avec en-tête (champs
     communs) + 3 sous-blocs niveau (Production / Distribution / Émission)
     contenant équipement-process + équipement de régulation + notes par
     niveau. Cohérent avec l'ergonomie auditeur (3 sous-lignes par bloc). --}}
{{#each thermal}}
<div class="thermal-card">
  <div class="thermal-head">
    <div class="thermal-head-id">
      <span class="thermal-zone">{{zone_name}}</span>
      <span class="thermal-usage">
        {{{categoryIcon category "12"}}}<span class="thermal-usage-label">{{categoryLabel}}</span>
      </span>
      {{#if displayLabel}}<span class="thermal-system-label">{{displayLabel}}</span>{{/if}}
    </div>
    <div class="thermal-head-meta">
      <span class="thermal-meta-item">
        <span class="thermal-meta-label">Régul. auto</span>
        <span class="{{#if has_automatic_regulation}}bool-yes{{else}}bool-no{{/if}}">{{#if has_automatic_regulation}}✓{{else}}✗{{/if}}</span>
      </span>
      {{#if has_automatic_regulation}}
      <span class="thermal-meta-item">
        <span class="thermal-meta-label">Granularité</span>
        <span>{{regulationLabel}}</span>
      </span>
      {{/if}}
      {{#if generator_exempt_wood}}
      <span class="thermal-meta-item">
        <span class="bool-yes">✓ Exempté bois (R175-6 II)</span>
      </span>
      {{/if}}
    </div>
    {{#if notes_html}}
    <div class="thermal-notes-global rich-notes">{{{notes_html}}}</div>
    {{else}}{{#if notes}}
    <div class="thermal-notes-global">{{notes}}</div>
    {{/if}}{{/if}}
  </div>
  <div class="thermal-levels">
    {{#each levels}}
    <div class="thermal-level">
      <div class="thermal-level-head">
        <span class="thermal-level-label">{{label}}</span>
      </div>
      <div class="thermal-level-body">
        <span class="thermal-level-field">
          <span class="thermal-field-label">Équipement</span>
          <span class="thermal-field-value">{{#if device_name}}{{device_name}}{{else}}<span class="muted">—</span>{{/if}}</span>
        </span>
        <span class="thermal-level-field">
          <span class="thermal-field-label">Équipement de régulation</span>
          <span class="thermal-field-value">{{#if regulation_device_name}}{{regulation_device_name}}{{else}}<span class="muted">—</span>{{/if}}</span>
        </span>
        {{!-- Mig 179 : Type de régulation par niveau (saisi sur le device :
             loi d'eau, vanne 3 voies, thermostat ambiant…). Affiché seulement
             si renseigné — un système peut avoir un régulateur sans avoir
             explicité son type. --}}
        {{#if regulation_type}}
        <span class="thermal-level-field">
          <span class="thermal-field-label">Type de régulation</span>
          <span class="thermal-field-value">{{regulation_type}}</span>
        </span>
        {{/if}}
        {{!-- Mig 179 : identité régulateur (marque + référence) saisie sur
             le device porteur. Affichée seulement si renseignée. --}}
        {{#if regulator_brand}}{{#if regulator_model_reference}}
        <span class="thermal-level-field">
          <span class="thermal-field-label">Régulateur</span>
          <span class="thermal-field-value">{{regulator_brand}} · {{regulator_model_reference}}</span>
        </span>
        {{else}}
        <span class="thermal-level-field">
          <span class="thermal-field-label">Régulateur</span>
          <span class="thermal-field-value">{{regulator_brand}}</span>
        </span>
        {{/if}}{{else}}{{#if regulator_model_reference}}
        <span class="thermal-level-field">
          <span class="thermal-field-label">Régulateur</span>
          <span class="thermal-field-value">{{regulator_model_reference}}</span>
        </span>
        {{/if}}{{/if}}
        {{!-- Mig 181 : Localisation libre par niveau (« chaufferie », « bureau
             RDC », « gaine VMC »…). --}}
        {{#if regulator_location}}
        <span class="thermal-level-field">
          <span class="thermal-field-label">Localisation</span>
          <span class="thermal-field-value">{{regulator_location}}</span>
        </span>
        {{/if}}
        {{#if ../generatorLabel}}{{#if (eq key "production")}}
        <span class="thermal-level-field">
          <span class="thermal-field-label">Énergie production</span>
          <span class="thermal-field-value">{{../generatorLabel}}{{#if ../generator_age_years}} · {{../generator_age_years}} ans{{/if}}</span>
        </span>
        {{/if}}{{/if}}
      </div>
      {{#if notes_html}}
      <div class="thermal-level-notes rich-notes">{{{notes_html}}}</div>
      {{/if}}
    </div>
    {{/each}}
  </div>
</div>
{{/each}}
{{else}}
<p class="muted">Régulation thermique non documentée.</p>
{{/if}}
{{else}}
<div class="callout callout-reco">
  <span class="callout-icon">{{{faIcon "circle-check" "#00cd92" "14"}}}</span>
  <div class="callout-body">
    <p><strong>R175-6 — régulation thermique automatique par zone : non applicable à votre bâtiment.</strong></p>
    <p class="explainer-rule"><em>Ce qu'impose le décret.</em> L'article R175-6 oblige les propriétaires des émetteurs reliés à un générateur de chaleur installé ou remplacé à mettre en place une régulation automatique de la température «&nbsp;par pièce ou par zone chauffée&nbsp;». Cette obligation s'enclenche dans deux cas&nbsp;: (1)&nbsp;dans les bâtiments dont le permis de construire est déposé après le 21&nbsp;juillet&nbsp;2021&nbsp;; (2)&nbsp;dans les autres bâtiments, dès lors que des travaux d'installation ou de remplacement du générateur de chaleur sont engagés après cette date — sauf étude attestant d'un temps de retour sur investissement supérieur à dix&nbsp;ans. Les appareils indépendants de chauffage au bois sont exclus.</p>
    <p class="explainer-check"><em>Ce que nous avons vérifié pour votre bâtiment.</em>
      {{#if r175_6_applicable.permitDateFr}}Permis de construire&nbsp;: <strong>{{r175_6_applicable.permitDateFr}}</strong>{{else}}Permis de construire non renseigné dans cet audit{{/if}}.
      {{#if r175_6_applicable.worksDateFr}}Derniers travaux de générateur de chaleur&nbsp;: <strong>{{r175_6_applicable.worksDateFr}}</strong>{{else}}Aucun remplacement de générateur de chaleur postérieur à la mise en service n'a été déclaré{{/if}}.
      Aucune de ces dates ne dépasse le seuil du 21&nbsp;juillet&nbsp;2021 — votre bâtiment n'est donc pas soumis aujourd'hui à l'obligation de régulation thermique automatique par zone.</p>
    <p class="explainer-watch"><em>Point de vigilance.</em> Tout futur remplacement ou ajout d'un générateur de chaleur (chaudière, pompe à chaleur, sous-station de réseau urbain…) postérieur au 21&nbsp;juillet&nbsp;2021 enclenche immédiatement l'obligation sur les zones desservies par ce nouveau générateur, sauf à produire une étude justifiant un temps de retour sur investissement supérieur à dix&nbsp;ans.</p>
  </div>
</div>
{{/if}}
{{/if}}

{{!-- ═══════════ Chapitre 6 — GTB / Supervision ═══════════ --}}
<h1 class="chapter" data-toc-anchor="bms">{{{faIcon "plug" "#1b2842" "16"}}} {{#if isBacs}}6. Solution GTB / GTC (R175-3, R175-4, R175-5){{else}}5. Solution de supervision en place{{/if}}</h1>
{{#if (eq bms.present 0)}}
<div class="callout callout-warn">
  <span class="callout-icon">{{{faIcon "triangle-exclamation" "#ea580c" "14"}}}</span>
  <div class="callout-body"><strong>Aucune GTB sur le site.</strong> Le bâtiment ne dispose d'aucun système de gestion technique. L'installation d'une GTB conforme au décret BACS figure dans le plan de mise en conformité (chapitre 7). Les exigences R175-3, R175-4 et R175-5 ne sont donc pas évaluées en détail dans ce chapitre.</div>
</div>
{{else}}
{{#if bms}}
{{#if bms.out_of_service}}
<div class="callout callout-warn">
  <span class="callout-icon">{{{faIcon "triangle-exclamation" "#ea580c" "14"}}}</span>
  <div class="callout-body"><strong>GTB Hors-Service.</strong> Les exigences R175-3, R175-4 et R175-5 ne sont pas évaluées car la GTB n'est pas opérationnelle au moment de l'audit.</div>
</div>
{{/if}}

{{!-- Card 1 — Identité de la solution GTB --}}
<div class="info-cards">
  <div class="info-card info-card-wide info-card-accent">
    <span class="info-card-label">Solution en place</span>
    <span class="info-card-value info-card-value-strong">
      {{#if bms.existing_solution}}{{bms.existing_solution}}{{else}}Non renseigné{{/if}}
    </span>
  </div>
  {{#if bms.existing_solution_brand}}
  <div class="info-card">
    <span class="info-card-label">Marque / éditeur</span>
    <span class="info-card-value">{{bms.existing_solution_brand}}</span>
  </div>
  {{/if}}
  {{#if bms.model_reference}}
  <div class="info-card">
    <span class="info-card-label">Référence modèle</span>
    <span class="info-card-value">{{bms.model_reference}}</span>
  </div>
  {{/if}}
  {{#if bms.location}}
  <div class="info-card info-card-wide">
    <span class="info-card-label">Localisation</span>
    <span class="info-card-value">{{bms.location}}</span>
  </div>
  {{/if}}
  {{#if bms.providedProtocolsLabels.length}}
  <div class="info-card info-card-wide">
    <span class="info-card-label">Protocoles de mise à disposition des points</span>
    <span class="info-card-value">{{join bms.providedProtocolsLabels ", "}}</span>
  </div>
  {{/if}}
  <div class="info-card info-card-wide">
    <span class="info-card-label">Analyse fonctionnelle de la GTB existante</span>
    {{#if (eq document.audit_existing_af_status "absent")}}
      <span class="info-card-value info-card-value-warn">Aucun document d'AF disponible</span>
    {{else}}
      <span class="info-card-value">Document fourni par le propriétaire ou son exploitant</span>
    {{/if}}
  </div>
  {{#if bmsTopicNotes.analyse_fonctionnelle}}
  <div class="info-card info-card-wide">
    <span class="info-card-label">Notes de l'auditeur</span>
    <div class="info-card-value rich-notes">{{{bmsTopicNotes.analyse_fonctionnelle}}}</div>
  </div>
  {{/if}}
  {{#if bmsTopicOpportunities.analyse_fonctionnelle}}
  <div class="info-card info-card-wide bms-opportunity-card">
    <span class="info-card-label">Opportunités d'amélioration</span>
    <div class="info-card-value rich-notes">{{{bmsTopicOpportunities.analyse_fonctionnelle}}}</div>
  </div>
  {{/if}}
</div>

{{!-- Composants matériels de la GTB — bloc visible uniquement si l'auditeur
     a saisi au moins un composant (serveur, contrôleur, passerelle…). --}}
{{#if bmsComponents.length}}
<div class="panel">
  <div class="panel-head">
    <h3 class="panel-title">Composants matériels de la GTB</h3>
    <p class="panel-subtitle">Serveurs, contrôleurs, passerelles, automates relevés sur site.</p>
  </div>
  <div class="panel-body">
    <table class="bms-components-table">
      <thead>
        <tr>
          <th>Type</th><th>Marque · Modèle</th><th>Localisation</th>
          <th>Adresse IP</th><th>Protocoles</th><th>Firmware</th>
        </tr>
      </thead>
      <tbody>
        {{#each bmsComponents}}
        <tr>
          <td>{{#if component_type}}{{component_type}}{{else}}<span class="bool-na">—</span>{{/if}}</td>
          <td>{{#if brand}}<strong>{{brand}}</strong>{{/if}}{{#if model}}{{#if brand}} · {{/if}}{{model}}{{/if}}{{#unless (or brand model)}}<span class="bool-na">—</span>{{/unless}}</td>
          <td>{{#if location}}{{location}}{{else}}<span class="bool-na">—</span>{{/if}}</td>
          <td>{{#if ip_address}}<code>{{ip_address}}</code>{{else}}<span class="bool-na">—</span>{{/if}}</td>
          <td>{{#if protocolsLabel}}<span class="muted">{{protocolsLabel}}</span>{{else}}<span class="bool-na">—</span>{{/if}}</td>
          <td>{{#if firmware_version}}{{firmware_version}}{{else}}<span class="bool-na">—</span>{{/if}}</td>
        </tr>
        {{#if notes_html}}<tr class="bms-component-notes-row"><td colspan="6"><div class="rich-notes">{{{notes_html}}}</div></td></tr>{{/if}}
        {{#unless notes_html}}{{#if notes}}<tr class="bms-component-notes-row"><td colspan="6">{{notes}}</td></tr>{{/if}}{{/unless}}
        {{/each}}
      </tbody>
    </table>
  </div>
</div>
{{/if}}

{{!-- Card 2 — Usages couverts vs non couverts par la GTB --}}
<div class="panel">
  <div class="panel-head">
    <h3 class="panel-title">Usages couverts par la GTB</h3>
    <p class="panel-subtitle">Pastille colorée = usage piloté par la GTB. Pastille grisée = usage présent sur le site mais hors périmètre GTB actuel (à intégrer pour conformité R175-3).</p>
  </div>
  <div class="panel-body">
    <div class="usage-pills">
      <span class="usage-pill {{#if bms.manages_heating}}usage-pill-heating{{else}}usage-pill-off{{/if}}">{{{categoryIcon "heating" "12"}}}Chauffage{{#unless bms.manages_heating}} · non couvert{{/unless}}</span>
      <span class="usage-pill {{#if bms.manages_cooling}}usage-pill-cooling{{else}}usage-pill-off{{/if}}">{{{categoryIcon "cooling" "12"}}}Refroidissement{{#unless bms.manages_cooling}} · non couvert{{/unless}}</span>
      <span class="usage-pill {{#if bms.manages_ventilation}}usage-pill-ventilation{{else}}usage-pill-off{{/if}}">{{{categoryIcon "ventilation" "12"}}}Ventilation{{#unless bms.manages_ventilation}} · non couvert{{/unless}}</span>
      <span class="usage-pill {{#if bms.manages_dhw}}usage-pill-dhw{{else}}usage-pill-off{{/if}}">{{{categoryIcon "dhw" "12"}}}ECS{{#unless bms.manages_dhw}} · non couvert{{/unless}}</span>
      <span class="usage-pill {{#if bms.manages_lighting}}usage-pill-lighting{{else}}usage-pill-off{{/if}}">{{{categoryIcon "lighting_indoor" "12"}}}Éclairage{{#unless bms.manages_lighting}} · non couvert{{/unless}}</span>
    </div>
    {{#if bmsTopicNotes.usages}}
    <div class="panel-inline-note">
      <strong>Notes de l'auditeur :</strong> <span class="rich-notes">{{{bmsTopicNotes.usages}}}</span>
    </div>
    {{/if}}
    {{#if bmsTopicOpportunities.usages}}
    <div class="panel-inline-note panel-opportunity">
      <strong>Opportunités d'amélioration :</strong> <span class="rich-notes">{{{bmsTopicOpportunities.usages}}}</span>
    </div>
    {{/if}}
  </div>
</div>

{{#if isBacs}}
{{!-- Card 3 — R175-3 Capacités de supervision --}}
<div class="panel">
  <div class="panel-head">
    <h3 class="panel-title">R175-3 — Capacités de supervision</h3>
    <p class="panel-subtitle">3° (interopérabilité) et 4° (arrêt manuel + autonome) sont évalués au niveau de chaque équipement (chapitre 3).</p>
  </div>
  <div class="panel-body">
    <div class="kv-list">
      <div class="kv-row">
        <div class="kv-label-block">
          <span class="kv-label">P1. Suivi continu, pas horaire, conservation 5 ans</span>
          <span class="kv-explainer">La GTB doit collecter et analyser <em>en continu</em>, à un pas de temps horaire et par zone fonctionnelle, les consommations et productions énergétiques de chaque système technique du bâtiment, ajuster automatiquement ces systèmes en conséquence, et conserver les données à l'échelle mensuelle pendant cinq ans (article R175-3 §1).</span>
        </div>
        <span class="kv-value {{#if bms.meets_r175_3_p1}}kv-yes{{else}}kv-no{{/if}}">
          <span class="kv-ico">{{#if bms.meets_r175_3_p1}}✓{{else}}✗{{/if}}</span>{{boolLabel bms.meets_r175_3_p1}}
        </span>
      </div>
      <div class="kv-row">
        <div class="kv-label-block">
          <span class="kv-label">P2. Détection des pertes d'efficacité</span>
          <span class="kv-explainer">La GTB doit situer l'efficacité énergétique du bâtiment par rapport à des valeurs de référence (étude énergétique, caractéristiques nominales de chaque système technique), détecter automatiquement les pertes d'efficacité et informer l'exploitant des possibilités d'amélioration (article R175-3 §2).</span>
        </div>
        <span class="kv-value {{#if bms.meets_r175_3_p2}}kv-yes{{else}}kv-no{{/if}}">
          <span class="kv-ico">{{#if bms.meets_r175_3_p2}}✓{{else}}✗{{/if}}</span>{{boolLabel bms.meets_r175_3_p2}}
        </span>
      </div>
    </div>
    {{!-- Sous-bloc P1 : format d'archivage + vérification rétention 5 ans
         (visibles si P1 est marqué Oui). --}}
    {{#if bms.meets_r175_3_p1}}{{#if (or bms.r175_3_p1_archival_format bms.r175_3_p1_retention_verified)}}
    <div class="bms-sub-detail">
      <span class="bms-sub-label">Détail P1 — archivage</span>
      {{#if bms.r175_3_p1_archival_format}}
