{{!-- Synthese "engagement contractuel" injectee en tete du chapitre 13.
     Calculee a partir des fonctionnalites demandees par le MOA :
     niveau d'offre minimum + options payantes a souscrire dans l'avenant. --}}
<div class="contractual-summary">
  {{#if hasDemands}}
    <div class="contractual-recommended">
      <div class="contractual-recommended-label">Offre choisie par le MOA</div>
      <div class="contractual-recommended-name">{{currentLevelName}}</div>
      {{#if upgradeNeeded}}
      <div class="contractual-upgrade-note">
        ⚠ Certaines fonctionnalités exigées par le MOA ne sont pas disponibles au niveau <strong>{{currentLevelName}}</strong> — voir liste ci-dessous (un changement de niveau d'offre est nécessaire pour les couvrir).
      </div>
      {{else}}
      <div class="contractual-upgrade-note contractual-upgrade-ok">
        Toutes les fonctionnalités exigées sont couvertes par l'offre <strong>{{currentLevelName}}</strong> (incluses ou activables en option).
      </div>
      {{/if}}
    </div>

    {{#if requiredOptions.length}}
    <div class="contractual-block">
      <h4 class="contractual-block-title">Options payantes à inclure dans l'avenant</h4>
      <ul class="contractual-list contractual-list-options">
        {{#each requiredOptions}}
        <li><span class="contractual-pill contractual-pill-option">€ Option</span> {{title}}</li>
        {{/each}}
      </ul>
    </div>
    {{/if}}

    {{#if coveredFeatures.length}}
    <div class="contractual-block">
      <h4 class="contractual-block-title">Fonctionnalités déjà incluses dans l'offre {{currentLevelName}}</h4>
      <ul class="contractual-list">
        {{#each coveredFeatures}}
        <li><span class="contractual-pill contractual-pill-included">✓ Incluse</span> {{title}}</li>
        {{/each}}
      </ul>
    </div>
    {{/if}}

    {{#if unavailableFeatures.length}}
    <div class="contractual-block contractual-block-warn">
      <h4 class="contractual-block-title">⚠ Fonctionnalités non disponibles au niveau {{currentLevelName}}</h4>
      <ul class="contractual-list">
        {{#each unavailableFeatures}}
        <li>{{title}}</li>
        {{/each}}
      </ul>
    </div>
    {{/if}}
  {{else}}
    <div class="contractual-noinput">
      <p>Aucune fonctionnalité n'a été marquée comme exigée ni activée en option payante par le MOA à ce stade. L'offre <strong>{{currentLevelName}}</strong> reste l'engagement contractuel applicable, dans son périmètre standard.</p>
    </div>
  {{/if}}
</div>
