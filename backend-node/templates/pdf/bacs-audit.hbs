{{!-- Card 4 — R175-3 Mise à disposition des données --}}
<div class="panel">
  <div class="panel-head">
    <h3 class="panel-title">R175-3 — Mise à disposition des données <span class="panel-title-meta">(dernier alinéa)</span></h3>
  </div>
  <div class="panel-body">
    <div class="kv-list">
      <div class="kv-row">
        <div class="kv-label-block">
          <span class="kv-label">Mise à disposition des données au gestionnaire du bâtiment</span>
          <span class="kv-explainer">Le propriétaire de la GTB, propriétaire des données produites et archivées, les met à la disposition du gestionnaire du bâtiment, à sa demande (R175-3, dernier alinéa). Le décret n'impose pas de procédure écrite : Buildy vérifie que l'accès existe (canal, format, délai).</span>
        </div>
        <span class="kv-value {{triCls bms.data_provision_to_manager 'kv-yes' 'kv-no' 'kv-na'}}">
          <span class="kv-ico">{{triSym bms.data_provision_to_manager}}</span>{{boolLabel bms.data_provision_to_manager}}
        </span>
      </div>
      <div class="kv-row">
        <div class="kv-label-block">
          <span class="kv-label">Transmission des données aux exploitants des systèmes techniques</span>
          <span class="kv-explainer">Le propriétaire de la GTB transmet à chaque exploitant des systèmes techniques reliés (chauffage, climatisation, ventilation, éclairage…) les données qui le concernent, pour qu'il puisse suivre, diagnostiquer et optimiser son propre périmètre (R175-3, dernier alinéa).</span>
        </div>
        <span class="kv-value {{triCls bms.data_provision_to_operators 'kv-yes' 'kv-no' 'kv-na'}}">
          <span class="kv-ico">{{triSym bms.data_provision_to_operators}}</span>{{boolLabel bms.data_provision_to_operators}}
        </span>
      </div>
    </div>
    {{#if bms.notes_data_provision}}
    <div class="panel-inline-note">
      <strong>Mécanisme :</strong> {{bms.notes_data_provision}}
    </div>
    {{/if}}
    {{!-- Détail saisi par l'auditeur : fréquence + format de mise à dispo. --}}
    {{#if (or bms.data_provision_frequency bms.data_provision_format)}}
    <div class="bms-sub-detail">
      <span class="bms-sub-label">Modalités de mise à disposition</span>
      {{#if bms.data_provision_frequency}}
      <span class="bms-sub-item"><strong>Fréquence :</strong> {{bms.data_provision_frequency}}</span>
      {{/if}}
      {{#if bms.data_provision_format}}
      <span class="bms-sub-item"><strong>Format :</strong> {{bms.data_provision_format}}</span>
      {{/if}}
    </div>
    {{/if}}
    {{#if bmsTopicNotes.r175_3_mise_dispo}}
    <div class="panel-inline-note">
      <strong>Notes de l'auditeur :</strong> <span class="rich-notes">{{{bmsTopicNotes.r175_3_mise_dispo}}}</span>
    </div>
    {{/if}}
    {{#if bmsTopicOpportunities.r175_3_mise_dispo}}
    <div class="panel-inline-note panel-opportunity">
      <strong>Opportunités d'amélioration :</strong> <span class="rich-notes">{{{bmsTopicOpportunities.r175_3_mise_dispo}}}</span>
    </div>
    {{/if}}
  </div>
</div>

{{!-- Item 15 — Card R175-3 : conservation 5 ans + accès aux données --}}
{{#if (or bms.data_storage_5y_compliant bms.data_owner_access bms.gestionnaire_exploitant_access bms.export_capability)}}
<div class="panel">
  <div class="panel-head">
    <h3 class="panel-title">R175-3 — Conservation et accès aux données <span class="panel-title-meta">(archivage 5 ans)</span></h3>
  </div>
  <div class="panel-body">
    <table class="storage-access-table">
      <thead>
        <tr><th>Point vérifié</th><th>État constaté</th></tr>
      </thead>
      <tbody>
        <tr>
          <td>Conservation des consommations à l'échelle mensuelle pendant 5 ans</td>
          <td class="sa-state sa-{{bms.data_storage_5y_compliant}}">
            {{#if (eq bms.data_storage_5y_compliant "yes")}}{{{glyph "✓" "10"}}} Conforme{{#if bms.buildyOffer.retentionByExport}}, sous réserve d'exports réguliers depuis Hyperveez (12 mois conservés en {{bms.buildyOffer.levelLabel}}){{/if}}{{else}}{{#if (eq bms.data_storage_5y_compliant "no")}}{{{glyph "✗" "10"}}} Non conforme{{else}}? Non déterminé{{/if}}{{/if}}
          </td>
        </tr>
        <tr>
          <td>Localisation du stockage des données</td>
          <td>
            {{#if (eq bms.data_storage_location "local")}}Serveur local{{else}}{{#if (eq bms.data_storage_location "cloud_editeur")}}Cloud de l'éditeur de la GTB{{else}}{{#if (eq bms.data_storage_location "cloud_proprietaire")}}Cloud du propriétaire{{else}}Non déterminée{{/if}}{{/if}}{{/if}}
          </td>
        </tr>
        <tr>
          <td>Accès direct du propriétaire à ses données</td>
          <td class="sa-state sa-{{bms.data_owner_access}}">
            {{#if (eq bms.data_owner_access "yes")}}{{{glyph "✓" "10"}}} Oui{{else}}{{#if (eq bms.data_owner_access "no")}}{{{glyph "✗" "10"}}} Non{{else}}{{#if (eq bms.data_owner_access "partial")}}Partiel{{else}}Non renseigné{{/if}}{{/if}}{{/if}}
          </td>
        </tr>
        <tr>
          <td>Accès du gestionnaire et des exploitants aux données</td>
          <td class="sa-state sa-{{dataAccessRow.state}}">{{#if (eq dataAccessRow.state "yes")}}{{{glyph "✓" "10"}}} {{/if}}{{#if (eq dataAccessRow.state "no")}}{{{glyph "✗" "10"}}} {{/if}}{{dataAccessRow.label}}</td>
        </tr>
        <tr>
          <td>Export des données dans un format ouvert (CSV ou tableur) — non exigé par le décret</td>
          <td class="sa-state sa-{{bms.export_capability}}">
            {{#if (eq bms.export_capability "yes")}}{{{glyph "✓" "10"}}} Possible{{else}}{{#if (eq bms.export_capability "no")}}{{{glyph "✗" "10"}}} Impossible{{else}}—{{/if}}{{/if}}
          </td>
        </tr>
      </tbody>
    </table>
    {{#if bms.data_access_notes}}
    <div class="panel-inline-note">
      <strong>Observations :</strong> {{bms.data_access_notes}}
    </div>
    {{/if}}
  </div>
</div>
{{/if}}

{{!-- Card 5 — R175-4 Vérifications périodiques --}}
<div class="panel">
  <div class="panel-head">
    <h3 class="panel-title">R175-4 — Vérifications périodiques</h3>
  </div>
  <div class="panel-body">
    <div class="kv-list">
      <div class="kv-row">
        <div class="kv-label-block">
          <span class="kv-label">Vérifications périodiques organisées (contrat de maintenance ou personnel interne, consignes écrites)</span>
          <span class="kv-explainer">La GTB fait l'objet de vérifications périodiques, par un prestataire externe ou un personnel interne compétent, encadrées par des consignes écrites données au gestionnaire : périodicité des interventions, points à contrôler, réparation rapide ou remplacement des éléments défaillants (R175-4).</span>
          {{#if maintenanceReserveNumber}}<span class="kv-explainer kv-reserve-note">Réserve : obligation à respecter, sans effet sur la conformité de l'installation (voir {{maintenanceReserveNumber}} au plan d'actions).</span>{{/if}}
        </div>
        {{!-- Réserve (obligation du propriétaire) : même teinte que les autres
             réserves, pas le rouge d'un écart. --}}
        {{#if maintenanceReserveNumber}}
        <span class="kv-value kv-reserve">À mettre en place</span>
        {{else}}
        <span class="kv-value {{triCls bms.has_maintenance_procedures 'kv-yes' 'kv-no' 'kv-na'}}">
          <span class="kv-ico">{{triSym bms.has_maintenance_procedures}}</span>{{boolLabel bms.has_maintenance_procedures}}
        </span>
        {{/if}}
      </div>
    </div>
    {{!-- Périodicité + responsable de la maintenance (visibles si consignes
         saisies). --}}
    {{#if bms.has_maintenance_procedures}}{{#if (or bms.maintenance_periodicity bms.maintenance_responsible)}}
    <div class="bms-sub-detail">
      <span class="bms-sub-label">Modalités de maintenance</span>
      {{#if bms.maintenance_periodicity}}
      <span class="bms-sub-item"><strong>Périodicité :</strong> {{bms.maintenance_periodicity}}</span>
      {{/if}}
      {{#if bms.maintenance_responsible}}
      <span class="bms-sub-item"><strong>Responsable :</strong> {{bms.maintenance_responsible}}</span>
      {{/if}}
    </div>
    {{/if}}{{/if}}
    {{#if bmsTopicNotes.r175_4}}
    <div class="panel-inline-note">
      <strong>Notes de l'auditeur :</strong> <span class="rich-notes">{{{bmsTopicNotes.r175_4}}}</span>
    </div>
    {{/if}}
    {{#if bmsTopicOpportunities.r175_4}}
    <div class="panel-inline-note panel-opportunity">
      <strong>Opportunités d'amélioration :</strong> <span class="rich-notes">{{{bmsTopicOpportunities.r175_4}}}</span>
    </div>
    {{/if}}
  </div>
</div>

{{!-- Card 6 — R175-5 Formation de l'exploitant --}}
<div class="panel">
  <div class="panel-head">
    <h3 class="panel-title">R175-5 — Formation de l'exploitant</h3>
  </div>
  <div class="panel-body">
    <div class="kv-list">
      <div class="kv-row">
        <div class="kv-label-block">
          <span class="kv-label">Exploitant formé au paramétrage{{#if bms.operator_training_date}} <span class="muted">(formation du {{frDate bms.operator_training_date}})</span>{{/if}}</span>
          <span class="kv-explainer">Le propriétaire de la GTB doit s'assurer que son exploitant est formé au fonctionnement de la GTB, et en particulier aux modalités de son paramétrage (consignes, programmes horaires, seuils d'alarme…). Référence : article R175-5.</span>
        </div>
        <span class="kv-value {{triCls bms.operator_trained 'kv-yes' 'kv-no' 'kv-na'}}">
          <span class="kv-ico">{{triSym bms.operator_trained}}</span>{{boolLabel bms.operator_trained}}
        </span>
      </div>
    </div>
    {{!-- Formateur + sujets couverts (visibles si formation déclarée). --}}
    {{#if bms.operator_trained}}{{#if (or bms.operator_training_provider bms.operator_training_topics)}}
    <div class="bms-sub-detail">
      <span class="bms-sub-label">Modalités de formation</span>
      {{#if bms.operator_training_provider}}
      <span class="bms-sub-item"><strong>Formateur :</strong> {{bms.operator_training_provider}}</span>
      {{/if}}
      {{#if bms.operator_training_topics}}
      <span class="bms-sub-item"><strong>Sujets couverts :</strong> {{bms.operator_training_topics}}</span>
      {{/if}}
    </div>
    {{/if}}{{/if}}
    {{#if buildySolution}}
    {{!-- 7mm de marge haute : le bandeau « Modalités de formation » a une marge
         basse négative (-3mm) pour déborder au bas du panneau. Sans surcompenser
         ici, l'encart vert se collerait au bandeau bleu. --}}
    <div class="callout callout-info" style="margin: 7mm 0 0;">
      <span class="callout-icon">{{{faIcon "circle-info" "#6b7280" "14"}}}</span>
      <div class="callout-body">
        {{#if bms.operator_trained}}
        <strong>Solution Buildy déployée.</strong> L'aide en ligne et le support de la solution facilitent la prise en main. Formation de l'exploitant{{#if bms.operator_training_date}} du {{frDate bms.operator_training_date}}{{/if}}{{#if bms.operator_training_provider}} ({{bms.operator_training_provider}}){{/if}} : la feuille d'émargement est à conserver, elle est demandée lors de l'inspection périodique (R175-5, FAQ n° 30).
        {{else}}
        <strong>Solution Buildy déployée.</strong> L'aide en ligne et le support de la solution facilitent la prise en main. La formation de l'exploitant au fonctionnement et au paramétrage de la GTB reste à attester (date, participants, feuille d'émargement), comme le prévoit l'inspection périodique (R175-5, FAQ n° 30).
        {{/if}}
      </div>
    </div>
    {{/if}}
    {{#if bmsTopicNotes.r175_5}}
    <div class="panel-inline-note">
      <strong>Notes de l'auditeur :</strong> <span class="rich-notes">{{{bmsTopicNotes.r175_5}}}</span>
    </div>
    {{/if}}
    {{#if bmsTopicOpportunities.r175_5}}
    <div class="panel-inline-note panel-opportunity">
      <strong>Opportunités d'amélioration :</strong> <span class="rich-notes">{{{bmsTopicOpportunities.r175_5}}}</span>
    </div>
    {{/if}}
  </div>
</div>
{{/if}}

{{!-- Card 7 — Équipements : intégrés vs à intégrer --}}
{{#if (or bmsDevicesByZone.length bmsTopicNotes.equipements)}}
<div class="panel">
  <div class="panel-head">
    <h3 class="panel-title">Équipements et leur intégration à la GTB</h3>
    <p class="panel-subtitle">Inventaire des équipements présents avec leur statut d'intégration : <strong>{{bmsManagedDevices.length}}</strong> déjà intégré{{#unless (eq bmsManagedDevices.length 1)}}s{{/unless}}, <strong>{{bmsUnmanagedDevices.length}}</strong> à intégrer{{#if bmsOutOfScopeDevices.length}} (dont {{bmsOutOfScopeDevices.length}} d'usages que la GTB ne traite pas){{/if}}{{#if bmsUnansweredDevices.length}}, {{bmsUnansweredDevices.length}} à qualifier{{/if}}{{#if bmsNotTargetedDevices.length}}, {{bmsNotTargetedDevices.length}} non visé{{#unless (eq bmsNotTargetedDevices.length 1)}}s{{/unless}} (émetteurs à régulation locale, ou équipements déclarés non concernés par l'auditeur){{/if}}.{{#if bmsUnmanagedDevices.length}} Les équipements marqués « Non » ne sont pas raccordés à la GTB. Le plan d'actions précise les raccordements à réaliser (en priorité les générateurs, directement ou par leur régulateur : passerelle, module de communication ou remplacement selon le cas) ; dans un bâtiment existant, certains ne sont exigés que sous condition de temps de retour sur investissement.{{/if}}</p>
  </div>
  <div class="panel-body panel-body-flush">
    {{#if bmsDevicesByZone.length}}
    <table class="bms-devices-table">
      <thead>
        <tr>
          <th class="bms-col-name">Équipement</th>
          <th class="bms-col-usage">Usage</th>
          <th class="bms-col-int">Intégré&nbsp;?</th>
        </tr>
      </thead>
      <tbody>
        {{#each bmsDevicesByZone}}
        <tr class="bms-zone-row"><td colspan="3">{{zone_name}}</td></tr>
        {{#each devices}}
        <tr>
          <td class="bms-col-name"><strong>{{name}}</strong>{{#if brand}} <span class="muted">· {{brand}}{{#if model_reference}} {{model_reference}}{{/if}}</span>{{/if}}{{#if sharedWithLabel}}<br><span class="muted">Dessert aussi : {{sharedWithLabel}}</span>{{/if}}</td>
          <td class="bms-col-usage">{{{systemCategoryPill system_category "sm"}}}</td>
          <td class="bms-col-int">{{#if excludedByAuditor}}<span class="muted" title="Équipement déclaré non concerné par l'intégration à la GTB par l'auditeur">Non concerné<br><span style="font-size:6.5pt">(décision de l'auditeur)</span></span>{{else if interopNotTargeted}}<span class="muted" title="Émetteur à régulation locale : le raccordement n'est pas visé (R175-3 3°)">Non visé</span>{{else if outOfGtbScope}}{{{boolPill 0 "sm"}}}<br><span class="muted" style="font-size:6.5pt">usage non traité par la GTB</span>{{else if bms_integration_out_of_service}}<strong style="color:#b91c1c" title="Liaison avec la GTB hors service">Liaison interrompue</strong>{{else}}{{{boolPill managed_by_bms "sm" "" "À qualifier"}}}{{/if}}</td>
        </tr>
        {{/each}}
        {{/each}}
      </tbody>
    </table>
    {{/if}}
    {{#if bmsTopicNotes.equipements}}
    <div class="panel-inline-note" style="margin: 3mm 4mm 0;">
      <strong>Notes de l'auditeur :</strong> <span class="rich-notes">{{{bmsTopicNotes.equipements}}}</span>
    </div>
    {{/if}}
    {{#if bmsTopicOpportunities.equipements}}
    <div class="panel-inline-note panel-opportunity" style="margin: 2mm 4mm 0;">
      <strong>Opportunités d'amélioration :</strong> <span class="rich-notes">{{{bmsTopicOpportunities.equipements}}}</span>
    </div>
    {{/if}}
  </div>
</div>
{{/if}}

{{!-- Card 8 — Compteurs : tableau unique groupé PAR ÉNERGIE (comme l'UI),
