<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8" />
<title>{{#if isBacs}}Audit BACS{{else}}Audit GTB{{/if}} — {{#if site.customer_name}}{{site.customer_name}}{{else}}{{document.client_name}}{{/if}} — {{document.project_name}}</title>
<style>{{{styles}}}</style>
</head>
<body>

{{!-- ═══════════ Page de garde — affirmation, verdict en accroche ═══════════ --}}
<section class="cover">
  <header class="cover-top">
    <img class="cover-logo" src="{{logoWhiteDataUrl}}" alt="Buildy" />
    <span class="cover-eyebrow">{{#if isBacs}}Audit de conformité au décret BACS{{else}}Audit GTB · Préparation devis Buildy{{/if}}</span>
  </header>

  <main class="cover-main">
    <h1 class="cover-title">{{document.project_name}}</h1>
    <p class="cover-client">{{#if site.customer_name}}{{site.customer_name}}{{else}}{{document.client_name}}{{/if}}</p>
    {{#if site.address}}<p class="cover-address">{{site.address}}</p>{{/if}}
  </main>

  {{#if compliance.verdict}}
  <div class="cover-verdict cover-verdict-{{compliance.verdict}}">
    <span class="cover-verdict-eyebrow">{{#if isBacs}}État de conformité{{else}}Couverture GTB existante{{/if}}</span>
    <span class="cover-verdict-icon">{{{glyph compliance.verdictIcon "14"}}}</span>
    <span class="cover-verdict-value">{{compliance.verdictLabel}}</span>
    {{#if isBacs}}
      {{#if applicabilityLabel}}
      <span class="cover-verdict-applicability">Applicabilité R175-2 · {{applicabilityLabel}}</span>
      {{/if}}
    {{else}}
      {{#if compliance.coverage}}
      <span class="cover-verdict-applicability">{{compliance.coverage.integrated}} équipements intégrés sur {{compliance.coverage.present}} ({{compliance.coverage.ratio}}%) — préconisations Buildy pour le devis d'extension</span>
      {{/if}}
    {{/if}}
  </div>
  {{/if}}

  <footer class="cover-footer">
    <div class="cover-footer-cell">
      <span class="cover-footer-label">Date du rapport</span>
      <span class="cover-footer-value">{{exportDate}}</span>
    </div>
    <div class="cover-footer-cell">
      <span class="cover-footer-label">Auditeur</span>
      <span class="cover-footer-value">{{authorName}}</span>
    </div>
    <div class="cover-footer-cell">
      <span class="cover-footer-label">Version</span>
      <span class="cover-footer-value cover-footer-version">{{#if versionLabel}}{{versionLabel}}{{else}}{{version}}{{/if}}</span>
    </div>
  </footer>
</section>

{{!-- ═══════════ Table des matieres — page 2 (juste après la cover) ═══════════ --}}
{{!-- Cover + L'essentiel + Tableau de bord conformite sont des pages de
     synthese hors sommaire (frontmatter) — le sommaire ne liste que les
     chapitres numerotés. La TOC vient AVANT L'essentiel pour faciliter la
     navigation rapide dans un livrable de 30+ pages. --}}
<section class="toc">
  <h1>Sommaire</h1>
  <ul class="toc-list">
    {{#if synthesisHtml}}
    <li class="toc-row lvl-1" data-toc-link="synthesis">
      <a href="#synthesis" class="toc-link">
        <span class="toc-num"></span>
        <span class="toc-title">Note de synthèse</span>
        <span class="toc-dots"></span>
        <span class="toc-page">···</span>
      </a>
    </li>
    {{/if}}
    <li class="toc-row lvl-1" data-toc-link="identification">
      <a href="#identification" class="toc-link">
        <span class="toc-num">1</span>
        <span class="toc-title">Identification du site</span>
        <span class="toc-dots"></span>
        <span class="toc-page">···</span>
      </a>
    </li>
    <li class="toc-row lvl-1" data-toc-link="zones">
      <a href="#zones" class="toc-link">
        <span class="toc-num">2</span>
        <span class="toc-title">Zones fonctionnelles{{#if isBacs}} <span class="toc-ref">R175-1 6°</span>{{/if}}</span>
        <span class="toc-dots"></span>
        <span class="toc-page">···</span>
      </a>
    </li>
    <li class="toc-row lvl-1" data-toc-link="systems">
      <a href="#systems" class="toc-link">
        <span class="toc-num">3</span>
        <span class="toc-title">Systèmes techniques par zone{{#if isBacs}} <span class="toc-ref">R175-1 4°</span>{{/if}}</span>
        <span class="toc-dots"></span>
        <span class="toc-page">···</span>
      </a>
    </li>
    <li class="toc-row lvl-1" data-toc-link="meters">
      <a href="#meters" class="toc-link">
        <span class="toc-num">4</span>
        <span class="toc-title">Compteurs et mesurage{{#if isBacs}} <span class="toc-ref">R175-3 1°</span>{{/if}}</span>
        <span class="toc-dots"></span>
        <span class="toc-page">···</span>
      </a>
    </li>
    {{#if isBacs}}
    <li class="toc-row lvl-1" data-toc-link="thermal">
      <a href="#thermal" class="toc-link">
        <span class="toc-num">5</span>
        <span class="toc-title">Régulation automatique du chauffage <span class="toc-ref">R175-6</span></span>
        <span class="toc-dots"></span>
        <span class="toc-page">···</span>
      </a>
    </li>
    {{/if}}
    <li class="toc-row lvl-1" data-toc-link="bms">
      <a href="#bms" class="toc-link">
        <span class="toc-num">{{#if isBacs}}6{{else}}5{{/if}}</span>
        <span class="toc-title">{{#if isBacs}}Solution GTB <span class="toc-ref">R175-3, R175-4, R175-5</span>{{else}}Solution de supervision en place{{/if}}</span>
        <span class="toc-dots"></span>
        <span class="toc-page">···</span>
      </a>
    </li>
    {{#if isBacs}}
    {{#if showInspectionsChapter}}
    <li class="toc-row lvl-1" data-toc-link="inspections">
      <a href="#inspections" class="toc-link">
        <span class="toc-num">7</span>
        <span class="toc-title">Inspections périodiques <span class="toc-ref">R175-5-1</span></span>
        <span class="toc-dots"></span>
        <span class="toc-page">···</span>
      </a>
    </li>
    {{/if}}
    <li class="toc-row lvl-1" data-toc-link="plan">
      <a href="#plan" class="toc-link">
        <span class="toc-num">{{planChapterNumber}}</span>
        <span class="toc-title">Plan de mise en conformité</span>
        <span class="toc-dots"></span>
        <span class="toc-page">···</span>
      </a>
    </li>
    {{!-- Annexes (relecture clarté R2 m2) --}}
    <li class="toc-row lvl-1" data-toc-link="annex-a">
      <a href="#annex-a" class="toc-link">
        <span class="toc-num">A</span>
        <span class="toc-title">Annexe A — Décret BACS (R175-1 à R175-6)</span>
        <span class="toc-dots"></span>
        <span class="toc-page">···</span>
      </a>
    </li>
    <li class="toc-row lvl-1" data-toc-link="annex-b">
      <a href="#annex-b" class="toc-link">
        <span class="toc-num">B</span>
        <span class="toc-title">Annexe B — Méthodologie et hypothèses</span>
        <span class="toc-dots"></span>
        <span class="toc-page">···</span>
      </a>
    </li>
    <li class="toc-row lvl-1" data-toc-link="annex-c">
      <a href="#annex-c" class="toc-link">
        <span class="toc-num">C</span>
        <span class="toc-title">Annexe C — Justification des préconisations</span>
        <span class="toc-dots"></span>
        <span class="toc-page">···</span>
      </a>
    </li>
    <li class="toc-row lvl-1" data-toc-link="annex-d">
      <a href="#annex-d" class="toc-link">
        <span class="toc-num">D</span>
        <span class="toc-title">Annexe D — Mentions légales et avertissements</span>
        <span class="toc-dots"></span>
        <span class="toc-page">···</span>
      </a>
    </li>
    {{#if reportAttachments.length}}
    <li class="toc-row lvl-1" data-toc-link="annex-e">
      <a href="#annex-e" class="toc-link">
        <span class="toc-num">E</span>
        <span class="toc-title">Annexe E — Documents joints</span>
        <span class="toc-dots"></span>
        <span class="toc-page">···</span>
      </a>
    </li>
    {{/if}}
    {{/if}}
  </ul>
  {{!-- Sigles employés dans le rapport (D-45) : lecteur non technicien. --}}
  <div class="toc-glossary">
    <span class="toc-glossary-title">Sigles utilisés</span>
    <p>{{#if isBacs}}<strong>BACS</strong> : système d'automatisation et de contrôle du bâtiment, au sens du décret · {{/if}}<strong>GTB</strong> : gestion technique du bâtiment{{#if isBacs}}, désigne ici le BACS du site{{/if}} · <strong>ECS</strong> : eau chaude sanitaire · <strong>CTA</strong> : centrale de traitement d'air · <strong>DRV</strong> : climatisation à débit de réfrigérant variable · <strong>PAC</strong> : pompe à chaleur · <strong>TRI</strong> : temps de retour sur investissement · <strong>CEE</strong> : certificats d'économies d'énergie · <strong>VMC</strong> : ventilation mécanique contrôlée · <strong>TGBT</strong> : tableau général basse tension · <strong>TD</strong> : tableau divisionnaire · <strong>FCU</strong> : ventilo-convecteur · <strong>HS</strong> : hors service.</p>
  </div>
</section>

{{!-- ═══════════ Page L'essentiel — synthèse en 1 page (page 3) ═══════════ --}}
<section class="essential">
  <header class="essential-header">
    <span class="essential-eyebrow">L'essentiel</span>
    <h1 class="essential-title">Synthèse de l'audit en une page</h1>
  </header>

  <div class="essential-verdict-banner essential-verdict-{{compliance.verdict}}">
    <span class="essential-verdict-icon">{{{glyph compliance.verdictIcon "11"}}}</span>
    <div class="essential-verdict-body">
      <span class="essential-verdict-label">{{#if isBacs}}{{#if compliance.verdictHeadline}}{{compliance.verdictHeadline}}{{else}}{{compliance.verdictLabel}} au décret BACS{{/if}}{{else}}{{compliance.verdictLabel}} de la GTB existante{{/if}}</span>
      <span class="essential-verdict-detail">
        {{#if isBacs}}
          {{compliance.verdictDetail}}
          {{#if compliance.reservesList.length}}
          {{#unless (eq compliance.verdict "compliant_reserves")}}<span class="essential-reserves-lead">Obligations à respecter en outre :</span>{{/unless}}
          <ul class="essential-reserves">{{#each compliance.reservesList}}<li><strong>{{title}}</strong>{{#if article}} ({{article}}){{/if}}</li>{{/each}}</ul>
          {{/if}}
        {{else}}
          {{compliance.coverage.integrated}} équipement{{#unless (eq compliance.coverage.integrated 1)}}s{{/unless}} intégré{{#unless (eq compliance.coverage.integrated 1)}}s{{/unless}} sur {{compliance.coverage.present}} présent{{#unless (eq compliance.coverage.present 1)}}s{{/unless}} ({{compliance.coverage.ratio}} %). {{compliance.stats.total}} préconisations Buildy pour étendre la couverture de la GTB.
        {{/if}}
      </span>
    </div>
  </div>

  {{#if isBacs}}{{#unless compliance.assujettissement.determined}}
  <div class="essential-caveat">
    <span class="essential-caveat-icon">i</span>
    <span>Assujettissement au décret non déterminé : le statut du bâtiment n'a pas pu être établi (puissance ou date de dépôt du permis de construire à confirmer). Le verdict porte sur les écarts constatés et sera confirmé une fois l'assujettissement déterminé.</span>
  </div>
  {{/unless}}{{/if}}

  <div class="essential-grid">
    {{#if isBacs}}
    <div class="essential-applicability">
      <h3 class="essential-block-title">Calcul d'assujettissement R175-2</h3>
      <ol class="applicability-steps">
        <li>
          <span class="step-num">1</span>
          <span class="step-body">
            Puissance retenue (max chaud / froid) : <strong>{{frNum compliance.assujettissement.powerKw}} kW</strong>
            {{#if powerSummary}}
            <span class="power-breakdown">
              chaud cumulé {{frNum powerSummary.heatKw}} kW · froid cumulé {{frNum powerSummary.coolKw}} kW
              {{#if (eq powerSummary.source "auto")}} · calcul automatique{{else}} · valeur déclarée{{/if}}
            </span>
            {{#if powerSummary.discrepancy}}
            <span class="power-discrepancy">{{{faIcon "triangle-exclamation" "#ea580c" "9"}}} La valeur déclarée ({{frNum powerSummary.manualKw}} kW) est retenue ; elle s'écarte de {{powerSummary.discrepancyPct}} % du cumul calculé à partir des équipements relevés ({{frNum powerSummary.autoKw}} kW).</span>
            {{/if}}
            {{#if powerSummary.incompletePowerNote}}
            <span class="power-discrepancy">{{{faIcon "triangle-exclamation" "#ea580c" "9"}}} {{powerSummary.incompletePowerNote}}</span>
            {{/if}}
            {{/if}}
          </span>
        </li>
        {{#if compliance.assujettissement.pcDateLabel}}
        <li>
          <span class="step-num">2</span>
          <span class="step-body">Date du permis de construire : <strong>{{compliance.assujettissement.pcDateLabel}}</strong></span>
        </li>
        {{/if}}
        <li>
          <span class="step-num">{{#if compliance.assujettissement.pcDateLabel}}3{{else}}2{{/if}}</span>
          <span class="step-body">Seuil applicable : <strong>{{compliance.assujettissement.thresholdLabel}}</strong> {{{glyph "→" "10"}}} {{compliance.assujettissement.conclusion}}</span>
        </li>
      </ol>
    </div>
    {{else}}
    <div class="essential-applicability">
      <h3 class="essential-block-title">Couverture GTB existante</h3>
      <ol class="applicability-steps">
        <li>
          <span class="step-num">1</span>
          <span class="step-body">GTB déployée : <strong>{{bms.existing_solution}}</strong>{{#if bms.existing_solution_brand}} ({{bms.existing_solution_brand}}){{/if}}</span>
        </li>
        <li>
          <span class="step-num">2</span>
          <span class="step-body">Équipements supervisés : <strong>{{compliance.coverage.integrated}} sur {{compliance.coverage.present}}</strong> ({{compliance.coverage.ratio}} %)</span>
        </li>
        <li>
          <span class="step-num">3</span>
          <span class="step-body">Verdict Buildy : <strong>{{compliance.verdictLabel}}</strong> — extension recommandée pour couvrir l'ensemble du périmètre fonctionnel.</span>
        </li>
      </ol>
    </div>
    {{/if}}

    <div class="essential-stats">
      <h3 class="essential-block-title">{{#if isBacs}}Plan d'action en chiffres{{else}}Préconisations Buildy{{/if}}</h3>
      <div class="stats-grid{{#if compliance.stats.reserves}} stats-grid-4{{/if}}">
        <div class="stat stat-blocking{{#unless compliance.stats.blocking}} stat-zero{{/unless}}">
          <div class="stat-num">{{compliance.stats.blocking}}</div>
          <div class="stat-label">{{#if isBacs}}Bloquante{{#unless (eq compliance.stats.blocking 1)}}s{{/unless}}{{else}}Essentielle{{#unless (eq compliance.stats.blocking 1)}}s{{/unless}}{{/if}}</div>
        </div>
        <div class="stat stat-major{{#unless compliance.stats.major}} stat-zero{{/unless}}">
          <div class="stat-num">{{compliance.stats.major}}</div>
          <div class="stat-label">{{#if isBacs}}Majeure{{#unless (eq compliance.stats.major 1)}}s{{/unless}}{{else}}Recommandée{{#unless (eq compliance.stats.major 1)}}s{{/unless}}{{/if}}</div>
        </div>
        <div class="stat stat-minor{{#unless compliance.stats.minor}} stat-zero{{/unless}}">
          <div class="stat-num">{{compliance.stats.minor}}</div>
          <div class="stat-label">{{#if isBacs}}Mineure{{#unless (eq compliance.stats.minor 1)}}s{{/unless}}{{else}}Optimisation{{#unless (eq compliance.stats.minor 1)}}s{{/unless}}{{/if}}</div>
        </div>
        {{#if compliance.stats.reserves}}
        <div class="stat stat-reserve">
          <div class="stat-num">{{compliance.stats.reserves}}</div>
          <div class="stat-label">Réserve{{#unless (eq compliance.stats.reserves 1)}}s{{/unless}}</div>
        </div>
        {{/if}}
      </div>
    </div>
  </div>

  {{!-- Actions prioritaires : les 3 premières actions du plan (bloquantes,
       puis majeures, puis mineures), nommées dès la page 3 (charte : « actions
       phares ») — relecture PDF 2026-09-24. --}}
  {{#if isBacs}}{{#if compliance.headlineActions.length}}
  {{!-- Une ligne par action (numéro · intitulé · niveau · article) : la
       page « L'essentiel » doit tenir sur une seule page. --}}
  <div class="essential-headlines">
    <h3 class="essential-block-title essential-block-title-split">Actions prioritaires<span class="essential-block-aside">Plan complet au chapitre {{planChapterNumber}}</span></h3>
    <ol class="headlines-list">
      {{#each compliance.headlineActions}}
      <li class="headline">
        <span class="headline-num">{{display_number}}</span>
        <span class="headline-title">{{#if title_plain}}{{title_plain}}{{else}}{{{title}}}{{/if}}</span>
        <span class="headline-meta"><span class="sev sev-{{severity}}">{{#if (eq severity "blocking")}}Bloquante{{else if (eq severity "major")}}Majeure{{else}}Mineure{{/if}}</span>{{#if r175_article}}<span class="r175-tag">{{r175_article}}</span>{{/if}}</span>
      </li>
      {{/each}}
    </ol>
  </div>
  {{/if}}{{/if}}

  {{!-- Points à qualifier : informations manquantes qui conditionnent le
       verdict (relecture clarté R2 m31). --}}
  {{#if isBacs}}{{#if pointsToQualify.length}}
  <div class="callout callout-info essential-to-qualify">
    <span class="callout-icon">{{{faIcon "circle-question" "#1b2842" "14"}}}</span>
    <div class="callout-body">
      <strong>Points à qualifier.</strong> Ces informations n'ont pas été communiquées lors de l'audit ; elles peuvent modifier le verdict des exigences concernées.
      <ul class="essential-reserves">{{#each pointsToQualify}}<li>{{this}}</li>{{/each}}</ul>
    </div>
  </div>
  {{/if}}{{/if}}

  {{!-- Notes de contexte (structure juridique, décret tertiaire) : côte à
       côte quand les deux sont présentes, pour tenir sur la page. --}}
  {{#if (or ownershipStructureLabel tertiaryDecreeApplies)}}
  <div class="essential-notes">
  {{!-- Item 4a — Structure juridique du site (assujettissement) --}}
  {{#if ownershipStructureLabel}}
  <div class="callout callout-info essential-ownership">
    <span class="callout-icon">{{{faIcon "scale-balanced" "#6b7280" "14"}}}</span>
    <div class="callout-body">
      <strong>Structure juridique : {{ownershipStructureLabel}}.</strong>
      La personne assujettie au décret BACS (propriétaire du système de chauffage ou de climatisation) est déterminée système par système selon cette structure (chapitre 3).
      {{#if ownershipNotes}} {{ownershipNotes}}{{/if}}
    </div>
  </div>
  {{/if}}

  {{!-- Item 12 — Pont avec le décret tertiaire (bâtiment > 1000 m²) --}}
  {{#if tertiaryDecreeApplies}}
  <div class="callout callout-info essential-tertiary">
    <span class="callout-icon">{{{faIcon "link" "#6b7280" "14"}}}</span>
    <div class="callout-body">
      <strong>Décret tertiaire.</strong> La surface déclarée dépasse 1 000 m² : le site relève probablement aussi du dispositif Éco Énergie Tertiaire, à confirmer selon la surface consacrée aux activités tertiaires. Les comptages et le suivi énergétique mis en place au titre du décret BACS peuvent alors alimenter les déclarations sur la plateforme OPERAT.
    </div>
  </div>
  {{/if}}
  </div>
  {{/if}}

  {{!-- Item 13 — Bandeau « Consommations de référence » (factures client) --}}
  {{#if energyReference}}
  <div class="energy-reference">
    <h3 class="essential-block-title">Consommations de référence — année {{energyReference.referenceYear}}</h3>
    <div class="energy-ref-cards">
      {{#each energyReference.energies}}
      <div class="energy-ref-card">
        <div class="energy-ref-card-label">{{label}}</div>
        <div class="energy-ref-card-value">{{totalQuantityFmt}} <span class="energy-ref-card-unit">{{unit}}</span></div>
        <div class="energy-ref-card-meta">
          {{#if ratioPerM2Fmt}}{{ratioPerM2Fmt}} {{unit}}/m²{{/if}}
          {{#if totalCostFmt}}{{#if ratioPerM2Fmt}} · {{/if}}{{totalCostFmt}} € sur l'année{{/if}}
        </div>
      </div>
      {{/each}}
    </div>
    {{#if energyMonthlyChartDataUrl}}
    <div class="energy-ref-chart">
      <img src="{{energyMonthlyChartDataUrl}}" alt="Répartition mensuelle des consommations" />
    </div>
    {{/if}}
    <p class="energy-ref-footnote">
      Base de référence saisie depuis les factures fournies par le client / les preneurs.
      Cette base de référence permettra de mesurer les économies réelles après mise en place du BACS.
    </p>
  </div>
  {{/if}}
</section>

{{!-- ═══════════ Tableau de bord conformité R175 (après sommaire) ═══════════ --}}
{{#if isBacs}}
<section class="r175-dashboard">
  <header class="dashboard-header">
    <span class="dashboard-eyebrow">Tableau de bord</span>
    <h1 class="dashboard-title">Conformité par exigence du décret BACS</h1>
    <p class="dashboard-intro">
      Pour chaque exigence du décret : <strong>ce que le décret exige</strong> (au centre)
      et <strong>la situation constatée sur le site</strong> (verdict à droite).
    </p>
  </header>

  {{!-- Têtière unique (au lieu d'un sur-titre répété sur chaque ligne) :
       le tableau de bord tient sur une page (relecture PDF 2026-09-24). --}}
  {{#if r175DashboardCommonNote}}
  <p class="dashboard-common-note"><strong>Constat sur le site pour les exigences {{r175DashboardCommonNote.codes}} :</strong> {{r175DashboardCommonNote.text}}</p>
  {{/if}}
  <div class="r175-rows-head">
    <span>Article</span>
    <span>Ce que le décret exige</span>
    <span>Situation constatée</span>
  </div>
  <ul class="r175-rows">
    {{#each compliance.r175Dashboard}}
    <li class="r175-row r175-row-{{verdict}}">
      <span class="r175-row-code">{{#if displayCode}}{{displayCode}}{{else}}{{code}}{{/if}}</span>
      <div class="r175-row-content">
        <div class="r175-row-label">{{label}}{{#if source_url}}<a class="r175-row-legifrance" href="{{source_url}}">Légifrance {{{faIcon "arrow-up-right-from-square" "#4f628c" "7"}}}</a>{{/if}}</div>
        <div class="r175-row-summary">{{summary}}</div>
        {{#if note}}{{#unless noteShared}}<div class="r175-row-summary r175-row-note"><strong>Constat sur le site :</strong> {{note}}</div>{{/unless}}{{/if}}
      </div>
      <div class="r175-row-status">
        <span class="r175-row-verdict r175-row-verdict-{{verdict}}">
          <span class="r175-row-verdict-icon">{{{glyph verdictIcon "9"}}}</span>
          {{verdictLabel}}
        </span>
        <span class="r175-row-actions{{#unless actionsCount}} r175-row-actions-empty{{/unless}}">
          {{#if actionsCount}}{{#if (eq actionsReserves actionsCount)}}{{actionsCount}} réserve{{#unless (eq actionsCount 1)}}s{{/unless}}{{else}}{{actionsCount}} action{{#unless (eq actionsCount 1)}}s{{/unless}}{{/if}}{{else if seeActionNumber}}voir {{seeActionNumber}}{{else}}—{{/if}}
        </span>
      </div>
    </li>
    {{/each}}
  </ul>

  <p class="dashboard-footnote">
    Détail des actions correctives et préconisations Buildy : chapitre {{planChapterNumber}} « Plan de mise en conformité ».
  </p>
</section>
{{/if}}

<div class="sections">

{{#if synthesisHtml}}
{{!-- ═══════════ Synthèse executive ═══════════ --}}
<h1 class="chapter" data-toc-anchor="synthesis">{{{faIcon "sparkles" "#1b2842" "16"}}} <span class="chapter-text">Note de synthèse</span></h1>
{{#if synthesisDateFr}}<p class="synthesis-date">Note rédigée le {{synthesisDateFr}}.</p>{{/if}}
<div class="synthesis-block">{{{synthesisHtml}}}</div>
{{/if}}

{{!-- L'ancienne section « Synthèse de conformité » à l'intérieur de
     .sections est remplacée par la page « L'essentiel » + le tableau de
     bord conformité R175 placés AVANT .sections (cf. en-tête du document). --}}

{{!-- ═══════════ Chapitre 1 — Identification site ═══════════ --}}
<h1 class="chapter" data-toc-anchor="identification">{{{faIcon "building" "#1b2842" "16"}}} <span class="chapter-text">1. Identification du site</span></h1>

<div class="info-cards">
  <div class="info-card">
    <span class="info-card-label">Site</span>
    <span class="info-card-value">{{site.name}}</span>
  </div>
  <div class="info-card">
    <span class="info-card-label">Client</span>
    <span class="info-card-value">{{#if site.customer_name}}{{site.customer_name}}{{else}}{{document.client_name}}{{/if}}</span>
  </div>
  {{#if site.address}}
  <div class="info-card info-card-wide">
    <span class="info-card-label">Adresse</span>
    <span class="info-card-value">{{site.address}}</span>
  </div>
  {{/if}}
  {{#if site.coords_label}}
  <div class="info-card">
    <span class="info-card-label">Coordonnées GPS</span>
    <span class="info-card-value">{{site.coords_label}}</span>
  </div>
  {{/if}}
  {{#if isBacs}}
    {{#if document.bacs_total_power_kw}}
    <div class="info-card info-card-accent">
      <span class="info-card-label">Puissance retenue R175-2 <span class="info-card-label-hint">(max. chaud / froid)</span></span>
      <span class="info-card-value info-card-value-strong">{{#if powerSummary}}{{frNum powerSummary.effectiveKw}}{{else}}{{frNum document.bacs_total_power_kw}}{{/if}} kW</span>
    </div>
    {{/if}}
    {{#if document.bacs_district_heating_substation_kw}}
    <div class="info-card info-card-accent">
      <span class="info-card-label">Station d'échange (réseau urbain)</span>
      <span class="info-card-value info-card-value-strong">{{frNum document.bacs_district_heating_substation_kw}} kW</span>
      <span class="info-card-note">Référence R175-2</span>
    </div>
    {{/if}}
    {{#if document.bacs_building_permit_date}}
    <div class="info-card">
      <span class="info-card-label">Permis de construire</span>
      <span class="info-card-value">{{frDate document.bacs_building_permit_date}}</span>
    </div>
    {{/if}}
    {{#if applicabilityLabel}}
    <div class="info-card info-card-wide info-card-accent">
      <span class="info-card-label">Applicabilité BACS (R175-2)</span>
      <span class="info-card-value info-card-value-strong">{{applicabilityLabel}}</span>
    </div>
    {{/if}}
  {{/if}}
</div>

{{!-- Item 4/5 — Structure juridique & parties prenantes du site --}}
{{#if siteParties.length}}
<div class="panel">
  <div class="panel-head">
    <h3 class="panel-title">Structure juridique et parties prenantes</h3>
    {{#if ownershipStructureLabel}}
    <p class="panel-subtitle">Structure de propriété / occupation : <strong>{{ownershipStructureLabel}}</strong>. La personne assujettie au décret BACS (propriétaire du système de chauffage ou de climatisation) est déterminée système par système (chapitre 3).</p>
    {{/if}}
  </div>
  <div class="panel-body">
    <table>
      <thead>
        <tr><th>Partie prenante</th><th>Rôle</th><th>Contact</th><th>Zones rattachées</th></tr>
      </thead>
      <tbody>
        {{#each siteParties}}
        <tr>
          <td><strong>{{name}}</strong></td>
          <td>{{kindLabel}}</td>
          <td>{{#if contact_email}}<a href="mailto:{{contact_email}}">{{contact_email}}</a>{{else}}<span class="muted">—</span>{{/if}}</td>
          <td>{{#if zoneNames.length}}{{#each zoneNames}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}{{else}}<span class="muted">—</span>{{/if}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</div>
{{/if}}

{{!-- Vue satellite du site : seulement sans carte des zones (chapitre 2),
     qui montre le même site avec les repères de zones (pas deux vues du
     même site à deux pages d'intervalle). --}}
{{#if siteMapDataUrl}}{{#unless zonesMap}}
<div class="map-figure map-figure-full">
  <img src="{{siteMapDataUrl}}" alt="Vue satellite du site" />
  <p class="map-figure-caption">Vue satellite du site — repère du bâtiment principal.</p>
</div>
{{/unless}}{{/if}}

{{#if isBacs}}{{#if heatingCoolingBreakdown.length}}
<div class="panel">
  <div class="panel-head">
    <h3 class="panel-title">Détail du calcul automatique de la puissance R175-2</h3>
    <p class="panel-subtitle">
      Cumul des puissances nominales utiles chaud et froid des équipements relevés au chapitre 3.
      Certains équipements relevés sont <strong>hors cumul R175-2</strong> — la raison
      est indiquée sur leur ligne « Pris en compte ». Cas courant : un <strong>émetteur</strong>
      alimenté en eau chaude ou glacée (radiateur à eau, aérotherme à eau, ventilo-convecteur)
      dont la puissance est déjà comptée sur son <strong>générateur</strong> — l'additionner ferait
      un double comptage ; les radiateurs électriques et les aérothermes à gaz, qui produisent
      eux-mêmes la chaleur, sont comptés. Sont aussi exclus les équipements de secours (FAQ BACS
      n° 8), les usages autres que le chauffage et la climatisation, et l'aval d'un réseau de chaleur.
      La puissance retenue est le <strong>maximum</strong> entre le cumul chaud et le cumul froid
      (jamais leur somme, FAQ BACS n° 11).
    </p>
  </div>
  <div class="panel-body">
    {{!-- Largeurs fixes : les colonnes Zone et Équipement ne sont plus
         écrasées par la colonne des puissances (relecture PDF 2026-09-24). --}}
    <table class="power-calc-table">
      <colgroup>
        <col style="width:19%"><col style="width:16%"><col style="width:16%"><col style="width:14%"><col style="width:17%"><col style="width:18%">
      </colgroup>
      <thead>
        <tr>
          <th>Équipement</th>
          <th>Marque / référence</th>
          <th>Catégorie</th>
          <th>Zone</th>
          <th>Puissance nominale</th>
          <th>Pris en compte</th>
        </tr>
      </thead>
      <tbody>
        {{#each heatingCoolingBreakdown}}
          <tr>
            <td>{{name}}</td>
            <td class="wrap-anywhere">{{brand}}{{#if model_reference}} / {{model_reference}}{{/if}}</td>
            <td>{{categoryLabel}}{{#if sharedWithLabel}}<br><span class="muted" style="font-size:6.5pt">dessert aussi : {{sharedWithLabel}}</span>{{/if}}</td>
            <td>{{zone_name}}</td>
            <td style="text-align:right">{{#if power_kw}}<span class="nowrap">{{#if has_multiple}}{{frNum total_power_kw}}{{else}}{{frNum power_kw}}{{/if}} kW{{#if power_kw_cooling}} chaud{{/if}}</span>{{#if has_multiple}} <span class="muted nowrap">({{quantity}} × {{frNum power_kw}} kW)</span>{{/if}}{{/if}}{{#if power_kw_cooling}}{{#if power_kw}}<br>{{/if}}<span class="nowrap">{{#if has_multiple}}{{frNum total_power_kw_cooling}}{{else}}{{frNum power_kw_cooling}}{{/if}} kW froid</span>{{#if has_multiple}} <span class="muted nowrap">({{quantity}} × {{frNum power_kw_cooling}} kW)</span>{{/if}}{{/if}}{{#if power_missing}}Non renseignée{{#if has_multiple}} <span class="muted nowrap">({{quantity}} unités)</span>{{/if}}{{/if}}</td>
            <td style="text-align:right">
              {{#if power_missing}}
                <span class="muted">Non comptée</span><br><span class="muted" style="font-size:6.5pt">puissance à relever</span>
              {{else if in_scope}}
                {{#if heat_contrib}}<span class="nowrap"><strong>+{{frNum heat_contrib}} kW</strong> chaud</span>{{/if}}
                {{#if cool_contrib}}{{#if heat_contrib}}<br>{{/if}}<span class="nowrap"><strong>+{{frNum cool_contrib}} kW</strong> froid</span>{{/if}}
                {{#unless heat_contrib}}{{#unless cool_contrib}}<span class="muted">0 kW</span>{{/unless}}{{/unless}}
              {{else}}
                <span class="muted">Hors cumul</span>{{#if exclusion_reason_label}}<br><span class="muted" style="font-size:6.5pt">{{exclusion_reason_label}}</span>{{/if}}
              {{/if}}
            </td>
          </tr>
        {{/each}}
        <tr class="total-row">
          <td colspan="5" style="text-align:right"><strong>Cumul chaud retenu</strong></td>
          <td style="text-align:right"><strong>{{frNum powerRecap.heatRetained}} kW</strong></td>
        </tr>
        <tr class="total-row">
          <td colspan="5" style="text-align:right"><strong>Cumul froid retenu</strong></td>
          <td style="text-align:right"><strong>{{frNum powerRecap.coolRetained}} kW</strong></td>
        </tr>
        <tr class="total-row" style="background:#f1f5f9">
          <td colspan="5" style="text-align:right"><strong>Puissance retenue R175-2 (max chaud / froid)</strong></td>
          <td style="text-align:right"><strong style="color:#1b2842">{{frNum powerRecap.retained}} kW</strong></td>
        </tr>
      </tbody>
    </table>
    {{#if powerSummary.incompletePowerNote}}
    <p class="power-incomplete-note">{{powerSummary.incompletePowerNote}}</p>
    {{/if}}
  </div>
</div>
{{/if}}{{/if}}

{{!-- Graphique « Répartition de la puissance par usage » retiré (relecture
     PDF 2026-09-24) : puissances brutes, en contradiction avec la puissance
     retenue du tableau ci-dessus. --}}

{{!-- ═══════════ Chapitre 2 — Zones fonctionnelles ═══════════ --}}
<h1 class="chapter" data-toc-anchor="zones">{{{faIcon "map-pin" "#1b2842" "16"}}} <span class="chapter-text">2. Zones fonctionnelles{{#if isBacs}} (R175-1 6°){{/if}}</span></h1>

{{!-- Vue satellite annotée avec les pins de zones — affichée uniquement
     si au moins une zone fonctionnelle a des coordonnées GPS. --}}
{{#if zonesMap}}
<div class="map-figure map-figure-full">
  <img src="{{zonesMap.dataUrl}}" alt="Vue satellite des zones fonctionnelles" />
  <div class="map-legend">
    {{#each zonesMap.legend}}
      <span class="map-legend-item">
        <span class="map-legend-pin" style="background:{{color}}">{{initial}}</span>
        <span class="map-legend-name">{{name}}</span>
      </span>
    {{/each}}
  </div>
  <p class="map-figure-caption">Vue satellite des zones fonctionnelles — chaque repère renvoie à une zone listée ci-dessous.</p>
</div>
{{/if}}

{{#if zones.length}}
{{!-- ── Bloc 1 — Inventaire des zones fonctionnelles BACS ──
     Espaces de vie/usage homogènes au sens R175-1 6°. --}}
{{#if zonesFunctional.length}}
<h2 class="subheading">Inventaire des zones fonctionnelles</h2>
<table>
  <thead><tr><th>Zone</th><th>Nature</th><th>Régime d'activité</th><th>Surface <span class="unit-nocase">(m²)</span></th></tr></thead>
  <tbody>
    {{#each zonesFunctional}}
      <tr><td><span class="zone-name-cell">{{#if mapInitial}}<span class="map-legend-pin map-legend-pin-inline" style="background:{{mapColor}}">{{mapInitial}}</span>{{/if}}<span>{{name}}</span></span></td><td>{{natureLabel}}</td><td>{{#if occupancyLabel}}{{occupancyLabel}}{{else}}<span class="muted">—</span>{{/if}}</td><td>{{#if surface_m2}}{{frNum surface_m2}}{{else}}<span class="muted">—</span>{{/if}}</td></tr>
    {{/each}}
  </tbody>
</table>
{{!-- Notes terrain par zone (uniquement si au moins une zone a une note
     ou photo). Regroupées sous un sous-titre dédié pour que les blocs
     individuels n'apparaissent pas hors contexte. --}}
{{#if zonesFunctionalHaveNotes}}
<h3 class="subheading-3">Notes terrain par zone</h3>
{{#each zonesFunctional}}
  {{#if (or notes_html notes photos.length comfort_constraint)}}
    <div class="entity-block">
      <h4>{{name}}</h4>
      {{#if comfort_constraint}}
        <p class="muted" style="margin-bottom:1.5mm"><strong>Contrainte de confort :</strong> {{comfort_constraint_display}}</p>
      {{/if}}
      {{#if notes_html}}<div class="rich-notes">{{{notes_html}}}</div>
      {{else}}{{#if notes}}<p>{{notes}}</p>{{/if}}{{/if}}
      {{#if photos.length}}
        <div class="photo-grid">
          {{#each photos}}<img src="{{dataUrl}}" alt="" />{{/each}}
        </div>
      {{/if}}
    </div>
  {{/if}}
{{/each}}
{{/if}}
{{/if}}

{{!-- ── Bloc 2 — Locaux techniques (hors périmètre R175-1 6°) ──
     Tableaux électriques, locaux compteurs : inventoriés pour rattacher
     les organes de mesure / coupure à un emplacement physique. --}}
{{#if zonesTechnical.length}}
<h2 class="subheading">Locaux techniques</h2>
<div class="callout callout-info">
  <span class="callout-icon">{{{faIcon "thumbtack" "#6b7280" "14"}}}</span>
  <div class="callout-body">Les locaux techniques (tableaux électriques, locaux de comptage, chaufferies…) ne sont <strong>pas retenus comme zones fonctionnelles dans cet audit</strong> (méthode Buildy, annexe B). Ils sont listés ici pour situer les compteurs et les organes de coupure ; les équipements qu'ils abritent restent dans le champ du décret.</div>
</div>
<table>
  <thead><tr><th>Local</th><th>Nature</th><th>Surface <span class="unit-nocase">(m²)</span></th></tr></thead>
  <tbody>
    {{#each zonesTechnical}}
      <tr><td>{{name}}</td><td>{{natureLabel}}</td><td>{{#if surface_m2}}{{frNum surface_m2}}{{else}}<span class="muted">—</span>{{/if}}</td></tr>
    {{/each}}
  </tbody>
</table>
{{#if zonesTechnicalHaveNotes}}
<h3 class="subheading-3">Notes terrain par local technique</h3>
{{#each zonesTechnical}}
  {{#if (or notes_html notes photos.length)}}
    <div class="entity-block">
      <h4>{{name}}</h4>
      {{#if notes_html}}<div class="rich-notes">{{{notes_html}}}</div>
      {{else}}{{#if notes}}<p>{{notes}}</p>{{/if}}{{/if}}
      {{#if photos.length}}
        <div class="photo-grid">
          {{#each photos}}<img src="{{dataUrl}}" alt="" />{{/each}}
        </div>
      {{/if}}
    </div>
  {{/if}}
{{/each}}
{{/if}}
{{/if}}

{{!-- ── Bloc 3 — Regroupement R175 par usage technique ──
     Items 7d/7e : zones d'usage regroupées en "zones fonctionnelles de
     suivi" lorsqu'un équipement partagé empêche le comptage séparé. --}}
{{#if functionalZones.mergedCount}}
<h2 class="subheading">Regroupement par usage technique</h2>
<div class="callout callout-info">
  <span class="callout-icon">{{{faIcon "thumbtack" "#6b7280" "14"}}}</span>
  <div class="callout-body">Le décret définit la zone fonctionnelle comme « toute zone dans laquelle les usages sont homogènes » (R175-1 6°). Lorsque des espaces sont desservis par un même équipement sans comptage séparable, ils sont regroupés en une seule zone de suivi ; le découpage peut varier selon le système technique (FAQ BACS n° 25).</div>
</div>
{{#each functionalZones.byCategory}}
  {{#if (gt functional_zone_count 0)}}
  <div class="entity-block">
    <h3 class="fz-heading">{{{categoryIcon category "14"}}} <span>{{categoryLabel}} — {{physical_zone_count}} zone{{#unless (eq physical_zone_count 1)}}s{{/unless}} d'usage {{{glyph "→" "12"}}} {{functional_zone_count}} zone{{#unless (eq functional_zone_count 1)}}s{{/unless}} fonctionnelle{{#unless (eq functional_zone_count 1)}}s{{/unless}} de suivi</span></h3>
    <ul class="method-list">
      {{#each groups}}
        <li>
          <strong>{{label}}</strong>
          {{#if merged}} — {{justification}}{{#if separateMetersPresent}} Des compteurs séparés sont toutefois présents dans plusieurs de ces zones : regroupement à confirmer.{{/if}}{{/if}}
        </li>
      {{/each}}
    </ul>
  </div>
  {{/if}}
{{/each}}
{{/if}}
{{else}}
<p class="muted">Aucune zone définie.</p>
{{/if}}

{{!-- ═══════════ Chapitre 3 — Systèmes techniques ═══════════ --}}
<h1 class="chapter" data-toc-anchor="systems">{{{faIcon "wrench" "#1b2842" "16"}}} <span class="chapter-text">3. Systèmes techniques par zone{{#if isBacs}} (R175-1 4°){{/if}}</span></h1>
{{!-- Zones fonctionnelles sans système thermique présent : hors
     périmètre R175-2 (pas de chauffage / climatisation / ECS). Listées
     ici pour clarifier pourquoi elles n'apparaissent pas dans
     l'inventaire ci-dessous. --}}
{{#if isBacs}}{{#if hasLiabilityData}}{{#if defaultLiability}}
{{!-- Même gabarit que les autres encadrés d'ouverture du chapitre (taille,
     retrait) ; icône propre (personne assujettie ≠ balance du TRI). --}}
<div class="callout callout-info">
  <span class="callout-icon">{{{faIcon "user-tie" "#1b2842" "14"}}}</span>
  <div class="callout-body">
    <strong>Sauf mention contraire sur un système — {{defaultLiability.label}}.</strong>{{#if defaultLiability.generalExplanation}} {{defaultLiability.generalExplanation}}{{/if}}
  </div>
</div>
{{/if}}{{/if}}{{/if}}
{{#if hasConditionalSystems}}
<div class="callout callout-info">
  <span class="callout-icon">{{{faIcon "scale-balanced" "#1b2842" "14"}}}</span>
  <div class="callout-body">
    <strong>Systèmes raccordés sous condition.</strong> Dans un bâtiment existant, le raccordement à la GTB de certains systèmes n'est exigé que s'il est réalisable avec un temps de retour sur investissement inférieur à dix ans, déduction faite des aides financières publiques (R175-2 II). Ces systèmes sont signalés ci-dessous ; leurs écarts figurent au plan d'actions en actions mineures, avec cette condition d'application.
  </div>
</div>
{{/if}}
{{#if zonesOutOfBacsScope.length}}
<div class="callout callout-info">
  <span class="callout-icon">{{{faIcon "thumbtack" "#6b7280" "14"}}}</span>
  <div class="callout-body">
    <strong>Zones sans système technique relevé :</strong> aucun système de
    chauffage, de climatisation, d'eau chaude sanitaire, de ventilation, d'éclairage
    ou de production d'énergie n'a été relevé dans
    {{#each zonesOutOfBacsScope}}<strong>{{name}}</strong>{{#unless @last}}, {{/unless}}{{/each}}.
  </div>
</div>
{{/if}}
{{#each systemsByZone}}
{{!-- Zone dont tous les usages sont déclarés absents : déjà citée dans
     l'encadré ci-dessus, pas de liste « Absent » répétée (R2 M6). --}}
{{#unless allAbsent}}
<h2 class="zone-heading">{{zone_name}}</h2>
{{!-- Usages non présents : une seule ligne sous le titre de zone (plus de
     boîte « Absent » par usage — relecture PDF 2026-09-24). --}}
{{#if (or absentLabels.length unansweredLabels.length)}}
<p class="zone-absent-line">
  {{#if absentLabels.length}}<span class="zone-absent-group"><span class="zone-absent-label">Usage{{#unless (eq absentLabels.length 1)}}s{{/unless}} absent{{#unless (eq absentLabels.length 1)}}s{{/unless}} :</span>{{#each absentLabels}}<span class="zone-absent-item">{{{categoryIcon system_category "10"}}}&nbsp;{{categoryLabel}}</span>{{/each}}</span>{{/if}}
  {{#if unansweredLabels.length}}<span class="zone-absent-group"><span class="zone-absent-label">Présence non renseignée :</span>{{#each unansweredLabels}}<span class="zone-absent-item">{{{categoryIcon system_category "10"}}}&nbsp;{{categoryLabel}}</span>{{/each}}</span>{{/if}}
</p>
{{/if}}
{{#each items}}
  {{#if present}}
    <div class="system-card system-card-{{system_category}}">
      <div class="system-card-head">
        {{{categoryIcon system_category "16"}}}
        <span class="system-card-label">{{displayLabel}}</span>
        {{#if power_differs}}
          <span class="system-card-power">{{#if retained_power_kw}}{{frNum retained_power_kw}} kW retenus{{else}}Hors cumul{{/if}} <span class="muted">({{frNum total_power_kw}} kW installés)</span></span>
        {{else if display_power_kw}}
          <span class="system-card-power">{{frNum display_power_kw}} kW</span>
        {{/if}}
        {{#if serves_multiple_buildings}}<span class="system-card-flag" title="Système desservant plusieurs bâtiments du site — cas F d'assujettissement (R175-2 §I)">Multi-bâtiments</span>{{/if}}
        {{#if is_district_heating_substation}}<span class="system-card-flag" title="Sous-station de réseau de chaleur urbain — cas E d'assujettissement (R175-2 §I)">Sous-station RDU</span>{{/if}}
        {{#if managed_by_bms}}<span class="system-card-flag system-card-flag-bms" title="Système géré par la GTB">Géré par GTB</span>{{/if}}
        {{#if (eq is_looped "looped")}}<span class="system-card-flag" title="Boucle d'eau chaude sanitaire — point de vigilance sanitaire (légionelles)">Bouclée</span>{{/if}}
        {{#if (eq is_looped "not_looped")}}<span class="system-card-flag system-card-flag-muted" title="Production ECS sans boucle">Sans boucle</span>{{/if}}
        {{!-- Nombre d'équipements en dernier, calé à droite : en cas de
             repli sur deux lignes, les pastilles suivent le titre. --}}
        <span class="system-card-count">{{#if device_count}}{{device_count}} équipement{{#unless (eq device_count 1)}}s{{/unless}}{{#if shared_device_count}} dont {{shared_device_count}} partagé{{#unless (eq shared_device_count 1)}}s{{/unless}}{{/if}}{{else}}Équipements non détaillés{{/if}}</span>
      </div>
      <div class="system-card-body">
        {{!-- Verdict de conformité R175-3 par système : permet au lecteur
             du PDF (MOA, BE, bureau de contrôle) de comprendre en 1 coup
             d'œil pourquoi ce système est conforme ou non, sans avoir à
             croiser les pilules de chaque équipement. --}}
        {{#if compliance}}
        <div class="system-compliance system-compliance-{{compliance.verdict}}">
          <span class="system-compliance-badge">{{compliance.label}}</span>
          {{#if compliance.reasons.length}}
            <ul class="system-compliance-reasons">
              {{#each compliance.reasons}}<li>{{this}}</li>{{/each}}
            </ul>
          {{/if}}
        </div>
        {{/if}}
        {{!-- Item 3 — Avertissement légionelles pour les ECS bouclées --}}
        {{#if (and (eq system_category "dhw") (eq is_looped "looped"))}}
        <div class="callout callout-warning system-callout">
          <span class="callout-icon">{{{faIcon "triangle-exclamation" "#ea580c" "14"}}}</span>
          <div class="callout-body">
            <strong>Eau chaude sanitaire bouclée — point de vigilance sanitaire.</strong> En période d'occupation, et dans les 24 heures qui précèdent l'utilisation, les températures de production et de distribution fixées par l'arrêté du 30 novembre 2005 doivent être respectées (risque lié aux légionelles). Un arrêt n'est envisageable que pendant une inoccupation de plusieurs semaines, suivi d'une remise en service selon les recommandations sanitaires. Les commandes d'arrêt ou de réduction pilotées par la GTB en tiennent compte (guide PROFEEL, non opposable).
          </div>
        </div>
        {{/if}}
        {{!-- Item 1 — Encart d'exemption pour un poste marqué négligeable (< 5 %) --}}
        {{#if marked_negligible_under_5pct}}
        {{!-- Note sans cadre : le verdict du système (encadré au-dessus) dit
             déjà l'exemption ; ici, la règle (relecture PDF 2026-09-24). --}}
        <div class="system-rule-note">
          <div>
            <strong>Règle des 5 %.</strong> Le raccordement à la GTB n'est pas exigé lorsque les consommations d'énergie effectives et induites (par exemple, les pertes thermiques par extraction pour la ventilation) de l'ensemble des équipements régulés par la même fonction représentent moins de 5 % de la consommation d'énergie totale du bâtiment. Cette part s'apprécie sur tous les équipements concernés du bâtiment, et non système par système (FAQ ministérielle n° 16, non opposable).
          </div>
        </div>
        {{/if}}
        {{!-- Item 4d — Assujetti calculé pour ce système --}}
        {{#if liability}}{{#if ../../hasLiabilityData}}{{#unless liabilityIsDefault}}
        <div class="system-liability">
          <span class="system-liability-icon">{{{faIcon "scale-balanced" "#1b2842" "10"}}}</span>
          <div class="system-liability-body">
            <strong>{{liability.label}}.</strong>
            {{#if liability.explanation}}<span class="muted"> {{liability.explanation}}</span>{{/if}}
          </div>
        </div>
        {{/unless}}{{/if}}{{/if}}
        {{#if device_count}}
          {{!--
            Refonte v2.x : passage du tableau dense (qui wrap mal en
            colonnes étroites) à une série de cards par équipement.
            Header : nom + brand/ref + badge partagé · R175-3 pills à droite.
            Body : grille d'attributs horizontaux (Énergie, Puissance,
            Nature, Communication, Localisation) — lisible quel que soit
            le nombre d'équipements (cohérence demandée).
          --}}
          <div class="device-cards">
            {{#each devices}}
              <div class="device-card" {{#if out_of_service}}style="opacity:0.55"{{/if}}>
                <div class="device-card-head">
                  <div class="device-card-title">
                    <strong>{{name}}</strong>
                    {{#if brand}}<span class="device-card-ref"> · {{brand}}{{#if model_reference}} {{model_reference}}{{/if}}</span>{{/if}}
                    {{#if out_of_service}}<span class="device-card-hs">HS</span>{{/if}}
                    {{#if is_backup}}<span class="device-card-backup" title="Équipement de secours — puissance exclue du cumul BACS">Secours</span>{{/if}}
                    {{#if bms_integration_out_of_service}}<span class="device-card-bms-hs" title="La liaison entre cet équipement et la GTB est hors service.">Liaison GTB hors service</span>{{/if}}
                    {{#if sharedWithLabel}}
                      <span class="shared-badge shared-badge-wrap" title="Équipement partagé avec d'autres systèmes">{{{faIcon "arrow-right-arrow-left" "currentColor" "7"}}} Dessert aussi : {{sharedWithLabel}}</span>
                    {{/if}}
                  </div>
                  {{#if ../is_bacs}}
                  <div class="device-card-r175">
                    {{!-- Système exempté (règle des 5 %) : la communication
                         n'est pas exigée, pastille neutre (pas de rouge). --}}
                    <span class="r175-3-pill {{#if ../marked_negligible_under_5pct}}r175-3-na{{else}}{{triCls commTri 'r175-3-ok' 'r175-3-ko' 'r175-3-na'}}{{/if}}">
                      {{triSym commTri}} Communicant
                    </span>
                    {{!-- Pas de pastille « Interopérable » au niveau équipement :
                         l'interopérabilité (R175-3 3°) est une propriété SYSTÈME
                         (verdict systemInteropStatus, affiché sur la fiche système),
                         le champ n'existe pas par équipement (mig 42). L'afficher
                         donnait un « — » systématique contredisant le verdict. --}}
                    {{#if p4NotApplicable}}
                    <span class="r175-3-pill r175-3-na" title="Équipement relié à aucune GTB : l'arrêt manuel depuis la GTB et la gestion autonome sont sans objet.">Arrêt manuel et autonomie : sans objet (non relié à la GTB)</span>
                    {{else}}
                    <span class="r175-3-pill {{triCls meets_r175_3_p4 'r175-3-ok' 'r175-3-ko' 'r175-3-na'}}">
                      {{triSym meets_r175_3_p4}} Arrêt manuel
                    </span>
                    <span class="r175-3-pill {{triCls meets_r175_3_p4_autonomous 'r175-3-ok' 'r175-3-ko' 'r175-3-na'}}">
                      {{triSym meets_r175_3_p4_autonomous}} Autonome
                    </span>
                    {{/if}}
                  </div>
                  {{/if}}
                </div>
                <div class="device-card-attrs">
                  <div class="device-attr">
                    <span class="device-attr-label">Énergie</span>
                    <span class="device-attr-value">{{energyLabel}}</span>
                  </div>
                  <div class="device-attr">
                    <span class="device-attr-label">Puissance</span>
                    <span class="device-attr-value">
                      {{!-- Chaud et froid : une ligne chacun, libellée (même format
                           que le tableau du calcul de puissance). --}}
                      {{#if power_kw}}{{#if power_kw_cooling}}<span class="muted">chaud</span> {{/if}}<span class="nowrap">{{#if has_multiple}}{{frNum total_power_kw}}{{else}}{{frNum power_kw}}{{/if}} kW</span>{{#if has_multiple}} <span class="muted nowrap">({{quantity}} × {{frNum power_kw}} kW)</span>{{/if}}{{/if}}{{#if power_kw_cooling}}{{#if power_kw}}<br>{{/if}}<span class="muted">froid</span> <span class="nowrap">{{#if has_multiple}}{{frNum total_power_kw_cooling}}{{else}}{{frNum power_kw_cooling}}{{/if}} kW</span>{{#if has_multiple}} <span class="muted nowrap">({{quantity}} × {{frNum power_kw_cooling}} kW)</span>{{/if}}{{/if}}{{#unless power_kw}}{{#unless power_kw_cooling}}Non renseignée{{#if has_multiple}} <span class="muted">({{quantity}} unités)</span>{{/if}}{{/unless}}{{/unless}}
                      {{#if powerCalc}}{{#if powerCalc.inScope}}{{#if power_kw}}<span class="device-power-calc">{{powerCalc.typeLabel}}</span>{{else if power_kw_cooling}}<span class="device-power-calc">{{powerCalc.typeLabel}}</span>{{else}}<span class="device-power-calc device-power-calc-out">non comptée tant que la puissance n'est pas relevée</span>{{/if}}{{else}}<span class="device-power-calc device-power-calc-out">hors cumul{{#if powerCalc.reasonLabel}} · {{powerCalc.reasonLabel}}{{/if}}</span>{{/if}}{{/if}}
                    </span>
                  </div>
                  <div class="device-attr">
                    <span class="device-attr-label">Fonction(s)</span>
                    <span class="device-attr-value device-attr-roles">
                      {{#if device_role.length}}{{#each device_role}}{{{rolePill this "sm"}}}{{/each}}{{else}}<span class="bool-na">—</span>{{/if}}
                    </span>
                  </div>
                  <div class="device-attr">
                    <span class="device-attr-label">Communication</span>
                    <span class="device-attr-value">{{commLabel}}{{#if is_communicating}}{{#if (eq wired 1)}}&nbsp;<span class="muted">·&nbsp;filaire</span>{{else if (eq wired 0)}}&nbsp;<span class="muted">·&nbsp;sans fil</span>{{/if}}{{/if}}</span>
                  </div>
                  <div class="device-attr">
                    <span class="device-attr-label">Localisation</span>
                    <span class="device-attr-value">{{#if location}}{{location}}{{else}}—{{/if}}</span>
                  </div>
                  {{#if (or has_regulation regulation_integrated regulator_brand regulator_model_reference regulator_location_production regulator_location_distribution regulator_location_emission)}}
                  <div class="device-attr">
                    <span class="device-attr-label">Régulation</span>
                    <span class="device-attr-value">
                      {{#if (eq regulation_integrated 1)}}Intégrée à l'équipement{{else if (eq regulation_integrated 0)}}Déportée{{else}}—{{/if}}
                    </span>
                  </div>
                  {{/if}}
                  {{!-- Champs facultatifs en fin de fiche : la 1re ligne (Énergie,
                       Puissance, Fonctions, Communication) reste alignée d'une
                       fiche à l'autre (relecture PDF 2026-09-24). --}}
                  {{#if age_years}}
                  <div class="device-attr">
                    <span class="device-attr-label">Âge</span>
                    <span class="device-attr-value">{{age_years}} an{{#unless (eq age_years 1)}}s{{/unless}}</span>
                  </div>
                  {{/if}}
                  {{#if (or (eq metering_separable 1) (eq metering_separable 0) (eq metering_separable 'yes') (eq metering_separable 'no'))}}
                  <div class="device-attr">
                    <span class="device-attr-label">Mesurage séparable</span>
                    <span class="device-attr-value">
                      {{#if (or (eq metering_separable 1) (eq metering_separable 'yes'))}}Oui{{else}}Non{{/if}}{{#if metering_separable_note}} <span class="muted">— {{metering_separable_note}}</span>{{/if}}
                    </span>
                  </div>
                  {{/if}}
                </div>
                {{!-- Bloc régulateur déporté : marque, référence et localisation
                     par niveau (production / distribution / émission). Visible
                     uniquement si la régulation est marquée déportée et qu'au
                     moins une info de régulateur est renseignée. --}}
                {{#if (and (eq regulation_integrated 0) (or regulator_brand regulator_model_reference regulator_location_production regulator_location_distribution regulator_location_emission))}}
                <div class="device-card-regulator">
                  <span class="device-card-regulator-label">Régulateur déporté</span>
                  {{#if regulator_brand}}<span class="device-card-regulator-item"><strong>{{regulator_brand}}</strong>{{#if regulator_model_reference}} · {{regulator_model_reference}}{{/if}}</span>{{else}}{{#if regulator_model_reference}}<span class="device-card-regulator-item">{{regulator_model_reference}}</span>{{/if}}{{/if}}
                  {{#if regulator_location_production}}<span class="device-card-regulator-item"><em>Production :</em> {{regulator_location_production}}</span>{{/if}}
                  {{#if regulator_location_distribution}}<span class="device-card-regulator-item"><em>Distribution :</em> {{regulator_location_distribution}}</span>{{/if}}
                  {{#if regulator_location_emission}}<span class="device-card-regulator-item"><em>Émission :</em> {{regulator_location_emission}}</span>{{/if}}
                </div>
                {{/if}}
                {{!-- Notes et photos du device, integrees dans la card pour eviter
                     le bloc separe avec titre dupliqué. --}}
                {{#if (or notes_html notes photos.length)}}
                <div class="device-card-notes">
                  {{#if notes_html}}<div class="rich-notes">{{{notes_html}}}</div>{{else if notes}}<div class="rich-notes">{{notes}}</div>{{/if}}
                  {{#if photos.length}}
                    <div class="photo-grid">
                      {{#each photos}}<img src="{{dataUrl}}" alt="" />{{/each}}
                    </div>
                  {{/if}}
                </div>
                {{/if}}
              </div>
            {{/each}}
            {{!-- Équipements partagés vers ce système (mig 143) : fiche
                 abrégée — la fiche complète, les photos et la puissance
                 restent dans le système d'origine (pas de double comptage). --}}
            {{#each shared_devices}}
              <div class="device-card device-card-shared" {{#if out_of_service}}style="opacity:0.55"{{/if}}>
                <div class="device-card-head">
                  <div class="device-card-title">
                    <strong>{{name}}</strong>
                    {{#if brand}}<span class="device-card-ref"> · {{brand}}{{#if model_reference}} {{model_reference}}{{/if}}</span>{{/if}}
                    {{#if out_of_service}}<span class="device-card-hs">HS</span>{{/if}}
                    <span class="shared-badge shared-badge-wrap" title="Équipement inventorié dans un autre système : sa fiche complète y figure.">{{{faIcon "arrow-right-arrow-left" "currentColor" "7"}}} Partagé depuis {{sharedFromLabel}}</span>
                  </div>
                  {{#if ../is_bacs}}
                  <div class="device-card-r175">
                    {{!-- Système exempté (règle des 5 %) : la communication
                         n'est pas exigée, pastille neutre (pas de rouge). --}}
                    <span class="r175-3-pill {{#if ../marked_negligible_under_5pct}}r175-3-na{{else}}{{triCls commTri 'r175-3-ok' 'r175-3-ko' 'r175-3-na'}}{{/if}}">
                      {{triSym commTri}} Communicant
                    </span>
                    {{#if p4NotApplicable}}
                    <span class="r175-3-pill r175-3-na" title="Équipement relié à aucune GTB : l'arrêt manuel depuis la GTB et la gestion autonome sont sans objet.">Arrêt manuel et autonomie : sans objet (non relié à la GTB)</span>
                    {{else}}
                    <span class="r175-3-pill {{triCls meets_r175_3_p4 'r175-3-ok' 'r175-3-ko' 'r175-3-na'}}">
                      {{triSym meets_r175_3_p4}} Arrêt manuel
                    </span>
                    <span class="r175-3-pill {{triCls meets_r175_3_p4_autonomous 'r175-3-ok' 'r175-3-ko' 'r175-3-na'}}">
                      {{triSym meets_r175_3_p4_autonomous}} Autonome
                    </span>
                    {{/if}}
                  </div>
                  {{/if}}
                </div>
                {{!-- Fiche abrégée sur une ligne : le détail figure dans le
                     système d'origine (plus de fiche redétaillée). --}}
                <div class="device-card-shared-note">
                  {{#if device_role.length}}{{#each device_role}}{{{rolePill this "sm"}}}{{/each}}{{/if}}
                  <span>{{commLabel}}</span>
                  <span class="muted">Puissance {{#if powerCalc.inScope}}comptée dans {{sharedFromLabel}}{{else}}: voir {{sharedFromLabel}}{{#if powerCalc.reasonLabel}} — hors cumul : {{powerCalc.reasonLabel}}{{/if}}{{/if}}</span>
                </div>
              </div>
            {{/each}}
          </div>
        {{else}}
          <p class="muted">Système présent sur site ; ses équipements n'ont pas été détaillés lors de l'audit.</p>
        {{/if}}
        {{!-- Notes/photos au niveau systeme (commentaires globaux sur la
             categorie, distincts des notes par equipement integrees dans
             chaque device-card). --}}
        {{#if (or notes_html notes photos.length)}}
        <div class="system-card-notes">
          {{#if notes_html}}<div class="rich-notes">{{{notes_html}}}</div>
          {{else}}{{#if notes}}<p class="muted">{{notes}}</p>{{/if}}{{/if}}
          {{#if photos.length}}
            <div class="photo-grid">
              {{#each photos}}<img src="{{dataUrl}}" alt="" />{{/each}}
            </div>
          {{/if}}
        </div>
        {{/if}}
      </div>
    </div>
  {{/if}}
{{/each}}
{{/unless}}
{{/each}}

{{!-- ═══════════ Chapitre 4 — Compteurs ═══════════ --}}
<h1 class="chapter" data-toc-anchor="meters">{{{faIcon "gauge" "#1b2842" "16"}}} <span class="chapter-text">4. Compteurs et mesurage{{#if isBacs}} (R175-3 1°){{/if}}</span></h1>

{{#if isBacs}}
<div class="callout callout-info">
  <span class="callout-icon">{{{faIcon "circle-info" "#1b2842" "14"}}}</span>
  <div class="callout-body">
    <strong>Ce que le décret exige.</strong> La GTB doit <strong>suivre, enregistrer et analyser en continu</strong>,
    <strong>par zone fonctionnelle</strong> et <strong>au pas horaire</strong>, les données de production et de
    consommation d'énergie des systèmes techniques qui doivent lui être reliés, et <strong>conserver ces données</strong>
    à l'échelle mensuelle <strong>pendant cinq ans</strong> (R175-3 1°). Le décret ne fixe pas de nombre minimal de
    compteurs : il faut autant de mesures que nécessaire pour obtenir ces données (FAQ BACS n° 26). Le plan de
    comptage ci-dessous est celui que Buildy préconise pour y parvenir ; un compteur <strong>« requis mais
    manquant »</strong> est un point de mesure prévu par ce plan mais absent du site ; il est traité dans le
    plan de mise en conformité (chapitre {{planChapterNumber}}).
  </div>
</div>
{{/if}}

{{!-- Matrice « Plan de comptage » (zones × énergies) retirée du rapport
     comme de l'écran (2026-09-24, demande Kévin) : elle répétait les
     tableaux par énergie ci-dessous et se lisait mal (pastilles d'état
     minuscules). --}}

{{#if meterEnergyGroups.length}}
{{!-- ─── Sections détaillées par énergie, compteurs groupés par zone
     (cohérent avec la vue desktop MeterEnergyGroup) ─────────────────── --}}
{{#if isBacs}}
<p class="meter-col-legend">
  <strong>Lecture des colonnes :</strong>
  <strong>Requis</strong> = compteur prévu par le plan de comptage que Buildy préconise pour répondre au R175-3 1° ·
  <strong>Présent</strong> = un compteur est physiquement installé ·
  <strong>Communicant</strong> = le compteur peut transmettre ses relevés ·
  <strong>Câblé GTB</strong> = raccordé physiquement à la supervision ·
  <strong>Intégré GTB</strong> = ses données sont réellement remontées et exploitées par la GTB ·
  <strong>—</strong> = sans objet (compteur absent ou dont la présence n'est pas vérifiée){{#if metersAnyOutOfService}} ·
  <strong>HS</strong> = hors service{{/if}}.
</p>
{{/if}}
{{#each meterEnergyGroups}}
<div class="energy-section">
  <div class="energy-section-head">
    <span class="energy-section-icon" style="background:{{energy.color}}1a;color:{{energy.color}}">{{{faIcon energy.icon energy.color "10"}}}</span>
    <span class="energy-section-title">{{energy.label}}</span>
    <span class="energy-section-stats">
      <span>{{stats.total}} point{{#unless (eq stats.total 1)}}s{{/unless}} de comptage</span>
      <span class="energy-sep">·</span>
      {{#if stats.present}}<span class="energy-stat-present">{{stats.present}} compteur{{#unless (eq stats.present 1)}}s{{/unless}} en service</span>{{else}}<span class="energy-stat-none">aucun compteur en service</span>{{/if}}
      {{#if stats.hs}}
        <span class="energy-sep">·</span>
        <span class="energy-stat-missing">{{stats.hs}} hors service</span>
      {{/if}}
      {{#if stats.missing}}
        <span class="energy-sep">·</span>
        <span class="energy-stat-missing">{{stats.missing}} requis manquant{{#unless (eq stats.missing 1)}}s{{/unless}}</span>
      {{/if}}
      {{#if stats.unanswered}}
        <span class="energy-sep">·</span>
        <span class="energy-stat-unanswered">{{stats.unanswered}} à qualifier</span>
      {{/if}}
      {{#if stats.covered}}
        <span class="energy-sep">·</span>
        <span>{{stats.covered}} couvert{{#unless (eq stats.covered 1)}}s{{/unless}} par une zone regroupée</span>
      {{/if}}
    </span>
  </div>
  {{!-- Même grille pour chaque énergie : les tableaux empilés s'alignent
       (relecture PDF 2026-09-24). --}}
  <table class="energy-section-table">
    <colgroup>
      {{#if @root.metersAnyOutOfService}}<col style="width:19%"><col style="width:9%"><col style="width:9%"><col style="width:17%"><col style="width:11%"><col style="width:11%"><col style="width:8%"><col style="width:8%"><col style="width:8%">{{else}}<col style="width:20%"><col style="width:10%"><col style="width:10%"><col style="width:20%"><col style="width:11%"><col style="width:11%"><col style="width:9%"><col style="width:9%">{{/if}}
    </colgroup>
    <thead>
      <tr>
        <th>Usage</th>
        <th class="bool-cell">Requis</th><th class="bool-cell">Présent</th>
        <th>Localisation</th>
        <th class="bool-cell">Communicant</th><th>Protocole(s)</th>
        <th class="bool-cell">Câblé GTB</th>
        <th class="bool-cell">Intégré GTB</th>
        {{#if @root.metersAnyOutOfService}}<th class="bool-cell">Hors service</th>{{/if}}
      </tr>
    </thead>
    <tbody>
      {{#each zones}}
        {{!-- Subheader de zone (regroupement visuel) --}}
        <tr class="energy-subheader{{#if is_general}} energy-subheader-general{{/if}}">
          <td colspan="{{#if @root.metersAnyOutOfService}}9{{else}}8{{/if}}">
            {{#if is_general}}{{{faIcon "building-circle-arrow-right" "#6b7280" "9"}}} {{/if}}{{zone_name}}
            <span class="energy-subheader-count">— {{items.length}} compteur{{#unless (eq items.length 1)}}s{{/unless}}</span>
          </td>
        </tr>
        {{#each items}}
          <tr class="meter-row{{#if out_of_service}} meter-row-hs{{/if}}{{#if complianceFailed}} meter-row-noncompliant{{/if}}">
            <td>{{#if isGeneral}}{{{meterUsagePill "other" "sm"}}}{{else}}{{{meterUsagePill usage "sm"}}}{{/if}}</td>
            <td class="bool-cell">{{#if notRequiredReason}}<span class="muted">Non requis</span>{{else if coveredByGroup}}<span class="muted">Commun</span>{{else}}{{{boolPill required "sm" "neutral"}}}{{/if}}</td>
            <td class="bool-cell">{{{boolPill present_actual "sm"}}}</td>
            <td>{{#if locationLabel}}{{locationLabel}}{{else}}<span class="bool-na">—</span>{{/if}}</td>
            {{!-- Communication et raccordement : sans objet tant que le compteur
                 n'est pas constaté présent (relecture clarté R2 M1, m6). --}}
            {{#if isPresent}}
            <td class="bool-cell">{{{boolPill communicating "sm"}}}</td>
            <td class="meter-protocols-cell">{{#if protocolsLabel}}<span class="muted">{{protocolsLabel}}</span>{{else}}<span class="bool-na">—</span>{{/if}}</td>
            <td class="bool-cell">{{{boolPill wired "sm"}}}</td>
            <td class="bool-cell">
              {{#if bms_integration_out_of_service}}<strong style="color:#b91c1c" title="Liaison avec la GTB hors service">HS</strong>{{else}}{{{boolPill managed_by_bms "sm"}}}{{/if}}
            </td>
            {{else}}
            {{!-- Une cellule explicite au lieu de quatre « — ». --}}
            <td colspan="4" class="meter-absent-cell">{{#if (eq presenceState "no")}}Sans objet : compteur absent{{else}}Présence à vérifier{{/if}}</td>
            {{/if}}
            {{#if @root.metersAnyOutOfService}}<td class="bool-cell">{{#if out_of_service}}<strong style="color:#b91c1c">HS</strong>{{else}}<span class="bool-na">—</span>{{/if}}</td>{{/if}}
          </tr>
          {{#if notRequiredReason}}
          <tr class="meter-row-recommendation">
            <td colspan="{{#if @root.metersAnyOutOfService}}9{{else}}8{{/if}}"><span class="meter-recommendation-label">Non requis :</span> {{notRequiredReason}}.</td>
          </tr>
          {{/if}}
          {{#if coveredByGroup}}
          <tr class="meter-row-recommendation">
            <td colspan="{{#if @root.metersAnyOutOfService}}9{{else}}8{{/if}}"><span class="meter-recommendation-label">Zone regroupée :</span> comptage commun à {{coveredByGroup}}{{#if coveredLeadZone}} (voir le compteur de {{coveredLeadZone}}){{/if}} ; aucun compteur propre n'est exigé.</td>
          </tr>
          {{/if}}
          {{#if mergedLeadGroup}}
          <tr class="meter-row-recommendation">
            <td colspan="{{#if @root.metersAnyOutOfService}}9{{else}}8{{/if}}"><span class="meter-recommendation-label">Zone regroupée :</span> compteur unique de la zone {{mergedLeadGroup}}.</td>
          </tr>
          {{/if}}
          {{#if recommendation}}
          <tr class="meter-row-recommendation">
            <td colspan="{{#if @root.metersAnyOutOfService}}9{{else}}8{{/if}}"><span class="meter-recommendation-label">Recommandation :</span> {{recommendation}}</td>
          </tr>
          {{/if}}
        {{/each}}
      {{/each}}
    </tbody>
  </table>
</div>
{{/each}}
{{/if}}

{{#if metersForPdf.length}}
{{#if (gt meters.length metersForPdf.length)}}
<p class="muted" style="font-size: 7pt; margin-top: 1mm">
  Note : {{minus meters.length metersForPdf.length}} compteur{{#unless (eq (minus meters.length metersForPdf.length) 1)}}s{{/unless}}
  ni requis ni présent{{#unless (eq (minus meters.length metersForPdf.length) 1)}}s{{/unless}} {{#if (eq (minus meters.length metersForPdf.length) 1)}}figure{{else}}figurent{{/if}} pour mémoire dans les tableaux ci-dessus, hors du plan de comptage.
</p>
{{/if}}
{{#if metersWithDetails.length}}
<h3 class="subheading">Notes terrain et photos</h3>
<p class="muted" style="margin: -1mm 0 2mm">Détails relevés par l'auditeur sur les compteurs du tableau ci-dessus.</p>
{{#each metersWithDetails}}
  <div class="detail-card">
    <div class="detail-card-head">
      {{{meterTypePill meter_type "sm"}}}
      {{{meterUsagePill usage "sm"}}}
      <span class="detail-card-title">{{zoneLabel}}</span>
    </div>
    <div class="detail-card-body">
      {{#if notes_html}}<div class="rich-notes">{{{notes_html}}}</div>{{/if}}
      {{#if photos.length}}
