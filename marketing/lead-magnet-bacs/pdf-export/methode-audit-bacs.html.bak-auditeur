<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<title>La méthode interne d'audit BACS de Buildy</title>
<template id="__bundler_thumbnail" data-bg-color="#1b2842">
  <svg viewBox="0 0 1200 800" xmlns="http://www.w3.org/2000/svg">
    <rect width="1200" height="800" fill="#1b2842"/>
    <g transform="translate(600 400)">
      <circle r="180" fill="none" stroke="#3fc6a0" stroke-width="10"/>
      <text x="0" y="20" text-anchor="middle" font-family="Poppins, sans-serif" font-weight="800" font-size="160" fill="#ffffff">B</text>
    </g>
    <text x="600" y="680" text-anchor="middle" font-family="Manrope, sans-serif" font-weight="600" font-size="36" fill="#ffffff" letter-spacing="6">BUILDY · MÉTHODE AUDIT BACS</text>
  </svg>
</template>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800;900&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<script src="https://kit.fontawesome.com/e064e536db.js" crossorigin="anonymous"></script>
<style>
  :root{
    --navy:#1b2842;
    --navy-dark:#0f1a2e;
    --gray-900:#111827;
    --gray-600:#4b5563;
    --gray-300:#d1d5db;
    --gray-100:#f3f4f6;
    --gray-50:#fafafa;
    --accent-warn:#b45309;
    --accent-tip:#047857;
    --white:#ffffff;
    --mint-50:#e6faf3;
    --mint-100:#c1f4df;
    --mint-500:#00cd92;
    --mint-600:#00a578;
    --mint-700:#007a59;
    --heat:#dc2626;
    --heat-bg:#fef2f2;
    --cool:#2563eb;
    --cool-bg:#eff6ff;
    --vent:#0891b2;
    --vent-bg:#ecfeff;
    --ecs:#d97706;
    --ecs-bg:#fffbeb;
    --light:#ca8a04;
    --light-bg:#fefce8;
    --pv:#16a34a;
    --pv-bg:#f0fdf4;
    --power:#7c3aed;
    --power-bg:#f5f3ff;
  }

  @page{
    size:A4;
    margin:0;
  }

  *{box-sizing:border-box;}
  html,body{
    margin:0;
    padding:0;
    background:var(--gray-300);
    font-family:'Manrope',sans-serif;
    color:var(--gray-900);
    -webkit-font-smoothing:antialiased;
    -moz-osx-font-smoothing:grayscale;
  }

  /* Screen preview: real A4 pages on a backdrop. Width/height/padding fixes
     guarantee that on-screen layout = printed PDF layout (174mm content width,
     247mm content height). overflow:hidden makes inter-page bleed impossible. */
  .page{
    position:relative;
    background:var(--white);
    width:210mm;
    height:297mm;
    margin:14mm auto;
    padding:25mm 18mm 25mm 18mm;
    box-shadow:0 8px 30px rgba(15,26,46,0.18);
    page-break-after:always;
    break-after:page;
    overflow:hidden;
    color:var(--gray-900);
  }
  .page.full-bleed{
    padding:0;
  }
  .page::before{
    content:"";
    position:absolute;
    inset:0;
    background-image:url('assets/logo-mark.png');
    background-repeat:no-repeat;
    background-position:center;
    background-size:130mm auto;
    opacity:0.035;
    pointer-events:none;
    z-index:0;
    -webkit-print-color-adjust:exact;
    print-color-adjust:exact;
  }
  .page > *{ position:relative; z-index:1; }
  .page:last-child{ page-break-after:auto; }

  @media print{
    html,body{background:var(--white);}
    .page, .cover, .pivot, .back{
      margin:0 !important;
      box-shadow:none !important;
      page-break-inside:avoid;
      break-inside:avoid;
    }
    .overflow-badge{ display:none !important; }
    *{ -webkit-print-color-adjust:exact !important; print-color-adjust:exact !important; }
  }
  /* Mode export Puppeteer (script build-pdf.mjs injecte cette classe) */
  body.puppeteer-export #export-btn,
  body.puppeteer-export .overflow-badge{ display:none !important; }
  body.puppeteer-export section.page,
  body.puppeteer-export section.cover,
  body.puppeteer-export section.pivot,
  body.puppeteer-export section.back{ outline:none !important; }

  /* Floating "Enregistrer en PDF" button (screen only) */
  #export-btn{
    position:fixed; top:16px; right:16px; z-index:9999;
    background:var(--mint-500); color:var(--navy-dark);
    border:0; border-radius:10px;
    padding:10px 16px; font:600 13px/1 'Manrope',sans-serif;
    box-shadow:0 6px 20px rgba(15,26,46,.25);
    cursor:pointer;
    transition:background .15s ease, color .15s ease;
  }
  #export-btn:hover{ background:var(--mint-600); color:var(--white); }
  @media print{ #export-btn{ display:none !important; } }

  /* === Type scale === */
  h1.chapter-title{
    font-family:'Poppins',sans-serif;
    font-size:36px;
    line-height:1.08;
    font-weight:700;
    color:var(--navy);
    margin:0 0 4px 0;
    letter-spacing:-0.025em;
  }
  h2{
    font-family:'Poppins',sans-serif;
    font-size:22px;
    line-height:1.25;
    font-weight:600;
    color:var(--navy);
    margin:28px 0 12px 0;
    letter-spacing:-0.015em;
  }
  h3{
    font-family:'Poppins',sans-serif;
    font-size:16px;
    line-height:1.4;
    font-weight:600;
    color:var(--navy);
    margin:22px 0 8px 0;
    letter-spacing:-0.005em;
  }
  p{
    font-size:11.5pt;
    line-height:1.55;
    font-weight:400;
    margin:0 0 12px 0;
    max-width:170mm;
  }
  ul, ol{
    font-size:11.5pt;
    line-height:1.55;
    margin:0 0 14px 0;
    padding-left:0;
    list-style:none;
    max-width:170mm;
  }
  ul li{
    position:relative;
    padding-left:18px;
    margin-bottom:8px;
  }
  ul li::before{
    content:"•";
    color:var(--navy);
    position:absolute;
    left:0;
    top:-1px;
    font-size:14pt;
    line-height:1;
  }
  ol{
    counter-reset:item;
    padding-left:0;
  }
  ol li{
    counter-increment:item;
    position:relative;
    padding-left:22px;
    margin-bottom:8px;
  }
  ol li::before{
    content:counter(item) ".";
    position:absolute;
    left:0;
    top:0;
    color:var(--navy);
    font-weight:600;
  }
  strong{ font-weight:600; color:var(--gray-900); }
  em{ font-style:italic; }
  a{ color:var(--navy); text-decoration:underline; text-underline-offset:3px; }

  /* === Foot === */
  .page-foot{
    position:absolute;
    left:18mm;
    right:18mm;
    bottom:14mm;
    display:flex;
    justify-content:space-between;
    align-items:center;
    font-family:'Manrope',sans-serif;
    font-size:9pt;
    font-weight:600;
    line-height:1.4;
    text-transform:uppercase;
    letter-spacing:0.18em;
    color:var(--gray-600);
    border-top:1px solid var(--gray-300);
    padding-top:4mm;
  }
  .page-foot .chap{ text-transform:lowercase; letter-spacing:0.04em; }
  .page-foot .num{ font-variant-numeric:tabular-nums; letter-spacing:0.02em; }

  /* === Encadrés === */
  .callout{
    border-left:4px solid var(--navy);
    background:var(--gray-100);
    padding:5mm 12mm;
    margin:10px 0;
    max-width:170mm;
    break-inside:avoid;
  }
  .callout p:last-child{ margin-bottom:0; }
  .callout p:first-child{ margin-top:0; }
  .callout.warn{
    border-left-color:var(--accent-warn);
  }
  .callout.tip{
    border-left-color:var(--accent-tip);
  }
  .callout.r175{
    border-left-color:var(--navy);
    background:var(--gray-50);
  }
  .callout .callout-label{
    font-size:9.5pt;
    line-height:1.2;
    font-weight:600;
    letter-spacing:0.12em;
    text-transform:uppercase;
    color:var(--accent-warn);
    margin-bottom:6px;
  }
  .callout.tip .callout-label{ color:var(--accent-tip); }
  .callout.r175 .callout-label{ color:var(--navy); }

  /* === Cover === */
  .cover{
    background:var(--navy);
    color:var(--white);
    width:210mm;
    min-height:297mm;
    height:297mm;
    margin:14mm auto;
    padding:30mm 28mm;
    box-shadow:0 8px 30px rgba(15,26,46,0.18);
    position:relative;
    display:flex;
    flex-direction:column;
    page-break-after:always;
    break-after:page;
    overflow:hidden;
  }
  .cover-eyebrow{
    font-size:10pt;
    font-weight:600;
    letter-spacing:0.22em;
    text-transform:uppercase;
    color:rgba(255,255,255,0.55);
    margin-bottom:auto;
  }
  .cover-eyebrow .meta{
    display:block;
    margin-top:8px;
    font-weight:400;
    letter-spacing:0.12em;
    color:rgba(255,255,255,0.42);
  }
  .cover-center{
    margin:auto 0;
  }
  .cover-title{
    font-family:'Poppins',sans-serif;
    font-size:60pt;
    font-weight:800;
    line-height:1.02;
    letter-spacing:-0.04em;
    color:var(--white);
    margin:0;
    max-width:165mm;
  }
  .cover-sub{
    margin-top:36px;
    font-size:18pt;
    line-height:1.4;
    font-weight:400;
    color:rgba(255,255,255,0.85);
    max-width:160mm;
    letter-spacing:-0.005em;
  }
  .cover-foot{
    margin-top:auto;
    display:flex;
    justify-content:space-between;
    align-items:flex-end;
    color:rgba(255,255,255,0.7);
  }
  .cover-foot .wordmark img{
    height:48px;
    width:auto;
    display:block;
    object-fit:contain;
    max-width:140px;
  }
  .cover-foot .logo-lockup{
    align-self:flex-end;
    flex:0 0 auto;
  }
  .cover-foot .wordmark .tag{
    display:block;
    font-size:8.5pt;
    font-weight:600;
    letter-spacing:0.32em;
    margin-top:10px;
    color:rgba(255,255,255,0.55);
  }
  .cover-foot .edition{
    font-size:9.5pt;
    letter-spacing:0.12em;
    text-align:right;
    color:rgba(255,255,255,0.55);
  }

  /* === Chapter opener === */
  .chap-eyebrow{
    font-size:10pt;
    font-weight:600;
    letter-spacing:0.22em;
    text-transform:uppercase;
    color:var(--gray-600);
    margin-bottom:18px;
  }
  .chap-rule{
    width:60mm;
    height:2px;
    background:var(--navy);
    margin:18px 0 28px 0;
  }
  .chap-intro{
    font-size:13.5pt;
    line-height:1.5;
    color:var(--gray-900);
    max-width:170mm;
    font-weight:400;
  }
  .section-label{
    font-size:10pt;
    font-weight:600;
    letter-spacing:0.18em;
    text-transform:uppercase;
    color:var(--gray-600);
    margin:0 0 6px 0;
  }

  /* === Tables === */
  table{
    width:100%;
    max-width:170mm;
    border-collapse:collapse;
    margin:18px 0;
    font-size:10.5pt;
    line-height:1.4;
    font-variant-numeric:tabular-nums;
  }
  thead th{
    background:var(--navy);
    color:var(--white);
    font-weight:600;
    text-align:left;
    padding:10px 12px;
    border:none;
    font-size:10pt;
    letter-spacing:0.01em;
  }
  tbody td{
    padding:10px 12px;
    border-bottom:1px solid var(--gray-300);
    vertical-align:top;
  }
  tbody tr:nth-child(even) td{
    background:var(--gray-50);
  }
  tbody tr:last-child td{ border-bottom:none; }
  td.sev{ font-weight:600; white-space:nowrap; }
  td.sev.bloq{ color:#991b1b; }

  /* === Pivot page === */
  .pivot{
    background:var(--navy);
    color:var(--white);
    width:210mm;
    height:297mm;
    margin:14mm auto;
    padding:30mm 28mm;
    box-shadow:0 8px 30px rgba(15,26,46,0.18);
    position:relative;
    display:flex;
    flex-direction:column;
    page-break-after:always;
    break-after:page;
    overflow:hidden;
  }
  .pivot-eyebrow{
    font-size:10pt;
    font-weight:600;
    letter-spacing:0.22em;
    text-transform:uppercase;
    color:rgba(255,255,255,0.55);
    margin-bottom:30mm;
  }
  .pivot h2{
    font-family:'Poppins',sans-serif;
    color:var(--white);
    font-size:32pt;
    line-height:1.1;
    letter-spacing:-0.025em;
    font-weight:700;
    margin:0 0 24px 0;
    max-width:170mm;
  }
  .pivot p{
    color:rgba(255,255,255,0.86);
    font-size:13pt;
    line-height:1.55;
    max-width:160mm;
    margin-bottom:16px;
  }
  .pivot .price-block{
    margin:28px 0 28px 0;
    padding-top:20px;
    border-top:1px solid rgba(255,255,255,0.18);
  }
  .pivot .price-label{
    font-size:10pt;
    font-weight:600;
    letter-spacing:0.22em;
    text-transform:uppercase;
    color:rgba(255,255,255,0.5);
    margin-bottom:14px;
  }
  .pivot .price{
    font-family:'Poppins',sans-serif;
    font-size:48pt;
    font-weight:800;
    line-height:1.05;
    letter-spacing:-0.035em;
    color:var(--white);
    margin:0;
  }
  .pivot .price-sub strong{ color:#ffffff; font-weight:600; }
  .pivot .price-sub{
    color:rgba(255,255,255,0.78);
    font-size:11pt;
    margin-top:8px;
    letter-spacing:0.02em;
  }
  .pivot .cta-block{
    margin-top:auto;
    padding-top:30px;
    border-top:1px solid rgba(255,255,255,0.18);
  }
  .pivot .cta-block a{
    color:var(--white);
    text-decoration:underline;
    text-underline-offset:4px;
    font-size:14pt;
    display:inline-block;
    margin-right:24px;
  }
  .pivot .cta-block .cta-label{
    display:block;
    font-size:9.5pt;
    letter-spacing:0.2em;
    text-transform:uppercase;
    color:rgba(255,255,255,0.5);
    margin-bottom:10px;
  }

  /* === Back cover === */
  .back{
    background:var(--navy);
    color:var(--white);
    width:210mm;
    height:297mm;
    margin:14mm auto;
    padding:30mm 28mm;
    box-shadow:0 8px 30px rgba(15,26,46,0.18);
    position:relative;
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    text-align:center;
    page-break-after:auto;
    overflow:hidden;
  }
  .back .wordmark-top{
    position:absolute;
    top:30mm;
    left:0;
    right:0;
    text-align:center;
  }
  .back .wordmark-top img{
    height:52px;
    width:auto;
    max-width:180px;
    display:inline-block;
    object-fit:contain;
  }
  .back .wordmark-top .tag{
    display:block;
    font-size:8.5pt;
    font-weight:600;
    letter-spacing:0.32em;
    margin-top:12px;
    color:rgba(255,255,255,0.55);
  }
  .back-center h3{
    font-family:'Poppins',sans-serif;
    color:var(--white);
    font-size:20pt;
    font-weight:600;
    margin:0 0 28px 0;
    letter-spacing:-0.02em;
  }
  .back-center .contact{
    font-size:13pt;
    margin:0 0 10px 0;
    color:rgba(255,255,255,0.92);
  }
  .back-center .contact a{ color:var(--white); }
  .back-center .signature{
    margin-top:40px;
    color:rgba(255,255,255,0.92);
  }
  .back-center .signature .rule{
    width:24mm;
    height:1px;
    background:rgba(255,255,255,0.35);
    margin:0 auto 24px auto;
  }
  .back-center .signature .name{
    font-size:14pt;
    font-weight:600;
    letter-spacing:0.04em;
  }
  .back-center .signature .role{
    font-size:11pt;
    color:rgba(255,255,255,0.65);
    margin-top:4px;
    font-style:italic;
  }
  .back-foot{
    position:absolute;
    left:28mm;
    right:28mm;
    bottom:18mm;
    font-size:8pt;
    line-height:1.45;
    color:var(--gray-300);
    opacity:0.6;
    text-align:center;
  }

  /* === Misc === */
  .lead{
    font-size:13pt;
    line-height:1.5;
    color:var(--gray-900);
    max-width:170mm;
    margin:0 0 18px 0;
  }
  .toc-list{
    max-width:170mm;
    margin:24px 0 0 0;
    padding:0;
    list-style:none;
  }
  .toc-list li{
    display:flex;
    align-items:baseline;
    gap:12px;
    padding:11px 0;
    border-bottom:1px solid var(--gray-300);
    font-size:11.5pt;
  }
  .toc-list li::before{ content:none; }
  .toc-list .num{
    font-variant-numeric:tabular-nums;
    color:var(--navy);
    font-weight:600;
    width:30px;
    flex:0 0 30px;
  }
  .toc-list .title{ flex:0 1 auto; color:var(--gray-900); white-space:nowrap; }
  .toc-list .dots{
    flex:1 1 auto;
    min-width:20px;
    border-bottom:1px dotted var(--gray-300);
    transform:translateY(-4px);
  }
  .toc-list a.title{ color:var(--gray-900); text-decoration:none; font-family:'Poppins',sans-serif; font-weight:500; transition:color 120ms; }
  .toc-list a.title:hover{ color:var(--mint-700); }
  .toc-list .pg{ color:var(--gray-600); font-variant-numeric:tabular-nums; font-size:10.5pt; }

  .section-divider{
    height:1px;
    background:var(--gray-300);
    margin:28px 0 24px 0;
    max-width:170mm;
  }
  .quote-pull{
    border-left:4px solid var(--mint-500);
    background:var(--mint-50);
    padding:5mm 12mm;
    margin:10px 0;
    max-width:170mm;
    font-style:italic;
    color:var(--navy-dark);
    break-inside:avoid;
  }
  .quote-pull p{ margin:0 0 8px 0; }
  .quote-pull p:last-child{ margin-bottom:0; }

  /* === Logo lockup === */
  .logo-lockup{
    display:flex;
    flex-direction:column;
    gap:10px;
  }
  .logo-lockup img{ display:block; }

  /* === Pills (colored badges) === */
  .pill{
    display:inline-flex;
    align-items:center;
    gap:6px;
    padding:4px 11px;
    border-radius:999px;
    font-family:'Manrope',sans-serif;
    font-size:9.5pt;
    font-weight:600;
    letter-spacing:0.01em;
    line-height:1.2;
    white-space:nowrap;
  }
  .pill i{ font-size:10pt; line-height:1; }
  .pill-mint{ background:var(--mint-50); color:var(--mint-700); }
  .pill-heat{ background:var(--heat-bg); color:var(--heat); }
  .pill-cool{ background:var(--cool-bg); color:var(--cool); }
  .pill-vent{ background:var(--vent-bg); color:var(--vent); }
  .pill-ecs{ background:var(--ecs-bg); color:var(--ecs); }
  .pill-light{ background:var(--light-bg); color:var(--light); }
  .pill-pv{ background:var(--pv-bg); color:var(--pv); }
  .pill-power{ background:var(--power-bg); color:var(--power); }
  .pill-navy{ background:var(--navy); color:var(--white); }
  .pill-warn{ background:var(--ecs-bg); color:var(--accent-warn); }
  .pill-alarm{ background:#fee2e2; color:#991b1b; }
  .pill-warn-soft{ background:#fef3c7; color:#92400e; }
  .pill-info{ background:var(--cool-bg); color:var(--cool); }
  .pill-row{
    display:flex;
    flex-wrap:wrap;
    gap:8px;
    margin:8px 0 18px 0;
    max-width:170mm;
  }

  /* === Icon chips (large) === */
  .icon-grid{
    display:grid;
    grid-template-columns:repeat(2, 1fr);
    gap:14px;
    margin:18px 0;
    max-width:170mm;
  }
  .icon-chip{
    display:flex;
    gap:12px;
    align-items:flex-start;
    padding:12px 14px;
    border:1px solid var(--gray-300);
    border-radius:10px;
    background:var(--white);
  }
  .icon-chip .ico{
    width:36px;
    height:36px;
    border-radius:8px;
    display:flex;
    align-items:center;
    justify-content:center;
    flex:0 0 36px;
    font-size:16pt;
  }
  .icon-chip .lbl{
    font-family:'Poppins',sans-serif;
    font-size:10.5pt;
    font-weight:600;
    color:var(--navy);
    line-height:1.3;
  }
  .icon-chip .sub{
    font-size:9.5pt;
    color:var(--gray-600);
    margin-top:2px;
    line-height:1.35;
  }
  .ico-heat{ background:var(--heat-bg); color:var(--heat); }
  .ico-cool{ background:var(--cool-bg); color:var(--cool); }
  .ico-vent{ background:var(--vent-bg); color:var(--vent); }
  .ico-ecs{ background:var(--ecs-bg); color:var(--ecs); }
  .ico-light{ background:var(--light-bg); color:var(--light); }
