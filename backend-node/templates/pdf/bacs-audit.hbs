<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8" />
<title>{{#if isBacs}}Audit BACS{{else}}Audit GTB{{/if}} — {{document.client_name}} — {{document.project_name}}</title>
<style>{{{styles}}}</style>
</head>
<body>

{{!-- ═══════════ Page de garde ═══════════ --}}
<section class="cover">
  <img class="cover-logo" src="{{logoDataUrl}}" alt="Buildy" />
  <p class="cover-doc-type">{{#if isBacs}}Audit BACS — Décret R175{{else}}Audit GTB (Classique) — Préparation devis Buildy{{/if}}</p>
  <h1 class="cover-title">{{document.project_name}}</h1>
  <p class="cover-client">{{document.client_name}}</p>
  {{#if site.name}}<p class="cover-project">Site : {{site.name}}</p>{{/if}}
  {{#if site.address}}<p class="cover-address">{{site.address}}</p>{{/if}}

  {{#if isBacs}}{{#if applicabilityLabel}}
  <div class="cover-deadline-block">
    <p class="cover-deadline-label">Applicabilité R175-2</p>
    <p class="cover-deadline-value">{{applicabilityLabel}}</p>
    {{#if document.bacs_total_power_kw}}
    <p class="cover-deadline-detail">
      Puissance nominale utile cumulée chauffage + climatisation : <strong>{{document.bacs_total_power_kw}} kW</strong>
    </p>
    {{/if}}
  </div>
  {{/if}}{{/if}}

  <div class="cover-meta">
    <div class="cover-meta-row">
      <span class="cover-meta-label">Date d'audit</span>
      <span class="cover-meta-value">{{exportDate}}</span>
    </div>
    <div class="cover-meta-row">
      <span class="cover-meta-label">Auteur</span>
      <span class="cover-meta-value">{{authorName}}</span>
    </div>
    <div class="cover-meta-row">
      <span class="cover-meta-label">Version</span>
      <span class="cover-meta-value"><span class="cover-version-tag">{{version}}</span></span>
    </div>
    <div class="cover-meta-row">
      <span class="cover-meta-label">Type de document</span>
      <span class="cover-meta-value">{{#if isBacs}}Audit de conformité au décret BACS{{else}}Audit GTB classique (préparation devis Buildy){{/if}}</span>
    </div>
  </div>
</section>

{{!-- ═══════════ Table des matieres (charte AF/Synthèse) ═══════════ --}}
<section class="toc">
  <h1>Sommaire</h1>
  <ul class="toc-list">
    {{#if synthesisHtml}}
    <li class="toc-row lvl-1" data-toc-link="synthesis">
      <a href="#synthesis" class="toc-link">
        <span class="toc-num">00</span>
        <span class="toc-title">Note de synthèse</span>
        <span class="toc-dots"></span>
        <span class="toc-page">···</span>
      </a>
    </li>
    {{/if}}
    {{#if isBacs}}
    <li class="toc-row lvl-1" data-toc-link="conformity">
      <a href="#conformity" class="toc-link">
        <span class="toc-num">00</span>
        <span class="toc-title">Synthèse de conformité</span>
        <span class="toc-dots"></span>
        <span class="toc-page">···</span>
      </a>
    </li>
    {{/if}}
    <li class="toc-row lvl-1" data-toc-link="identification">
      <a href="#identification" class="toc-link">
        <span class="toc-num">1</span>
        <span class="toc-title">Identification du site</span>
        <span class="toc-dots"></span>
        <span class="toc-page">···</span>
      </a>
    </li>
    <li class="toc-row lvl-1" data-toc-link="zones">
      <a href="#zones" class="toc-link">
        <span class="toc-num">2</span>
        <span class="toc-title">Zones fonctionnelles{{#if isBacs}} <span class="toc-ref">R175-1 6°</span>{{/if}}</span>
        <span class="toc-dots"></span>
        <span class="toc-page">···</span>
      </a>
    </li>
    <li class="toc-row lvl-1" data-toc-link="systems">
      <a href="#systems" class="toc-link">
        <span class="toc-num">3</span>
        <span class="toc-title">Systèmes techniques par zone{{#if isBacs}} <span class="toc-ref">R175-1 4°</span>{{/if}}</span>
        <span class="toc-dots"></span>
        <span class="toc-page">···</span>
      </a>
    </li>
    <li class="toc-row lvl-1" data-toc-link="meters">
      <a href="#meters" class="toc-link">
        <span class="toc-num">4</span>
        <span class="toc-title">Compteurs et mesurage{{#if isBacs}} <span class="toc-ref">R175-3 1°</span>{{/if}}</span>
        <span class="toc-dots"></span>
        <span class="toc-page">···</span>
      </a>
    </li>
    {{#if isBacs}}
    <li class="toc-row lvl-1" data-toc-link="thermal">
      <a href="#thermal" class="toc-link">
        <span class="toc-num">5</span>
        <span class="toc-title">Régulation thermique automatique <span class="toc-ref">R175-6</span></span>
        <span class="toc-dots"></span>
        <span class="toc-page">···</span>
      </a>
    </li>
    {{/if}}
    <li class="toc-row lvl-1" data-toc-link="bms">
      <a href="#bms" class="toc-link">
        <span class="toc-num">{{#if isBacs}}6{{else}}5{{/if}}</span>
        <span class="toc-title">{{#if isBacs}}Solution GTB / GTC <span class="toc-ref">R175-3, R175-4, R175-5</span>{{else}}Solution de supervision en place{{/if}}</span>
        <span class="toc-dots"></span>
        <span class="toc-page">···</span>
      </a>
    </li>
    {{#if isBacs}}
    <li class="toc-row lvl-1" data-toc-link="plan">
      <a href="#plan" class="toc-link">
        <span class="toc-num">7</span>
        <span class="toc-title">Plan de mise en conformité</span>
        <span class="toc-dots"></span>
        <span class="toc-page">···</span>
      </a>
    </li>
    {{/if}}
  </ul>
</section>

<div class="sections">

{{#if synthesisHtml}}
{{!-- ═══════════ Synthèse executive ═══════════ --}}
<h1 class="chapter" data-toc-anchor="synthesis">{{{faIcon "sparkles" "#7c3aed" "22"}}} Note de synthèse</h1>
<div class="synthesis-block">{{{synthesisHtml}}}</div>
{{/if}}

{{#if isBacs}}
{{!-- ═══════════ Synthèse de conformité (anciennement chapitre 7, remontée au début) ═══════════ --}}
<h1 class="chapter" data-toc-anchor="conformity">{{{faIcon "shield" "#10b981" "22"}}} Synthèse de conformité</h1>
{{#if bms.overall_compliance}}
<div class="conformity-banner conformity-{{bms.overall_compliance}}">
  <span class="conformity-icon">{{#if (eq bms.overall_compliance "compliant")}}✓{{else}}{{#if (eq bms.overall_compliance "partial")}}!{{else}}✗{{/if}}{{/if}}</span>
  <div class="conformity-body">
    <span class="conformity-label">État global de la conformité au décret BACS</span>
    <span class="conformity-value">{{complianceLabel}}</span>
  </div>
</div>
{{/if}}

<div class="panel">
  <div class="panel-head">
    <h3 class="panel-title">Actions correctives par sévérité</h3>
    <p class="panel-subtitle">Détail complet et préconisations Buildy : voir chapitre 7 « Plan de mise en conformité ».</p>
  </div>
  <div class="panel-body">
    <div class="severity-stats">
      <div class="sev-stat">
        <span class="sev sev-blocking">Bloquantes</span>
        <span class="sev-stat-count">{{actionStats.blocking}}</span>
      </div>
      <div class="sev-stat">
        <span class="sev sev-major">Majeures</span>
        <span class="sev-stat-count">{{actionStats.major}}</span>
      </div>
      <div class="sev-stat">
        <span class="sev sev-minor">Mineures</span>
        <span class="sev-stat-count">{{actionStats.minor}}</span>
      </div>
      {{#if sevDonutDataUrl}}
      <div class="sev-stat-chart">
        <img src="{{sevDonutDataUrl}}" alt="Répartition des actions par sévérité" />
      </div>
      {{/if}}
    </div>
  </div>
</div>
{{/if}}

{{!-- ═══════════ Chapitre 1 — Identification site ═══════════ --}}
<h1 class="chapter" data-toc-anchor="identification">{{{faIcon "building" "#4f46e5" "22"}}} 1. Identification du site</h1>

<div class="info-cards">
  <div class="info-card">
    <span class="info-card-label">Site</span>
    <span class="info-card-value">{{site.name}}</span>
  </div>
  <div class="info-card">
    <span class="info-card-label">Client</span>
    <span class="info-card-value">{{document.client_name}}</span>
  </div>
  <div class="info-card info-card-wide">
    <span class="info-card-label">Adresse</span>
    <span class="info-card-value">{{site.address}}</span>
  </div>
  {{#if isBacs}}
    {{#if document.bacs_total_power_kw}}
    <div class="info-card info-card-accent">
      <span class="info-card-label">Puissance chauffage + clim</span>
      <span class="info-card-value info-card-value-strong">{{document.bacs_total_power_kw}} kW</span>
    </div>
    {{/if}}
    {{#if document.bacs_district_heating_substation_kw}}
    <div class="info-card info-card-accent">
      <span class="info-card-label">Station d'échange (réseau urbain)</span>
      <span class="info-card-value info-card-value-strong">{{document.bacs_district_heating_substation_kw}} kW</span>
      <span class="info-card-note">Référence R175-2</span>
    </div>
    {{/if}}
    {{#if document.bacs_building_permit_date}}
    <div class="info-card">
      <span class="info-card-label">Permis de construire</span>
      <span class="info-card-value">{{document.bacs_building_permit_date}}</span>
    </div>
    {{/if}}
    {{#if applicabilityLabel}}
    <div class="info-card info-card-wide info-card-accent">
      <span class="info-card-label">Applicabilité BACS (R175-2)</span>
      <span class="info-card-value info-card-value-strong">{{applicabilityLabel}}</span>
    </div>
    {{/if}}
    <div class="info-card info-card-wide">
      <span class="info-card-label">Analyse fonctionnelle de la GTB existante</span>
      {{#if (eq document.audit_existing_af_status "absent")}}
        <span class="info-card-value info-card-value-warn">Aucun document d'AF disponible</span>
      {{else}}
        <span class="info-card-value">Document fourni par le propriétaire ou son exploitant</span>
      {{/if}}
    </div>
  {{/if}}
</div>

{{#if isBacs}}{{#if heatingCoolingBreakdown.length}}
<div class="panel">
  <div class="panel-head">
    <h3 class="panel-title">Détail du calcul automatique de la puissance</h3>
    <p class="panel-subtitle">
      Somme des puissances nominales utiles des équipements saisis dans les catégories
      <strong>chauffage</strong> et <strong>climatisation</strong> (chapitre 3).
    </p>
  </div>
  <div class="panel-body">
    <table>
      <thead>
        <tr><th>Équipement</th><th>Marque / référence</th><th>Catégorie</th><th>Zone</th><th>Puissance</th></tr>
      </thead>
      <tbody>
        {{#each heatingCoolingBreakdown}}
          <tr>
            <td>{{name}}</td>
            <td>{{brand}}{{#if model_reference}} / {{model_reference}}{{/if}}</td>
            <td>{{categoryLabel}}</td>
            <td>{{zone_name}}</td>
            <td><strong>{{power_kw}} kW</strong></td>
          </tr>
        {{/each}}
        <tr class="total-row">
          <td colspan="4" style="text-align:right"><strong>Total chauffage + climatisation</strong></td>
          <td><strong>{{heatingCoolingTotal}} kW</strong></td>
        </tr>
      </tbody>
    </table>
  </div>
</div>
{{/if}}{{/if}}

{{#if barUsagePowerDataUrl}}
<div class="panel">
  <div class="panel-head">
    <h3 class="panel-title">Répartition de la puissance par usage</h3>
  </div>
  <div class="panel-body panel-body-center">
    <img src="{{barUsagePowerDataUrl}}" alt="Puissance par usage GTB" style="max-width: 140mm;" />
  </div>
</div>
{{/if}}

{{!-- ═══════════ Chapitre 2 — Zones fonctionnelles ═══════════ --}}
<h1 class="chapter" data-toc-anchor="zones">{{{faIcon "map-pin" "#4f46e5" "22"}}} 2. Zones fonctionnelles{{#if isBacs}} (R175-1 6°){{/if}}</h1>
{{#if zones.length}}
<table>
  <thead><tr><th>Zone</th><th>Nature</th><th>Surface (m²)</th></tr></thead>
  <tbody>
    {{#each zones}}
      <tr><td>{{name}}</td><td>{{nature}}</td><td>{{surface_m2}}</td></tr>
    {{/each}}
  </tbody>
</table>
{{#each zones}}
  {{#if (or notes_html notes photos.length)}}
    <div class="entity-block">
      <h3>{{name}}</h3>
      {{#if notes_html}}<div class="rich-notes">{{{notes_html}}}</div>
      {{else}}{{#if notes}}<p>{{notes}}</p>{{/if}}{{/if}}
      {{#if photos.length}}
        <div class="photo-grid">
          {{#each photos}}<img src="{{dataUrl}}" alt="" />{{/each}}
        </div>
      {{/if}}
    </div>
  {{/if}}
{{/each}}
{{else}}
<p class="muted">Aucune zone définie.</p>
{{/if}}

{{!-- ═══════════ Chapitre 3 — Systèmes techniques ═══════════ --}}
<h1 class="chapter" data-toc-anchor="systems">{{{faIcon "wrench" "#4f46e5" "22"}}} 3. Systèmes techniques par zone{{#if isBacs}} (R175-1 4°){{/if}}</h1>
{{#each systemsByZone}}
<h2 class="zone-heading">{{zone_name}}</h2>
{{#each items}}
  {{#if present}}
    <div class="system-card system-card-{{system_category}}">
      <div class="system-card-head">
        {{{categoryIcon system_category "16"}}}
        <span class="system-card-label">{{categoryLabel}}</span>
        {{#if total_power_kw}}
          <span class="system-card-power">{{total_power_kw}} kW</span>
        {{/if}}
        <span class="system-card-count">{{device_count}} équipement{{#if device_count}}{{#unless (eq device_count 1)}}s{{/unless}}{{/if}}</span>
      </div>
      <div class="system-card-body">
        {{#if devices.length}}
          <table class="device-table">
            <thead>
              <tr>
                <th style="width:24%">Équipement</th>
                <th style="width:20%">Marque / réf.</th>
                <th style="width:9%">Énergie</th>
                <th style="width:8%">Puiss.</th>
                <th style="width:11%">Nature</th>
                <th style="width:14%">Communication</th>
                <th style="width:14%">Localisation</th>
              </tr>
            </thead>
            <tbody>
              {{#each devices}}
                <tr {{#if out_of_service}}style="opacity:0.5"{{/if}}>
                  <td>
                    <strong>{{name}}</strong>
                    {{#if out_of_service}}<span style="color:#b91c1c;font-weight:600"> · HS</span>{{/if}}
                  </td>
                  <td>{{brand}}{{#if model_reference}} <span class="muted">/ {{model_reference}}</span>{{/if}}</td>
                  <td>{{energyLabel}}</td>
                  <td>{{power_kw}}{{#if power_kw}} kW{{/if}}</td>
                  <td>{{roleLabel}}</td>
                  <td>{{commLabel}}</td>
                  <td>{{location}}</td>
                </tr>
                <tr class="r175-3-row" {{#if out_of_service}}style="opacity:0.5"{{/if}}>
                  <td colspan="7" style="padding-top:0.5mm;padding-bottom:2mm;font-size:7.5pt;border-bottom:1px solid #f3f4f6">
                    <span class="r175-3-label">R175-3 :</span>
                    <span class="r175-3-pill {{#if meets_r175_3_p3}}r175-3-ok{{else}}r175-3-ko{{/if}}">
                      {{#if meets_r175_3_p3}}✓{{else}}✗{{/if}} Interopérable
                    </span>
                    <span class="r175-3-pill {{#if meets_r175_3_p4}}r175-3-ok{{else}}r175-3-ko{{/if}}">
                      {{#if meets_r175_3_p4}}✓{{else}}✗{{/if}} Arrêt manuel
                    </span>
                    <span class="r175-3-pill {{#if meets_r175_3_p4_autonomous}}r175-3-ok{{else}}r175-3-ko{{/if}}">
                      {{#if meets_r175_3_p4_autonomous}}✓{{else}}✗{{/if}} Autonome
                    </span>
                  </td>
                </tr>
              {{/each}}
            </tbody>
          </table>
        {{else}}
          <p class="muted">Système marqué présent mais aucun équipement détaillé n'a été saisi.</p>
        {{/if}}
        {{#if (or notes_html notes photos.length)}}
        <div class="system-card-notes">
          {{#if notes_html}}<div class="rich-notes">{{{notes_html}}}</div>
          {{else}}{{#if notes}}<p class="muted">{{notes}}</p>{{/if}}{{/if}}
          {{#if photos.length}}
            <div class="photo-grid">
              {{#each photos}}<img src="{{dataUrl}}" alt="" />{{/each}}
            </div>
          {{/if}}
        </div>
        {{/if}}
        {{#each devices}}
          {{#if (or notes_html photos.length)}}
            <div class="device-notes">
              <strong class="muted">{{name}}{{#if brand}} — {{brand}}{{/if}}{{#if model_reference}} {{model_reference}}{{/if}}</strong>
              {{#if notes_html}}<div class="rich-notes">{{{notes_html}}}</div>{{/if}}
              {{#if photos.length}}
                <div class="photo-grid">
                  {{#each photos}}<img src="{{dataUrl}}" alt="" />{{/each}}
                </div>
              {{/if}}
            </div>
          {{/if}}
        {{/each}}
      </div>
    </div>
  {{else}}
    <div class="system-absent">
      {{{categoryIcon system_category "16"}}}
      <span class="system-absent-label">{{categoryLabel}}</span>
      <span class="system-absent-status">{{#if not_concerned}}{{negativeLabel}}{{else}}Non présent{{/if}}</span>
    </div>
  {{/if}}
{{/each}}
{{/each}}

{{!-- ═══════════ Chapitre 4 — Compteurs ═══════════ --}}
<h1 class="chapter" data-toc-anchor="meters">{{{faIcon "gauge" "#10b981" "22"}}} 4. Compteurs et mesurage{{#if isBacs}} (R175-3 1°){{/if}}</h1>
{{#if meters.length}}
<table>
  <thead>
    <tr>
      <th>Zone</th><th>Usage</th><th>Type</th>
      <th>Requis</th><th>Présent</th><th>Communicant</th><th>Intégré GTB</th><th>HS</th>
    </tr>
  </thead>
  <tbody>
    {{#each meters}}
      <tr>
        <td>{{zoneLabel}}</td>
        <td>{{usageLabel}}</td>
        <td>{{typeLabel}}</td>
        <td class="bool-cell"><span class="{{#if required}}bool-yes{{else}}bool-no{{/if}}">{{#if required}}✓{{else}}✗{{/if}}</span></td>
        <td class="bool-cell"><span class="{{#if present_actual}}bool-yes{{else}}bool-no{{/if}}">{{#if present_actual}}✓{{else}}✗{{/if}}</span></td>
        <td class="bool-cell"><span class="{{#if communicating}}bool-yes{{else}}bool-no{{/if}}">{{#if communicating}}✓{{else}}✗{{/if}}</span></td>
        <td class="bool-cell"><span class="{{#if managed_by_bms}}bool-yes{{else}}bool-no{{/if}}">{{#if managed_by_bms}}✓{{else}}✗{{/if}}</span></td>
        <td class="bool-cell">{{#if out_of_service}}<strong style="color:#b91c1c">HS</strong>{{else}}<span class="bool-na">—</span>{{/if}}</td>
      </tr>
    {{/each}}
  </tbody>
</table>
{{#if metersWithDetails.length}}
<h3 class="subheading">Notes terrain & photos</h3>
<p class="muted" style="margin: -1mm 0 2mm">Détails relevés par l'auditeur sur les compteurs du tableau ci-dessus.</p>
{{#each metersWithDetails}}
  <div class="detail-card">
    <div class="detail-card-head">
      {{{faIcon "gauge" "#10b981" "13"}}}
      <span class="detail-card-title">{{zoneLabel}} — {{usageLabel}}</span>
      <span class="detail-card-meta">{{typeLabel}}</span>
    </div>
    <div class="detail-card-body">
      {{#if notes_html}}<div class="rich-notes">{{{notes_html}}}</div>
      {{else}}{{#if notes}}<p>{{notes}}</p>{{/if}}{{/if}}
      {{#if photos.length}}
        <div class="photo-grid">
          {{#each photos}}<img src="{{dataUrl}}" alt="" />{{/each}}
        </div>
      {{/if}}
    </div>
  </div>
{{/each}}
{{/if}}
{{else}}
<p class="muted">Aucun compteur listé. Saisis les équipements (avec leur énergie) pour générer automatiquement les compteurs requis.</p>
{{/if}}

{{#if isBacs}}
{{!-- ═══════════ Chapitre 5 — Régulation thermique ═══════════ --}}
<h1 class="chapter" data-toc-anchor="thermal">{{{faIcon "fire" "#dc2626" "22"}}} 5. Régulation thermique automatique (R175-6)</h1>

{{#if r175_6_applicable.applies}}
<div class="callout callout-warn">
  <span class="callout-icon">⚠️</span>
  <div class="callout-body"><strong>R175-6 applicable</strong> — {{r175_6_applicable.reason}}.</div>
</div>
{{else}}
<div class="callout callout-reco">
  <span class="callout-icon">✅</span>
  <div class="callout-body"><strong>R175-6 non applicable</strong> — {{r175_6_applicable.reason}}.</div>
</div>
{{/if}}

{{#if thermal.length}}
<table>
  <thead><tr><th>Zone</th><th>Usage</th><th>Régulation auto</th><th>Type</th><th>Générateur</th><th>Âge</th><th>Exempté bois</th><th>Notes</th></tr></thead>
  <tbody>
    {{#each thermal}}
      <tr>
        <td>{{zone_name}}</td>
        <td>
          <span class="usage-inline">
            {{{categoryIcon category "14"}}}<span class="usage-inline-label">{{categoryLabel}}</span>
          </span>
        </td>
        <td class="bool-cell"><span class="{{#if has_automatic_regulation}}bool-yes{{else}}bool-no{{/if}}">{{#if has_automatic_regulation}}✓{{else}}✗{{/if}}</span></td>
        <td>{{regulationLabel}}</td>
        <td>{{generatorLabel}}</td>
        <td>{{#if generator_age_years}}{{generator_age_years}} ans{{/if}}</td>
        <td class="bool-cell">{{#if generator_exempt_wood}}<span class="bool-yes">✓</span> <span class="muted">R175-6 II</span>{{else}}<span class="bool-no">✗</span>{{/if}}</td>
        <td>{{notes}}</td>
      </tr>
    {{/each}}
  </tbody>
</table>
{{else}}
<p class="muted">Régulation thermique non documentée.</p>
{{/if}}
{{/if}}

{{!-- ═══════════ Chapitre 6 — GTB / Supervision ═══════════ --}}
<h1 class="chapter" data-toc-anchor="bms">{{{faIcon "plug" "#7c3aed" "22"}}} {{#if isBacs}}6. Solution GTB / GTC (R175-3, R175-4, R175-5){{else}}5. Solution de supervision en place{{/if}}</h1>
{{#if bms}}
{{#if bms.out_of_service}}
<div class="callout callout-warn">
  <span class="callout-icon">⚠️</span>
  <div class="callout-body"><strong>GTB Hors-Service.</strong> Les exigences R175-3, R175-4 et R175-5 ne sont pas évaluées car la GTB n'est pas opérationnelle au moment de l'audit.</div>
