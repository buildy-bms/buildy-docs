        <td style="padding:2mm 4mm; border-bottom:0.4pt solid #f3f4f6; font-size:9pt;">{{contact_name}}{{#if company}} — {{company}}{{/if}}</td>
        <td style="padding:2mm 4mm; border-bottom:0.4pt solid #f3f4f6; font-size:9pt; color:#4b5563;">{{#if email}}{{email}}{{/if}}{{#if phone}} · {{phone}}{{/if}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>
  {{/if}}

  <h2 style="margin-top: 6mm;">Intégrité du document remis</h2>
  {{#if document.delivered_pdf_sha256}}
  <table class="bordereau-table" style="width:100%; border-collapse:collapse;">
    <tbody>
      <tr><td style="padding:2mm 4mm; border-bottom:0.4pt solid #e5e7eb; width:42mm; color:#6b7280; font-size:9pt;">Empreinte SHA-256</td>
          <td style="padding:2mm 4mm; border-bottom:0.4pt solid #e5e7eb; font-family:'SFMono-Regular',Menlo,monospace; font-size:8pt; word-break:break-all;">{{document.delivered_pdf_sha256}}</td></tr>
      {{#if document.delivered_git_tag}}
      <tr><td style="padding:2mm 4mm; border-bottom:0.4pt solid #e5e7eb; color:#6b7280; font-size:9pt;">Référence d'archive</td>
          <td style="padding:2mm 4mm; border-bottom:0.4pt solid #e5e7eb; font-family:'SFMono-Regular',Menlo,monospace; font-size:9pt;">{{document.delivered_git_tag}}</td></tr>
      {{/if}}
      {{#if document.decree_version_label}}
      <tr><td style="padding:2mm 4mm; border-bottom:0.4pt solid #e5e7eb; color:#6b7280; font-size:9pt;">Version du décret référencée</td>
          <td style="padding:2mm 4mm; border-bottom:0.4pt solid #e5e7eb;">{{document.decree_version_label}}</td></tr>
      {{/if}}
    </tbody>
  </table>
  <p style="font-size:8.5pt; color:#6b7280; margin-top:2mm; line-height:1.5;">L'empreinte SHA-256 et la référence d'archive ci-dessus identifient cette version du PDF de manière unique. Tout document affichant les mêmes valeurs est strictement identique au présent rapport, octet pour octet.</p>
  {{else}}
  <p style="font-size:9pt; color:#6b7280;"><em>L'empreinte d'intégrité et la version du décret référencée seront affichées une fois l'audit livré (statut « Livré » dans Buildy Docs).</em></p>
  {{/if}}
</section>
{{/if}}

{{!-- ═══════════ Annexe D — Disclaimers ═══════════ --}}
<section class="annex">
  <h1>Annexe D — Mentions légales et disclaimers</h1>
  <div class="callout callout-warn">
    <span class="callout-icon">{{{faIcon "triangle-exclamation" "#ea580c" "14"}}}</span>
    <div class="callout-body">Lecture obligatoire avant utilisation du présent rapport en support de devis ou de procédure de mise en conformité.</div>
  </div>
  <ol class="disclaimer-list">
    {{#each disclaimers}}
    <li>{{this}}</li>
    {{/each}}
  </ol>
</section>
{{/if}}

